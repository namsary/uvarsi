      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Predhrej rúru na 200 °C. Nakrájaj {onion.amount} {onion.name} nadrobno, {garlic.amount} {garlic.name} najemno a {tomato.amount} {tomato.name} nahrubo. Nastrúhaj {cheese.amount} {cheese.name}.", "requires": ["onion:raw", "garlic:raw", "tomato:raw", "cheese:raw", "rura:free"], "produces": ["onion:cut", "garlic:cut", "tomato:cut", "cheese:grated", "rura:hot"]},
        {"text": "Sceď {beans.amount} {beans.name} a {corn.amount} {corn.name} cez sitko a prepláchni ich studenou vodou.", "requires": ["beans:raw", "corn:raw", "sitko:free"], "produces": ["beans:drained", "corn:drained", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na silnom ohni 1 minútu, kým sa začne lesknúť. Opekaj {beef.amount} {beef.name} 6 minút a vareškou ho rozbíjaj, kým stratí ružovú farbu a začne byť zlatisté. Pridaj cibuľu do panvice a opekaj ju 3 minúty, kým zmäkne. Pridaj cesnak do panvice a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["oil:raw", "beef:raw", "onion:cut", "garlic:cut", "velka_panvica:free", "vareska:free"], "produces": ["oil:used", "beef:browned", "onion:cooked", "garlic:cooked", "velka_panvica:occupied", "vareska:free"]},
        {"text": "Odstav panvicu z ohňa a vmiešaj {cumin.amount} {cumin.name}, {paprika.amount} {paprika.name} a {paste.amount} {paste.name}.", "requires": ["cumin:raw", "paprika:raw", "paste:raw", "beef:browned", "velka_panvica:occupied"], "produces": ["cumin:mixed", "paprika:mixed", "paste:mixed"]},
        {"text": "Pridaj paradajky, fazuľu a kukuricu do panvice a prilej {tomato.water} vody. Var mleté hovädzie mäso s paradajkami na miernom ohni 8 minút, kým paradajky zmäknú a omáčka zhustne. Dochuť ju čiernym korením a soľou až po ochutnaní, syr navrchu je slaný.", "requires": ["tomato:cut", "beans:drained", "corn:drained", "paste:mixed", "velka_panvica:occupied"], "produces": ["tomato:cooked", "beans:cooked", "corn:cooked", "paste:cooked", "beef:cooked", "cumin:cooked", "paprika:cooked"]},
        {"text": "Rozlož tortilly na dosku. Na každú {tortilla.amount} {tortilla.name} daj pás mäsovej plnky, ale v panvici nechaj asi štvrtinu omáčky. Tortillu pevne zroluj a polož ju švom nadol do zapekacej misy.", "requires": ["tortilla:raw", "beef:cooked", "zapekacia_misa:free"], "produces": ["tortilla:filled", "zapekacia_misa:occupied"]},
        {"text": "Rozlož na tortilly zvyšnú omáčku z panvice a nasyp na ne tvrdý syr.", "requires": ["tortilla:filled", "cheese:grated", "tomato:cooked", "velka_panvica:occupied"], "produces": ["tortilla:topped", "cheese:topped", "velka_panvica:free"]},
        {"text": "Peč tortilly v zapekacej mise v rúre pri 200 °C 15 minút, kým syr zozlatne a omáčka na okrajoch bublá.", "requires": ["tortilla:topped", "cheese:topped", "zapekacia_misa:occupied", "rura:hot"], "produces": ["tortilla:baked", "cheese:baked", "rura:free"]},
        {"text": "Nechaj tortilly 5 minút postáť. Rozdeľ ich na {portions} porcií a podávaj.", "requires": ["tortilla:baked", "cheese:baked", "beef:cooked", "beans:cooked", "tomato:cooked", "corn:cooked", "paste:cooked", "onion:cooked", "garlic:cooked", "cumin:cooked", "paprika:cooked", "oil:used", "zapekacia_misa:occupied"], "produces": ["tortilla:served", "cheese:served", "beef:served", "beans:served", "tomato:served", "corn:served", "paste:served", "onion:served", "garlic:served", "cumin:served", "paprika:served", "oil:served", "zapekacia_misa:free"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Zapekané tortilly nechaj vychladnúť, prikry misu a do 2 hodín ju odlož do chladničky. Zjedz ich do 2 dní a prehrej ich prikryté v rúre pri 180 °C, kým budú celé horúce."}
