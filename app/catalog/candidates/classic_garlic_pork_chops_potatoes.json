      "modes": ["standard", "high_protein"],
      "equipment": ["veľká panvica s pokrievkou", "hrniec", "nôž", "doska na krájanie", "palička na mäso"],
      "slots": [
        {"key": "pork", "role": "protein", "candidates": ["pork_loin"], "amount_per_adult": "180", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na plátky hrubé 1,5 cm", "water_ml_per_adult": "80"},
        {"key": "flour", "role": "starch", "candidates": ["wheat_flour"], "amount_per_adult": "8", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "10", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "butter", "role": "fat", "candidates": ["butter"], "amount_per_adult": "8", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "8", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "potato", "role": "starch", "candidates": ["potato"], "amount_per_adult": "280", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na rovnaké kúsky"},
        {"key": "parsley", "role": "seasoning", "candidates": ["parsley"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Ošúp {potato.amount} {potato.name} a nakrájaj ich {potato.cut}.", "requires": ["potato:raw"], "produces": ["potato:cut"]},
        {"text": "Vlož zemiaky do hrnca. Dolej studenú vodu tak, aby boli ponorené, a vodu osoľ. Var zemiaky v hrnci na miernom ohni 20 minút, kým zmäknú.", "requires": ["potato:cut"], "produces": ["potato:cooked"]},
        {"text": "Nakrájaj {pork.amount} {pork.name} {pork.cut}, {garlic.amount} {garlic.name} {garlic.cut} a {parsley.amount} {parsley.name} {parsley.cut}.", "requires": ["pork:raw", "garlic:raw", "parsley:raw"], "produces": ["pork:cut", "garlic:cut", "parsley:cut"]},
        {"text": "Prikry plátky bravčového karé bez kosti fóliou a paličkou ich zľahka naklep. Okraje na dvoch miestach nastrihni, aby sa kotlety pri opekaní nekrútili. Osoľ ich a okoreň.", "requires": ["pork:cut"], "produces": ["pork:pounded"]},
        {"text": "Prisyp {flour.amount} {flour.name} do misky. Kotlety v nej z oboch strán zľahka obaľ a prebytočnú múku otras.", "requires": ["pork:pounded", "flour:raw"], "produces": ["pork:floured", "flour:coating"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Opeč bravčové karé bez kosti v panvici na strednom ohni 3 minúty z každej strany, kým bude zlatisté. Pri väčšej dávke ho opekaj po častiach a kotlety vyber na tanier.", "requires": ["oil:raw", "pork:floured", "flour:coating"], "produces": ["oil:used", "pork:browned", "flour:browned"]},
        {"text": "Stíš oheň a pridaj {butter.amount} {butter.name} do panvice. Opekaj cesnak na masle v panvici na miernom ohni 30 sekúnd, kým bude svetlo zlatistý. Prilej {pork.water} vody. Vareškou uvoľni výpek z dna panvice.", "requires": ["butter:raw", "garlic:cut", "oil:used", "pork:browned"], "produces": ["butter:used", "garlic:cooked", "pork:deglazed"]},
        {"text": "Vráť kotlety do panvice, prikry ju pokrievkou a dus bravčové karé bez kosti v panvici na miernom ohni 6 minút, kým mäso zmäkne a šťava jemne zhustne a začne bublať.", "requires": ["pork:deglazed", "flour:browned", "garlic:cooked"], "produces": ["pork:cooked", "flour:cooked", "garlic:sauce"]},
        {"text": "Sceď zemiaky, vráť ich do hrnca a premiešaj ich s petržlenovou vňaťou.", "requires": ["potato:cooked", "parsley:cut"], "produces": ["potato:finished", "parsley:used"]},
        {"text": "Dochuť cesnakovú šťavu soľou a čiernym korením. Podávaj kotlety so zemiakmi, polej ich šťavou z panvice a rozdeľ jedlo na {portions} porcií.", "requires": ["pork:cooked", "flour:cooked", "oil:used", "butter:used", "garlic:sauce", "potato:finished", "parsley:used"], "produces": ["pork:served", "flour:served", "oil:served", "butter:served", "garlic:served", "potato:served", "parsley:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Kotlety so šťavou a zemiaky rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 2 dní a prehrievaj ich prikryté, aby mäso nevyschlo."}
    }
