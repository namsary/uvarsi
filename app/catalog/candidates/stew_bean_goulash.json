{
  "recipes": [
    {
      "id": "stew_bean_goulash",
      "version": 2,
      "active": true,
      "name_template": "Fazuľový guláš s klobásou",
      "family": "stew_bean_goulash",
      "method": "pot",
      "minutes": 50,
      "modes": ["standard"],
      "equipment": ["veľký hrniec", "sitko", "vareška", "nôž", "doska na krájanie"],
      "slots": [
        {"key": "beans", "role": "protein", "candidates": ["beans_canned"], "amount_per_adult": "200", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": null},
        {"key": "sausage", "role": "protein", "candidates": ["smoked_sausage"], "amount_per_adult": "80", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na kolieska"},
        {"key": "potato", "role": "starch", "candidates": ["potato"], "amount_per_adult": "150", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": null, "water_ml_per_adult": "200"},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "80", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "8", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "paste", "role": "vegetable", "candidates": ["tomato_paste"], "amount_per_adult": "15", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "paprika", "role": "seasoning", "candidates": ["paprika_powder"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "caraway", "role": "seasoning", "candidates": ["caraway"], "amount_per_adult": "0.5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "marjoram", "role": "seasoning", "candidates": ["marjoram"], "amount_per_adult": "0.5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "bread", "role": "starch", "candidates": ["bread"], "amount_per_adult": "60", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "na krajce"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Sceď {beans.amount} {beans.name} v sitku a prepláchni ju studenou vodou.", "requires": ["beans:raw"], "produces": ["beans:drained"]},
        {"text": "Nakrájaj {onion.amount} {onion.name} {onion.cut}, {garlic.amount} {garlic.name} najemno a {sausage.amount} {sausage.name} {sausage.cut}. Ošúp {potato.amount} {potato.name} a nakrájaj ich na kocky veľké asi 1,5 cm.", "requires": ["onion:raw", "garlic:raw", "sausage:raw", "potato:raw"], "produces": ["onion:cut", "garlic:cut", "sausage:cut", "potato:cut"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci na strednom ohni 1 minútu, kým sa začne lesknúť. Opekaj údenú klobásu 3 minúty, kým pustí tuk a okraje budú zlatisté. Pridaj cibuľu a opekaj ju 8 minút, kým bude zlatistá.", "requires": ["oil:raw", "sausage:cut", "onion:cut", "velky_hrniec:free"], "produces": ["oil:used", "sausage:browned", "onion:cooked", "velky_hrniec:occupied"]},
        {"text": "Pridaj cesnak a {paste.amount} {paste.name} do hrnca. Opekaj paradajkový pretlak s cibuľou na strednom ohni 1 minútu za stáleho miešania, kým sa začne lesknúť.", "requires": ["garlic:cut", "paste:raw"], "produces": ["garlic:cooked", "paste:cooked"]},
        {"text": "Odstav veľký hrniec z ohňa. Prisyp {paprika.amount} {paprika.name} a {caraway.amount} {caraway.name}. Hneď premiešaj, aby korenie nezhorklo.", "requires": ["paprika:raw", "caraway:raw"], "produces": ["paprika:bloomed", "caraway:bloomed"]},
        {"text": "Pridaj zemiaky do hrnca. Nalej {potato.water} vody do hrnca. Var zemiaky s klobásou vo veľkom hrnci na miernom ohni 15 minút, kým budú takmer mäkké.", "requires": ["potato:cut", "paprika:bloomed", "caraway:bloomed", "sausage:browned", "onion:cooked", "garlic:cooked", "paste:cooked", "oil:used"], "produces": ["potato:half", "paprika:cooked", "caraway:cooked", "sausage:stewed", "onion:stew", "garlic:stew", "paste:stew", "oil:stew"]},
        {"text": "Pridaj červenú fazuľu a {marjoram.amount} {marjoram.name} do hrnca. Var červenú fazuľu so zemiakmi vo veľkom hrnci na miernom ohni 10 minút, kým zemiaky celkom zmäknú. Časť fazule rozdrv vareškou o stenu hrnca, aby guláš zhustol.", "requires": ["beans:drained", "marjoram:raw", "potato:half"], "produces": ["beans:cooked", "marjoram:cooked", "potato:cooked"]},
        {"text": "Nakrájaj {bread.amount} {bread.name} {bread.cut}.", "requires": ["bread:raw"], "produces": ["bread:cut"]},
        {"text": "Dochuť guláš čiernym korením a soľou až po ochutnaní, lebo klobása je slaná. Rozdeľ ho na {portions} porcií a podávaj s chlebom.", "requires": ["beans:cooked", "sausage:stewed", "potato:cooked", "onion:stew", "garlic:stew", "oil:stew", "paste:stew", "paprika:cooked", "caraway:cooked", "marjoram:cooked", "bread:cut", "velky_hrniec:occupied"], "produces": ["beans:served", "sausage:served", "potato:served", "onion:served", "garlic:served", "oil:served", "paste:served", "paprika:served", "caraway:served", "marjoram:served", "bread:served", "velky_hrniec:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Guláš rozdeľ do plytkých nádob a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 3 dní; v chlade zhustne, preto pri ohrievaní prilej trochu vody a prehrej ho, kým začne bublať. Chlieb skladuj oddelene."}
    }
  ],
