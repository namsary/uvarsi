        {"text": "Premiešaj {oil.amount} {oil.name} v mise so štipkou soli a čiernym korením.", "requires": ["oil:raw", "misa:free"], "produces": ["oil:seasoned", "misa:occupied"]},
        {"text": "Pridaj {tuna.reference_name}, {beans.reference_name}, {cucumber.reference_name}, {tomato.reference_name} a {onion.reference_name} do misy. Všetko zľahka premiešaj, kým sa suroviny rovnomerne obalia olejom; zeleninu pritom nerozpuč.", "requires": ["tuna:drained", "beans:drained", "cucumber:cut", "tomato:cut", "onion:cut", "oil:seasoned", "misa:occupied"], "produces": ["tuna:mixed", "beans:mixed", "cucumber:mixed", "tomato:mixed", "onion:mixed", "oil:mixed"]},
        {"text": "Dochuť šalát podľa potreby soľou a čiernym korením a rozdeľ ho na {portions} porcií. Podávaj ho hneď alebo vychladený.", "requires": ["tuna:mixed", "beans:mixed", "cucumber:mixed", "tomato:mixed", "onion:mixed", "oil:mixed", "misa:occupied"], "produces": ["tuna:served", "beans:served", "cucumber:served", "tomato:served", "onion:served", "oil:served", "misa:free"]}
