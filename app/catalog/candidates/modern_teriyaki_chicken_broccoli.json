      "pantry_basics": ["water", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {rice.amount} {rice.name} studenou vodou. Nalej {rice.water} vody do hrnca, prikry ho a priveď na strednom ohni do varu. Potom var ryžu na miernom ohni 15 minút, kým zmäkne a vsiakne vodu.", "requires": ["rice:raw", "hrniec:free"], "produces": ["rice:cooked", "hrniec:free"]},
        {"text": "Nakrájaj {chicken.amount} {chicken.name} na menšie kúsky, {broccoli.amount} {broccoli.name} na malé ružičky a {garlic.amount} {garlic.name} najemno.", "requires": ["chicken:raw", "broccoli:raw", "garlic:raw"], "produces": ["chicken:cut", "broccoli:cut", "garlic:cut"]},
        {"text": "Premiešaj v miske {soy.amount} {soy.name}, {sugar.amount} {sugar.name}, {vinegar.amount} {vinegar.name}, cesnak a trochu čierneho korenia, kým sa cukor takmer rozpustí.", "requires": ["soy:raw", "sugar:raw", "vinegar:raw", "garlic:cut", "miska:free"], "produces": ["soy:sauce", "sugar:sauce", "vinegar:sauce", "garlic:sauce", "miska:occupied"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 2 minúty, kým sa začne lesknúť.", "requires": ["oil:raw", "panvica:free"], "produces": ["oil:heated", "panvica:occupied"]},
        {"text": "Opekaj vykostené kuracie stehenné mäso v panvici na strednom ohni 7 minút, kým bude zlatisté. Pri väčšej dávke ho opekaj po častiach.", "requires": ["chicken:cut", "oil:heated", "panvica:occupied"], "produces": ["chicken:browned", "oil:used"]},
        {"text": "Pridaj brokolicu a {broccoli.water} vody do panvice. Prikry ju a var brokolicu s kuracím mäsom na strednom ohni 5 minút, kým bude sýtozelená a mäkká na zahryznutie.", "requires": ["broccoli:cut", "chicken:browned", "panvica:occupied"], "produces": ["broccoli:cooked", "chicken:cooking"]},
        {"text": "Prilej sójovú omáčku do panvice. Var vykostené kuracie stehenné mäso s brokolicou v panvici bez pokrievky na strednom ohni 4 minúty, kým omáčka začne jemne bublať, obalí mäso a kuracie kúsky nebudú v strede ružové.", "requires": ["soy:sauce", "sugar:sauce", "vinegar:sauce", "garlic:sauce", "broccoli:cooked", "chicken:cooking", "miska:occupied", "panvica:occupied"], "produces": ["soy:cooked", "sugar:cooked", "vinegar:cooked", "garlic:cooked", "broccoli:glazed", "chicken:cooked", "miska:free", "panvica:free"]},
        {"text": "Podávaj teriyaki s ryžou a rozdeľ jedlo na {portions} porcií.", "requires": ["chicken:cooked", "rice:cooked", "broccoli:glazed", "soy:cooked", "sugar:cooked", "vinegar:cooked", "garlic:cooked", "oil:used"], "produces": ["chicken:served", "rice:served", "broccoli:served", "soy:served", "sugar:served", "vinegar:served", "garlic:served", "oil:served"]}
      ],
      "storage": {"refrigerated_days": 1, "instruction": "Teriyaki a ryžu rozdeľ do plytkých nádob a do jednej hodiny ich schlaď. V chladničke ich zjedz do 24 hodín; porcie na neskôr hneď zamraz. Ohrievaj iba raz, kým budú celé horúce."}
