        {"key": "tomato", "role": "vegetable", "candidates": ["tomato"], "amount_per_adult": "230", "unit": "g", "child_factor": "0.7", "required": true, "use": "main", "cut": "na polovice alebo menšie kúsky"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
