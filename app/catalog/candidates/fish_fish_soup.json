        {"key": "bread", "role": "starch", "candidates": ["bread"], "amount_per_adult": "60", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na krajce"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {onion.amount} {onion.name} {onion.cut} a {dill.amount} {dill.name} {dill.cut}. Ošúp {carrot.amount} {carrot.name}, {celeriac.amount} {celeriac.name} a {potato.amount} {potato.name}. Mrkvu nakrájaj {carrot.cut}, zeler {celeriac.cut} a zemiaky {potato.cut}.", "requires": ["onion:raw", "dill:raw", "carrot:raw", "celeriac:raw", "potato:raw"], "produces": ["onion:cut", "dill:cut", "carrot:cut", "celeriac:cut", "potato:cut"]},
        {"text": "Rozohrej {butter.amount} {butter.name} vo veľkom hrnci na strednom ohni 1 minútu, kým sa roztopí a začne bublať. Opekaj cibuľu 4 minúty, kým bude dosklovita. Pridaj mrkvu a zeler a opekaj ich 3 minúty, kým začnú voňať.", "requires": ["butter:raw", "onion:cut", "carrot:cut", "celeriac:cut"], "produces": ["butter:used", "onion:cooked", "carrot:sweated", "celeriac:sweated"]},
        {"text": "Prilej {potato.water} vody do hrnca. Pridaj zemiaky, {bay.amount} {bay.name}, {allspice.amount} {allspice.name} a štipku soli. Priveď zemiaky so zeleninou na silnom ohni do varu a var ich na miernom ohni 15 minút, kým zemiaky a mrkva zmäknú.", "requires": ["potato:cut", "bay:raw", "allspice:raw", "carrot:sweated", "celeriac:sweated", "onion:cooked"], "produces": ["potato:cooked", "bay:cooked", "allspice:cooked", "carrot:cooked", "celeriac:cooked"]},
        {"text": "Osuš {fish.amount} {fish.name} papierovou utierkou a nakrájaj ju {fish.cut}.", "requires": ["fish:raw"], "produces": ["fish:cut"]},
        {"text": "Rozšľahaj v miske {sour_cream.amount} {sour_cream.name}, {flour.amount} {flour.name} a dve naberačky horúcej polievky dohladka. Zmes vlievaj do hrnca za stáleho miešania. Var zemiaky so zeleninou v zahustenej polievke na miernom ohni 4 minúty, kým polievka zhustne a začne jemne bublať.", "requires": ["sour_cream:raw", "flour:raw", "potato:cooked"], "produces": ["sour_cream:cooked", "flour:cooked"]},
        {"text": "Vlož rybu do hrnca. Var rybu v polievke na miernom ohni 6 minút, kým kocky stuhnú a v strede budú biele. Nemiešaj prudko, aby sa ryba nerozpadla. Vyber bobkový list a nové korenie.", "requires": ["fish:cut", "sour_cream:cooked"], "produces": ["fish:cooked"]},
        {"text": "Odstav hrniec z ohňa a jemne vmiešaj kôpor. Dochuť polievku soľou a čiernym korením. Nakrájaj {lemon.amount} {lemon.name} {lemon.cut} a {bread.amount} {bread.name} {bread.cut}.", "requires": ["dill:cut", "lemon:raw", "bread:raw", "fish:cooked"], "produces": ["dill:used", "lemon:cut", "bread:cut"]},
        {"text": "Podávaj polievku horúcu s chlebom a mesiačikom citróna, ktorý si každý vytlačí do taniera. Polievku rozdeľ na {portions} porcií.", "requires": ["fish:cooked", "potato:cooked", "carrot:cooked", "celeriac:cooked", "onion:cooked", "butter:used", "bay:cooked", "allspice:cooked", "sour_cream:cooked", "flour:cooked", "dill:used", "lemon:cut", "bread:cut"], "produces": ["fish:served", "potato:served", "carrot:served", "celeriac:served", "onion:served", "butter:served", "bay:served", "allspice:served", "sour_cream:served", "flour:served", "dill:served", "lemon:served", "bread:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Vychladnutú polievku ulož do uzavretej nádoby a najneskôr do 2 hodín ju odlož do chladničky. Zjedz ju do 2 dní a prehrievaj ju len raz, pomaly a bez varu, aby sa ryba nerozpadla a smotana nezrazila. Chlieb skladuj oddelene."}
