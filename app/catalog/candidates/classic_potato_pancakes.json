            "skrabka:used"
          ]
        },
        {
          "text": "Rozdrv {garlic.amount} {garlic.name} lisom priamo k zemiakom. Pridaj {flour.amount} {flour.name}, {egg.amount} {egg.name}, {marjoram.amount} {marjoram.name}, {salt.amount} {salt.name} a {pepper.amount} {pepper.name}. Vymiešaj husté cesto.",
          "requires": [
