        {"key": "zucchini", "role": "vegetable", "candidates": ["zucchini"], "amount_per_adult": "80", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "na polkolieska"},
        {"key": "carrot", "role": "vegetable", "candidates": ["carrot"], "amount_per_adult": "50", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "na tenké kolieska"},
