        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "20", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "pickles", "role": "vegetable", "candidates": ["pickled_cucumber"], "amount_per_adult": "1", "unit": "piece", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na malé kocky"},
        {"key": "mayo", "role": "fat", "candidates": ["mayonnaise"], "amount_per_adult": "15", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "yogurt", "role": "dairy", "candidates": ["plain_yogurt"], "amount_per_adult": "35", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "mustard", "role": "seasoning", "candidates": ["mustard"], "amount_per_adult": "5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Ošúp {carrot.amount} {carrot.name} a {celeriac.amount} {celeriac.name}. Zeler prekroj na dve časti.", "requires": ["carrot:raw", "celeriac:raw"], "produces": ["carrot:peeled", "celeriac:peeled"]},
        {"text": "Vlož {potato.amount} {potato.name} {potato.cut} do veľkého hrnca. Pridaj mrkvu a zeler do hrnca. Dolej studenú vodu tak, aby bola zelenina ponorená, a vodu osoľ.", "requires": ["potato:raw", "carrot:peeled", "celeriac:peeled"], "produces": ["potato:pot", "carrot:pot", "celeriac:pot"]},
        {"text": "Var zemiaky so zeleninou vo veľkom hrnci na miernom ohni 25 minút, kým zemiaky zmäknú. Sceď zemiaky aj zeleninu a nechaj ich 20 minút vychladnúť.", "requires": ["potato:pot", "carrot:pot", "celeriac:pot"], "produces": ["potato:cooked", "carrot:cooked", "celeriac:cooked"]},
        {"text": "Nakrájaj {onion.amount} {onion.name} {onion.cut} a {pickles.amount} {pickles.name} {pickles.cut}.", "requires": ["onion:raw", "pickles:raw"], "produces": ["onion:cut", "pickles:cut"]},
        {"text": "Ošúp vychladnuté zemiaky a nakrájaj ich aj s mrkvou a zelerom na malé kocky.", "requires": ["potato:cooked", "carrot:cooked", "celeriac:cooked"], "produces": ["potato:diced", "carrot:diced", "celeriac:diced"]},
        {"text": "Premiešaj v miske {mayo.amount} {mayo.name}, {yogurt.amount} {yogurt.name}, {mustard.amount} {mustard.name}, trochu nálevu z uhoriek, soľ a čierne korenie. Vmiešaj zemiaky, mrkvu, zeler, cibuľu a sterilizované uhorky. Šalát prikry a nechaj ho v chladničke aspoň 30 minút odležať.", "requires": ["mayo:raw", "yogurt:raw", "mustard:raw", "potato:diced", "carrot:diced", "celeriac:diced", "onion:cut", "pickles:cut"], "produces": ["mayo:salad", "yogurt:salad", "mustard:salad", "potato:salad", "carrot:salad", "celeriac:salad", "onion:salad", "pickles:salad"]},
        {"text": "Osuš {fish.amount} {fish.name} papierovou utierkou a nakrájaj ju {fish.cut}. Porcie z oboch strán osoľ a okoreň.", "requires": ["fish:raw"], "produces": ["fish:seasoned"]},
        {"text": "Priprav si tri taniere. Do prvého vsyp {flour.amount} {flour.name}, v druhom rozšľahaj {egg.amount} {egg.name} so štipkou soli a do tretieho vsyp {crumbs.amount} {crumbs.name}. Každú porciu ryby obaľ najprv v múke, potom vo vajci a nakoniec v strúhanke, ktorú jemne pritlač.", "requires": ["flour:raw", "egg:raw", "crumbs:raw", "fish:seasoned"], "produces": ["flour:coating", "egg:coating", "crumbs:coating", "fish:breaded"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na strednom ohni 3 minúty, kým okolo kúska strúhanky hodeného do oleja začne hneď bublať. Olej má pokryť dno panvice aspoň do výšky pol centimetra, ak ho je menej, dolej ho z fľaše.", "requires": ["oil:raw"], "produces": ["oil:hot"]},
        {"text": "Opekaj rybu vo veľkej panvici po dávkach na strednom ohni 3 minúty z každej strany, kým bude obal zlatistý a chrumkavý a ryba sa v strede ľahko oddelí. Panvicu neprepĺňaj, porcie sa nesmú prekrývať. Hotovú rybu vyber na tanier s papierovou utierkou, aby odkvapkala.", "requires": ["fish:breaded", "flour:coating", "egg:coating", "crumbs:coating", "oil:hot"], "produces": ["fish:fried", "flour:fried", "egg:fried", "crumbs:fried", "oil:used"]},
        {"text": "Nakrájaj {lemon.amount} {lemon.name} {lemon.cut}.", "requires": ["lemon:raw"], "produces": ["lemon:cut"]},
        {"text": "Podávaj vyprážanú rybu so zemiakovým šalátom a mesiačikmi citróna. Jedlo rozdeľ na {portions} porcií.", "requires": ["fish:fried", "flour:fried", "egg:fried", "crumbs:fried", "oil:used", "lemon:cut", "potato:salad", "carrot:salad", "celeriac:salad", "onion:salad", "pickles:salad", "mayo:salad", "yogurt:salad", "mustard:salad"], "produces": ["fish:served", "flour:served", "egg:served", "crumbs:served", "oil:served", "lemon:served", "potato:served", "carrot:served", "celeriac:served", "onion:served", "pickles:served", "mayo:served", "yogurt:served", "mustard:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Rybu a zemiakový šalát ulož oddelene do uzavretých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 2 dní. Rybu prehrej v rúre pri 180 °C asi 8 minút, aby ostala chrumkavá, šalát podávaj studený."}
