      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {onion.amount} {onion.name} {onion.cut}, {carrot.amount} {carrot.name} {carrot.cut}, {garlic.amount} {garlic.name} {garlic.cut} a {tomato.amount} {tomato.name} {tomato.cut}. Nastrúhaj {cheese.amount} {cheese.name} najemno.", "requires": ["onion:raw", "carrot:raw", "garlic:raw", "tomato:raw", "cheese:raw"], "produces": ["onion:cut", "carrot:cut", "garlic:cut", "tomato:cut", "cheese:grated"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v hrnci na omáčku na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj cibuľu s mrkvou 5 minút, kým cibuľa zmäkne a bude dosklovita.", "requires": ["oil:raw", "onion:cut", "carrot:cut"], "produces": ["oil:used", "onion:cooked", "carrot:cooked"]},
        {"text": "Pridaj {turkey.amount} {turkey.name} do hrnca. Opekaj mleté morčacie mäso na strednom ohni 7 minút, vareškou ho rozdeľ na drobné kúsky, kým stratí ružovú farbu a bude miestami zlatisté. Pri väčšej dávke opekaj mäso po častiach. Pridaj cesnak a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["turkey:raw", "onion:cooked", "carrot:cooked", "garlic:cut"], "produces": ["turkey:browned", "garlic:cooked"]},
        {"text": "Vmiešaj {paste.amount} {paste.name} a {oregano.amount} {oregano.name}, pridaj paradajky a prilej {tomato.water} vody. Dus paradajky s mletým morčacím mäsom v hrnci na miernom ohni 20 minút, kým sa paradajky rozpadnú a omáčka bude hustá a jemne bublá.", "requires": ["paste:raw", "oregano:raw", "tomato:cut", "turkey:browned"], "produces": ["paste:cooked", "oregano:cooked", "tomato:cooked", "turkey:cooked"]},
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci na cestoviny s osolenou vodou na strednom ohni asi 9 minút, kým budú mäkké, ale stále pevné. Odober z hrnca {pasta.water} vody a potom cestoviny sceď cez sitko.", "requires": ["pasta:raw"], "produces": ["pasta:cooked"]},
        {"text": "Premiešaj cestoviny s omáčkou v hrnci na omáčku. Ak je omáčka hustá, prilievaj po troškách odloženú vodu z cestovín, kým bude šťavnatá a cestoviny sa ňou obalia. Dochuť jedlo soľou a čiernym korením až po ochutnaní.", "requires": ["pasta:cooked", "tomato:cooked", "turkey:cooked"], "produces": ["pasta:combined"]},
        {"text": "Rozdeľ cestoviny na {portions} porcií a podávaj ich so syrom nasypaným navrch.", "requires": ["pasta:combined", "turkey:cooked", "tomato:cooked", "paste:cooked", "oregano:cooked", "onion:cooked", "carrot:cooked", "garlic:cooked", "oil:used", "cheese:grated"], "produces": ["pasta:served", "turkey:served", "tomato:served", "paste:served", "oregano:served", "onion:served", "carrot:served", "garlic:served", "oil:served", "cheese:served"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Cestoviny s omáčkou rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní; syr sypaj až na tanier a pri ohrievaní prilej lyžicu vody, aby omáčka ostala šťavnatá."}
