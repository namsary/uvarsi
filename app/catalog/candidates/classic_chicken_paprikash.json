      "instructions": [
        {
          "text": "Nakrájaj {onion.amount} {onion.name} nadrobno.",
          "requires": ["onion:raw"],
          "produces": ["onion:cut"]
        },
        {
          "text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci na strednom ohni a opekaj na ňom cibuľu 6 minút, kým bude mäkká a dosklovita.",
          "requires": ["onion:cut", "oil:raw", "velky_hrniec:free"],
          "produces": ["onion:cooked", "oil:used", "velky_hrniec:occupied"]
        },
        {
          "text": "Osuš {chicken.amount} {chicken.name} a nechaj stehná celé.",
          "requires": ["chicken:raw"],
          "produces": ["chicken:prepared"]
        },
        {
          "text": "Pridaj {chicken.name} do hrnca. Opekaj kuracie stehná na strednom ohni 8 minút, kým bude koža miestami zlatistá.",
          "requires": ["chicken:prepared", "onion:cooked", "oil:used", "velky_hrniec:occupied"],
          "produces": ["chicken:browned", "oil:cooked"]
        },
        {
          "text": "Odstav veľký hrniec z ohňa. Prisyp {paprika.amount} {paprika.name}. Hneď premiešaj.",
          "requires": ["paprika:raw", "chicken:browned", "velky_hrniec:occupied"],
          "produces": ["paprika:combined"]
        },
        {
          "text": "Prilej vodu do hrnca. Tekutina má siahať do polovice stehien. Dus kuracie stehná vo veľkom hrnci na miernom ohni 35 minút, kým mäso pri kosti zmäkne a šťava jemne bublá.",
          "requires": ["chicken:browned", "paprika:combined", "velky_hrniec:occupied"],
          "produces": ["chicken:tender"]
        },
        {
          "text": "Uvar {pasta.amount} {pasta.name} v malom hrnci na miernom ohni 8 minút, kým cestoviny zmäknú, potom ich sceď.",
          "requires": ["pasta:raw", "maly_hrniec:free"],
          "produces": ["pasta:cooked", "maly_hrniec:free"]
        },
        {
          "text": "Rozšľahaj {cream.amount} {cream.name} v miske s trochou horúcej šťavy.",
          "requires": ["cream:raw", "miska:free"],
          "produces": ["cream:tempered", "miska:free"]
        },
        {
          "text": "Vlej {cream.name} do hrnca. Zohrievaj {cream.name} s mäsom vo veľkom hrnci na miernom ohni 3 minúty, kým omáčka zhustne a začne bublať.",
          "requires": ["cream:tempered", "chicken:tender", "velky_hrniec:occupied"],
          "produces": ["cream:cooked", "chicken:cooked", "velky_hrniec:free"]
        },
        {
          "text": "Dochuť paprikáš soľou a čiernym korením.",
          "requires": ["chicken:cooked", "cream:cooked", "onion:cooked", "paprika:combined"],
          "produces": []
        },
        {
          "text": "Podávaj kurací paprikáš s cestovinami a rozdeľ ho na {portions} porcií.",
          "requires": ["chicken:cooked", "onion:cooked", "oil:cooked", "paprika:combined", "cream:cooked", "pasta:cooked"],
          "produces": ["chicken:served", "onion:served", "oil:served", "paprika:served", "cream:served", "pasta:served"]
        }
      ],
      "storage": {
        "refrigerated_days": 2,
        "instruction": "Zvyšný paprikáš rozdeľ do plytkých nádob a odlož do chladničky najneskôr do 2 hodín. Zjedz ho do 2 dní."
