      "active": true,
      "name_template": "Francúzske zemiaky",
      "family": "classic_french_potatoes",
      "method": "oven",
      "minutes": 75,
      "modes": ["standard"],
      "equipment": ["rúra", "veľký hrniec", "malý hrniec", "pekáč", "nôž", "doska na krájanie"],
      "slots": [
        {"key": "potato", "role": "starch", "candidates": ["potato"], "amount_per_adult": "300", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na 5 mm plátky"},
        {"key": "egg", "role": "protein", "candidates": ["egg"], "amount_per_adult": "1", "unit": "piece", "child_factor": "0.6", "required": true, "use": "main", "cut": "na plátky"},
        {"key": "smoked_meat", "role": "protein", "candidates": ["smoked_sausage", "ham"], "amount_per_adult": "80", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "na tenké kúsky"},
        {"key": "cream", "role": "dairy", "candidates": ["cream"], "amount_per_adult": "60", "unit": "ml", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "5", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Predhrej rúru na 190 °C.", "requires": ["rura:free"], "produces": ["rura:heated"]},
        {"text": "Uvar {potato.amount} {potato.name} v šupke vo veľkom hrnci vo vode na strednom ohni 20 minút, kým zemiaky mierne zmäknú, ale zostanú pevné. Sceď zemiaky a nechaj ich vychladnúť.", "requires": ["potato:raw", "velky_hrniec:free"], "produces": ["potato:partly_cooked", "velky_hrniec:free"]},
        {"text": "Uvar {egg.amount} {egg.name} v malom hrnci vo vode na strednom ohni 10 minút, kým bielok aj žĺtok stuhnú. Potom vodu zlej, {egg.reference_name} schlaď v studenej vode a ošúp.", "requires": ["egg:raw", "maly_hrniec:free"], "produces": ["egg:cooked", "maly_hrniec:free"]},
        {"text": "Ošúp zemiaky. Nakrájaj zemiaky aj {egg.reference_name} na plátky a {smoked_meat.amount} {smoked_meat.name} {smoked_meat.cut}.", "requires": ["potato:partly_cooked", "egg:cooked", "smoked_meat:raw"], "produces": ["potato:sliced", "egg:sliced", "smoked_meat:cut"]},
        {"text": "Nalej {oil.amount} {oil.name} do pekáča.", "requires": ["oil:raw", "pekac:free"], "produces": ["oil:used", "pekac:greased"]},
        {"text": "Rozlož do pekáča polovicu zemiakov, {egg.reference_name}, {smoked_meat.name} a zvyšné zemiaky. Každú vrstvu dochuť soľou a čiernym korením. Pri väčšej dávke rozdeľ vrstvy rovnomerne do dvoch pekáčov, aby sa jedlo prepieklo aj v strede.", "requires": ["potato:sliced", "egg:sliced", "smoked_meat:cut", "oil:used", "pekac:greased"], "produces": ["potato:layered", "egg:layered", "smoked_meat:layered", "oil:layered", "pekac:occupied"]},
        {"text": "Prilej {cream.amount} {cream.name} do pekáča.", "requires": ["cream:raw", "potato:layered", "egg:layered", "smoked_meat:layered", "pekac:occupied"], "produces": ["cream:added"]},
        {"text": "Peč francúzske zemiaky v pekáči pri 190 °C 30 minút, kým povrch zozlatne a smotana začne bublať.", "requires": ["potato:layered", "egg:layered", "smoked_meat:layered", "oil:layered", "cream:added", "pekac:occupied", "rura:heated"], "produces": ["potato:cooked", "egg:baked", "smoked_meat:cooked", "oil:cooked", "cream:cooked", "rura:free"]},
        {"text": "Nechaj francúzske zemiaky v pekáči 10 minút odpočívať.", "requires": ["potato:cooked", "egg:baked", "smoked_meat:cooked", "oil:cooked", "cream:cooked", "pekac:occupied"], "produces": ["potato:rested", "egg:rested", "smoked_meat:rested", "oil:rested", "cream:rested", "pekac:free"]},
        {"text": "Podávaj francúzske zemiaky a rozdeľ ich na {portions} porcií.", "requires": ["potato:rested", "egg:rested", "smoked_meat:rested", "oil:rested", "cream:rested"], "produces": ["potato:served", "egg:served", "smoked_meat:served", "oil:served", "cream:served"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Francúzske zemiaky rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní."}
    }
  ],
