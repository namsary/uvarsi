      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {rice.amount} {rice.name} v sitku pod studenou vodou.", "requires": ["rice:raw"], "produces": ["rice:rinsed"]},
        {"text": "Nalej {rice.water} vody do hrnca a pridaj štipku soli. Vsyp ryžu do hrnca a prikry ho. Var ryžu na miernom ohni 15 minút, kým voda vsiakne a ryža zmäkne. Potom ju nechaj 5 minút prikrytú postáť.", "requires": ["rice:rinsed"], "produces": ["rice:cooked"]},
        {"text": "Nakrájaj {cucumber.amount} {cucumber.name} {cucumber.cut}, {chives.amount} {chives.name} {chives.cut} a {lemon.amount} {lemon.name} na polovice. Ošúp {carrot.amount} {carrot.name} a nastrúhaj ju {carrot.cut}.", "requires": ["cucumber:raw", "chives:raw", "carrot:raw", "lemon:raw"], "produces": ["cucumber:cut", "chives:cut", "carrot:grated", "lemon:cut"]},
        {"text": "Premiešaj v miske {soy.amount} {soy.name} so šťavou vytlačenou z citróna. Polovicou zálievky polej uhorku a mrkvu.", "requires": ["lemon:cut", "soy:raw", "cucumber:cut", "carrot:grated"], "produces": ["lemon:dressing", "soy:dressing", "cucumber:dressed", "carrot:dressed"]},
        {"text": "Osuš {salmon.amount} {salmon.name} papierovou utierkou a nakrájaj ho {salmon.cut}. Porcie z oboch strán zľahka osoľ a okoreň.", "requires": ["salmon:raw"], "produces": ["salmon:seasoned"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na strednom ohni 1 minútu, kým sa začne lesknúť. Opekaj lososa 4 minúty, kým bude spodná strana zlatistá. Obráť ho a opekaj ešte 3 minúty, kým v strede stuhne a ľahko sa rozdelí na lupienky. Pri väčšej dávke opekaj lososa po častiach.", "requires": ["oil:raw", "salmon:seasoned"], "produces": ["oil:used", "salmon:cooked"]},
        {"text": "Podávaj ryžu v miskách s lososom, uhorkou a mrkvou. Polej všetko zvyšnou zálievkou, ozdob pažítkou a jedlo rozdeľ na {portions} porcií.", "requires": ["rice:cooked", "salmon:cooked", "oil:used", "cucumber:dressed", "carrot:dressed", "lemon:dressing", "soy:dressing", "chives:cut"], "produces": ["rice:served", "salmon:served", "oil:served", "cucumber:served", "carrot:served", "lemon:served", "soy:served", "chives:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Ryžu a lososa rozdeľ do plytkých nádob, do jednej hodiny ich schlaď a odlož do chladničky; zeleninu so zálievkou ulož zvlášť. Zjedz ich do 2 dní a ryžu ohrievaj iba raz, kým je celá horúca."}
    }
