    "pantry_basics": ["water", "salt", "black_pepper"],
    "instructions": [
      {"text": "Nakrájaj {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno. Rozdrv {tofu.amount} {tofu.name} vidličkou na drobné kúsky.", "requires": ["onion:raw", "garlic:raw", "tofu:raw"], "produces": ["onion:cut", "garlic:cut", "tofu:crumbled"]},
      {"text": "Uvar {pasta.amount} {pasta.name} v hrnci v osolenej vode na strednom ohni 8 až 12 minút podľa obalu, kým budú mäkké na zahryznutie. Pred scedením si odlož trochu vody z varenia.", "requires": ["pasta:raw", "hrniec:free"], "produces": ["pasta:cooked", "hrniec:free"]},
      {"text": "Rozohrej {oil.amount} {oil.name} v hlbokej panvici. Cibuľu opekaj na strednom ohni 4 minúty, kým zmäkne.", "requires": ["oil:raw", "onion:cut", "hlboka_panvica:free"], "produces": ["oil:hot", "onion:softened", "hlboka_panvica:occupied"]},
      {"text": "Pridaj cesnak a tofu do panvice. Opekaj cesnak s tofu v panvici na strednom ohni 5 minút, kým bude tofu miestami zlatisté.", "requires": ["garlic:cut", "tofu:crumbled", "oil:hot", "onion:softened", "hlboka_panvica:occupied"], "produces": ["garlic:cooked", "tofu:browned", "onion:cooked", "oil:cooked"]},
      {"text": "Vmiešaj {tomato.amount} {tomato.name}. Var paradajky s tofu v panvici na miernom ohni 10 minút, kým omáčka začne jemne bublať a bude hustejšia. Ak je príliš hustá, prilej vodu do panvice.", "requires": ["tomato:raw", "tofu:browned", "garlic:cooked", "onion:cooked", "oil:cooked", "hlboka_panvica:occupied"], "produces": ["tomato:cooked", "tofu:cooked"]},
      {"text": "Vmiešaj cestoviny do panvice, dochuť ich soľou a čiernym korením a rozdeľ na {portions} porcií.", "requires": ["pasta:cooked", "tomato:cooked", "tofu:cooked", "garlic:cooked", "onion:cooked", "oil:cooked", "hlboka_panvica:occupied"], "produces": ["pasta:served", "tomato:served", "tofu:served", "garlic:served", "onion:served", "oil:served", "hlboka_panvica:free"]}
    ],
