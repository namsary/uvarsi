      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Sceď a prepláchni {chickpeas.amount} {chickpeas.name}. Nakrájaj {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno.", "requires": ["chickpeas:raw", "onion:raw", "garlic:raw", "sitko:free"], "produces": ["chickpeas:drained", "onion:cut", "garlic:cut", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v hlbokej panvici. Cibuľu opekaj na strednom ohni 4 minúty, kým zmäkne.", "requires": ["oil:raw", "onion:cut", "hlboka_panvica_s_pokrievkou:free"], "produces": ["oil:hot", "onion:softened", "hlboka_panvica_s_pokrievkou:occupied"]},
        {"text": "Prisyp {curry.amount} {curry.name} do panvice. Pridaj cesnak do panvice. Miešaj približne 30 sekúnd, kým sa korenie rozvonia.", "requires": ["curry:raw", "garlic:cut", "oil:hot", "onion:softened", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["curry:toasted", "garlic:cooked"]},
        {"text": "Vmiešaj {tomato.amount} {tomato.name}, cícer a {coconut.amount} {coconut.name}. Osoľ, prikry a var cícer s paradajkami v panvici na miernom ohni 10 minút, kým omáčka začne jemne bublať.", "requires": ["tomato:raw", "chickpeas:drained", "coconut:raw", "curry:toasted", "garlic:cooked", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["tomato:cooked", "chickpeas:cooked", "coconut:cooked", "onion:cooked", "garlic:finished", "curry:cooked", "oil:cooked"]},
        {"text": "Pridaj {spinach.amount} {spinach.name} do panvice. Var špenát v panvici na miernom ohni bez pokrievky ešte 3 až 4 minúty, kým listy zmäknú. Dochuť soľou a čiernym korením.", "requires": ["spinach:raw", "tomato:cooked", "chickpeas:cooked", "coconut:cooked", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["spinach:cooked"]},
        {"text": "Podávaj cícerové kari horúce a rozdeľ ho na {portions} porcií.", "requires": ["chickpeas:cooked", "spinach:cooked", "tomato:cooked", "onion:cooked", "garlic:finished", "curry:cooked", "coconut:cooked", "oil:cooked", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["chickpeas:served", "spinach:served", "tomato:served", "onion:served", "garlic:served", "curry:served", "coconut:served", "oil:served", "hlboka_panvica_s_pokrievkou:free"]}
      ],
