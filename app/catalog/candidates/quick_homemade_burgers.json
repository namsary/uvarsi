        {"key": "bun", "role": "starch", "candidates": ["burger_bun"], "amount_per_adult": "1", "unit": "piece", "child_factor": "0.6", "required": true, "use": "main", "cut": null},
        {"key": "cheese", "role": "dairy", "candidates": ["hard_cheese"], "amount_per_adult": "20", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na plátky"},
        {"key": "lettuce", "role": "vegetable", "candidates": ["lettuce"], "amount_per_adult": "30", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": null},
        {"key": "tomato", "role": "vegetable", "candidates": ["tomato"], "amount_per_adult": "70", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "na kolieska"},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "25", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na tenké kolieska"},
        {"key": "pickles", "role": "vegetable", "candidates": ["pickled_cucumber"], "amount_per_adult": "1", "unit": "piece", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na plátky"},
