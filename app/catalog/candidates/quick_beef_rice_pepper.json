      "method": "one_pot",
      "minutes": 45,
      "modes": ["standard", "high_protein"],
      "equipment": ["sitko", "široký hrniec s pokrievkou", "vareška", "nôž", "doska na krájanie"],
      "slots": [
        {"key": "beef", "role": "protein", "candidates": ["beef_mince"], "amount_per_adult": "150", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": null},
        {"key": "rice", "role": "starch", "candidates": ["rice"], "amount_per_adult": "70", "unit": "g", "child_factor": "0.55", "required": true, "use": "main", "cut": null, "water_ml_per_adult": "170"},
        {"key": "pepper", "role": "vegetable", "candidates": ["bell_pepper"], "amount_per_adult": "150", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na kocky"},
        {"key": "tomato", "role": "vegetable", "candidates": ["tomato"], "amount_per_adult": "120", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "nahrubo"},
        {"key": "paste", "role": "vegetable", "candidates": ["tomato_paste"], "amount_per_adult": "20", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "50", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "paprika", "role": "seasoning", "candidates": ["paprika_powder"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "parsley", "role": "seasoning", "candidates": ["parsley"], "amount_per_adult": "5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "8", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {rice.amount} {rice.name} v sitku pod studenou vodou a nechaj ju odkvapkať.", "requires": ["rice:raw", "sitko:free"], "produces": ["rice:rinsed", "sitko:free"]},
        {"text": "Nakrájaj {pepper.amount} {pepper.name} na kocky, {tomato.amount} {tomato.name} nahrubo, {onion.amount} {onion.name} nadrobno, {garlic.amount} {garlic.name} najemno a {parsley.amount} {parsley.name} nadrobno.", "requires": ["pepper:raw", "tomato:raw", "onion:raw", "garlic:raw", "parsley:raw"], "produces": ["pepper:cut", "tomato:cut", "onion:cut", "garlic:cut", "parsley:cut"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v širokom hrnci na silnom ohni 1 minútu, kým sa začne lesknúť. Opekaj {beef.amount} {beef.name} 6 minút a vareškou ho rozbíjaj, kým stratí ružovú farbu a začne byť zlatisté. Pri väčšej dávke ho opekaj po častiach.", "requires": ["oil:raw", "beef:raw", "siroky_hrniec_s_pokrievkou:free", "vareska:free"], "produces": ["oil:used", "beef:browned", "siroky_hrniec_s_pokrievkou:occupied", "vareska:free"]},
        {"text": "Pridaj cibuľu a papriku do hrnca. Opekaj cibuľu s paprikou na strednom ohni 5 minút, kým zmäknú. Pridaj cesnak do hrnca a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["onion:cut", "pepper:cut", "garlic:cut", "beef:browned", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["onion:cooked", "pepper:cooked", "garlic:cooked"]},
        {"text": "Odstav hrniec z ohňa a vmiešaj {paprika.amount} {paprika.name} a {paste.amount} {paste.name}.", "requires": ["paprika:raw", "paste:raw", "pepper:cooked", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["paprika:mixed", "paste:mixed"]},
        {"text": "Vsyp ryžu a paradajky do hrnca a prilej {rice.water} vody. Priveď vodu s ryžou na strednom ohni do varu, kým začne bublať, a pridaj štipku soli. Prikry hrniec a var ryžu s mäsom na miernom ohni 18 minút, kým ryža vsiakne šťavu a zmäkne.", "requires": ["rice:rinsed", "tomato:cut", "paprika:mixed", "paste:mixed", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["rice:cooked", "tomato:cooked", "beef:cooked", "paprika:cooked", "paste:cooked"]},
        {"text": "Nechaj ryžu 5 minút postáť pod pokrievkou. Potom ju premiešaj s petržlenovou vňaťou a dochuť soľou a čiernym korením.", "requires": ["rice:cooked", "parsley:cut", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["rice:rested", "parsley:mixed"]},
        {"text": "Rozdeľ jedlo na {portions} porcií a podávaj ho teplé.", "requires": ["rice:rested", "beef:cooked", "pepper:cooked", "tomato:cooked", "paste:cooked", "onion:cooked", "garlic:cooked", "paprika:cooked", "parsley:mixed", "oil:used", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["rice:served", "beef:served", "pepper:served", "tomato:served", "paste:served", "onion:served", "garlic:served", "paprika:served", "parsley:served", "oil:served", "siroky_hrniec_s_pokrievkou:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Jedlo rozdeľ do plytkých nádob, do hodiny ho schlaď a odlož do chladničky. Zjedz ho do 3 dní a prehrievaj s lyžicou vody pod pokrievkou, kým bude celé horúce."}
    }
