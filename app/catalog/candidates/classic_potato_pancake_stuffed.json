        {"key": "sour_cream", "role": "dairy", "candidates": ["sour_cream"], "amount_per_adult": "25", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {pork.amount} {pork.name} {pork.cut}, osoľ a okoreň. Nakrájaj {onion.amount} {onion.name} {onion.cut}, {pepper.amount} {pepper.name} {pepper.cut} a {mushrooms.amount} {mushrooms.name} {mushrooms.cut}.", "requires": ["pork:raw", "onion:raw", "pepper:raw", "mushrooms:raw"], "produces": ["pork:seasoned", "onion:cut", "pepper:cut", "mushrooms:cut"]},
        {"text": "Rozohrej {oil2.amount} {oil2.name} v panvici na silnom ohni 1 minútu, kým sa zaleskne. Opekaj bravčové karé bez kosti v panvici po dávkach na silnom ohni 3 minúty, kým bude zlatisté. Mäso vyber na tanier.", "requires": ["pork:seasoned", "oil2:raw"], "produces": ["pork:browned", "oil2:used"]},
        {"text": "Opekaj cibuľu s paprikou a šampiňónmi v panvici na strednom ohni 6 minút, kým zmäknú a odparí sa z nich voda. Vmiešaj {paste.amount} {paste.name} a prilej {pork.water} vody. Vráť mäso do panvice. Dus bravčové karé bez kosti so zeleninou na miernom ohni 5 minút, kým mäso zmäkne a omáčka zhustne. Zmes dochuť soľou a čiernym korením a odlož ju v teple.", "requires": ["onion:cut", "pepper:cut", "mushrooms:cut", "paste:raw", "pork:browned"], "produces": ["onion:cooked", "pepper:cooked", "mushrooms:cooked", "paste:cooked", "pork:cooked"]},
        {"text": "Ošúp {potato.amount} {potato.name} a nastrúhaj ich {potato.cut} do misy. Zlej šťavu, ktorá sa z nich uvoľní. Pridaj {flour.amount} {flour.name}, {egg.amount} {egg.name}, {garlic.amount} prelisovaný {garlic.name}, {marjoram.amount} {marjoram.name} a štipku soli. Vymiešaj husté cesto.", "requires": ["potato:raw", "flour:raw", "egg:raw", "garlic:raw", "marjoram:raw"], "produces": ["potato:dough", "flour:dough", "egg:dough", "garlic:dough", "marjoram:dough"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Olej má pokryť dno panvice v tenkej vrstve, podľa potreby ho dolievaj z fľaše.", "requires": ["oil:raw"], "produces": ["oil:hot"]},
        {"text": "Rozlož naberačku cesta zo zemiakov do panvice a roztlač ho na placku veľkú ako tanier, hrubú asi 5 mm. Opekaj placky zo zemiakov po jednej vo veľkej panvici na strednom ohni 4 minúty z každej strany, kým budú zlatisté a chrumkavé. Hotové placky polož na papierovú utierku.", "requires": ["potato:dough", "flour:dough", "egg:dough", "garlic:dough", "marjoram:dough", "oil:hot"], "produces": ["potato:fried", "flour:fried", "egg:fried", "garlic:fried", "marjoram:fried", "oil:used"]},
        {"text": "Podávaj placky hneď: na polovicu každej daj horúcu mäsovú zmes a druhou polovicou ju prikry. Navrch daj {sour_cream.amount} {sour_cream.name} a rozdeľ jedlo na {portions} porcií.", "requires": ["pork:cooked", "onion:cooked", "pepper:cooked", "mushrooms:cooked", "paste:cooked", "potato:fried", "flour:fried", "egg:fried", "garlic:fried", "marjoram:fried", "oil:used", "oil2:used", "sour_cream:raw"], "produces": ["pork:served", "onion:served", "pepper:served", "mushrooms:served", "paste:served", "potato:served", "flour:served", "egg:served", "garlic:served", "marjoram:served", "oil:served", "oil2:served", "sour_cream:served"]}
      ],
      "storage": {"refrigerated_days": 1, "instruction": "Mäsovú zmes a placky ulož oddelene do uzavretých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do nasledujúceho dňa. Placky prehrej nasucho na panvici, aby znova schrumkaveli."}
