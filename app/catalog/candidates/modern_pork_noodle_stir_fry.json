      "pantry_basics": ["water", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {pork.amount} {pork.name}, {pepper.amount} {pepper.name} a {carrot.amount} {carrot.name} na tenké pásiky. {broccoli.amount} {broccoli.name} rozdeľ na malé ružičky a {garlic.amount} {garlic.name} nakrájaj najemno.", "requires": ["pork:raw", "pepper:raw", "carrot:raw", "broccoli:raw", "garlic:raw"], "produces": ["pork:cut", "pepper:cut", "carrot:cut", "broccoli:cut", "garlic:cut"]},
        {"text": "Premiešaj v miske {soy.amount} {soy.name}, {vinegar.amount} {vinegar.name}, {sugar.amount} {sugar.name}, cesnak a trochu čierneho korenia.", "requires": ["soy:raw", "vinegar:raw", "sugar:raw", "garlic:cut", "miska:free"], "produces": ["soy:sauce", "vinegar:sauce", "sugar:sauce", "garlic:sauce", "miska:occupied"]},
        {"text": "Uvar {noodles.amount} {noodles.name} v hrnci s vodou na strednom ohni 4 minúty, kým zmäknú, ale zostanú pevné. Potom ich sceď cez sitko.", "requires": ["noodles:raw", "hrniec:free", "sitko:free"], "produces": ["noodles:cooked", "hrniec:free", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo woku na silnom ohni 2 minúty, kým sa začne lesknúť.", "requires": ["oil:raw", "wok:free"], "produces": ["oil:heated", "wok:hot"]},
        {"text": "Opekaj bravčové karé vo woku na silnom ohni 6 minút, kým bude zlatisté a v strede prepečené. Pri väčšej dávke mäso opekaj po častiach.", "requires": ["pork:cut", "oil:heated", "wok:hot"], "produces": ["pork:cooked", "oil:used"]},
        {"text": "Pridaj papriku do woku. Vmiešaj mrkvu a brokolicu. Opekaj papriku s mrkvou, brokolicou a bravčovým karé vo woku na silnom ohni 6 minút, kým zostane zelenina farebná a bude mäkká na zahryznutie.", "requires": ["pepper:cut", "carrot:cut", "broccoli:cut", "pork:cooked", "wok:hot"], "produces": ["pepper:cooked", "carrot:cooked", "broccoli:cooked"]},
        {"text": "Vmiešaj vaječné rezance do woku. Prilej sójovú omáčku. Zohrievaj vaječné rezance s bravčovým karé a zeleninou vo woku na strednom ohni 3 minúty, kým omáčka jemne bublá a všetko sa ňou rovnomerne obalí.", "requires": ["soy:sauce", "vinegar:sauce", "sugar:sauce", "garlic:sauce", "noodles:cooked", "pork:cooked", "pepper:cooked", "carrot:cooked", "broccoli:cooked", "miska:occupied", "wok:hot"], "produces": ["soy:cooked", "vinegar:cooked", "sugar:cooked", "garlic:cooked", "noodles:combined", "pork:combined", "pepper:combined", "carrot:combined", "broccoli:combined", "miska:free", "wok:free"]},
        {"text": "Podávaj rezancovú panvičku a rozdeľ ju na {portions} porcií.", "requires": ["soy:cooked", "vinegar:cooked", "sugar:cooked", "garlic:cooked", "noodles:combined", "pork:combined", "pepper:combined", "carrot:combined", "broccoli:combined", "oil:used"], "produces": ["soy:served", "vinegar:served", "sugar:served", "garlic:served", "noodles:served", "pork:served", "pepper:served", "carrot:served", "broccoli:served", "oil:served"]}
