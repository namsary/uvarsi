        {"key": "flour", "role": "starch", "candidates": ["wheat_flour"], "amount_per_adult": "12", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "butter", "role": "fat", "candidates": ["butter"], "amount_per_adult": "10", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "buttereggs", "role": "fat", "candidates": ["butter"], "amount_per_adult": "5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "30", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "parsley", "role": "seasoning", "candidates": ["parsley"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Ošúp {potato.amount} {potato.name} a väčšie prekroj na polovice.", "requires": ["potato:raw"], "produces": ["potato:peeled"]},
        {"text": "Vlož zemiaky do hrnca. Dolej studenú vodu tak, aby boli ponorené, a osoľ ju. Var zemiaky v hrnci na strednom ohni 20 minút od začiatku varu, kým zmäknú. Sceď zemiaky cez sitko a prikry ich, aby nevychladli.", "requires": ["potato:peeled", "hrniec:free", "sitko:free"], "produces": ["potato:cooked", "hrniec:free", "sitko:free"]},
        {"text": "Nakrájaj {onion.amount} {onion.name} nadrobno, {garlic.amount} {garlic.name} najemno a {parsley.amount} {parsley.name} nadrobno.", "requires": ["onion:raw", "garlic:raw", "parsley:raw"], "produces": ["onion:cut", "garlic:cut", "parsley:cut"]},
        {"text": "Rozohrej {butter.amount} {butter.name} v širokom hrnci na miernom ohni 1 minútu, kým začne jemne bublať. Opekaj cibuľu v hrnci na miernom ohni 4 minúty, kým bude dosklovita. Pridaj cesnak do hrnca a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["butter:raw", "onion:cut", "garlic:cut", "siroky_hrniec:free"], "produces": ["butter:used", "onion:cooked", "garlic:cooked", "siroky_hrniec:occupied"]},
        {"text": "Prisyp {flour.amount} {flour.name} do hrnca. Opekaj hladkú pšeničnú múku s cibuľou za stáleho miešania na miernom ohni 1 minútu, kým začne jemne bublať a voňať.", "requires": ["flour:raw", "onion:cooked", "siroky_hrniec:occupied"], "produces": ["flour:roux"]},
        {"text": "Prilej {milk.amount} {milk.name}. Hneď ho rozmiešaj metličkou, aby nevznikli hrudky. Pridaj {spinach.amount} {spinach.name} do hrnca. Mrazený špenát nerozmrazuj, daj ho do hrnca rovno z mrazničky. Dus špenát pod pokrievkou na miernom ohni 10 minút a občas ho premiešaj, kým zmäkne a omáčka hladko zhustne a jemne bublá.", "requires": ["milk:raw", "spinach:raw", "flour:roux", "siroky_hrniec:occupied"], "produces": ["milk:cooked", "spinach:cooked", "flour:cooked"]},
        {"text": "Dochuť špenát soľou a čiernym korením. Ak je príliš hustý, dolej trochu vody alebo mlieka.", "requires": ["spinach:cooked"], "produces": ["spinach:seasoned"]},
        {"text": "Rozohrej {buttereggs.amount} {buttereggs.name} v panvici na strednom ohni 1 minútu, kým sa spení a začne jemne bublať. Opatrne rozbi do panvice {egg.amount} {egg.name} vedľa seba. Opekaj vajcia v panvici na miernom ohni 4 minúty, kým bielok stuhne a žĺtok ostane mäkký. Pri väčšom počte ich priprav po dávkach v tej istej panvici.", "requires": ["buttereggs:raw", "egg:raw", "panvica:free"], "produces": ["buttereggs:used", "egg:fried", "panvica:occupied"]},
        {"text": "Rozdeľ zemiaky a špenát na {portions} porcií, zemiaky ozdob petržlenovou vňaťou a na každú porciu polož volské oko. Podávaj ihneď.", "requires": ["spinach:seasoned", "potato:cooked", "egg:fried", "milk:cooked", "flour:cooked", "butter:used", "buttereggs:used", "onion:cooked", "garlic:cooked", "parsley:cut", "panvica:occupied", "siroky_hrniec:occupied"], "produces": ["spinach:served", "potato:served", "egg:served", "milk:served", "flour:served", "butter:served", "buttereggs:served", "onion:served", "garlic:served", "parsley:served", "panvica:free", "siroky_hrniec:free"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Špenát a zemiaky ulož oddelene do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 2 dní, špenát prehrievaj s trochou mlieka a volské oko vždy priprav čerstvé."}
