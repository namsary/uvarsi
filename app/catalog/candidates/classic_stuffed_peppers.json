      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {
          "text": "Prepláchni {rice.amount} {rice.name} studenou vodou.",
          "requires": ["rice:raw"],
          "produces": ["rice:rinsed"]
        },
        {
          "text": "Nalej {rice.water} vody do hrnca. Vsyp ryžu do hrnca. Prikry ho a var ryžu v malom hrnci na miernom ohni 8 minút, kým voda vsiakne a ryža zostane ešte pevná, potom ju nechaj vychladnúť.",
          "requires": ["rice:rinsed", "maly_hrniec:free"],
          "produces": ["rice:partly_cooked", "maly_hrniec:free"]
        },
        {
          "text": "Priprav {pepper.amount} {pepper.name}: odrež vršky a vyber jadrovníky, aby zostali celé duté struky.",
          "requires": ["pepper:raw"],
          "produces": ["pepper:hollowed"]
        },
        {
          "text": "Premiešaj v miske {beef.amount} {beef.name}, {onion.amount} {onion.name}, predvarenú ryžu, {egg.amount} {egg.name}, {marjoram.amount} {marjoram.name}, {garlic.amount} {garlic.name}, soľ a čierne korenie.",
          "requires": ["beef:raw", "onion:raw", "rice:partly_cooked", "egg:raw", "marjoram:raw", "garlic:raw", "miska:free"],
          "produces": ["beef:filling", "onion:filling", "rice:filling", "egg:filling", "marjoram:filling", "garlic:filling", "miska:occupied"]
        },
        {
          "text": "Rozdeľ mäsovú zmes do dutých paprík a pri okraji nechaj trochu miesta, pretože ryža pri varení zväčší objem.",
          "requires": ["pepper:hollowed", "beef:filling", "onion:filling", "rice:filling", "egg:filling", "marjoram:filling", "garlic:filling", "miska:occupied"],
          "produces": ["pepper:stuffed", "beef:stuffed", "onion:stuffed", "rice:stuffed", "egg:stuffed", "marjoram:stuffed", "garlic:stuffed", "miska:free"]
        },
        {
          "text": "Nakrájaj {tomato.amount} {tomato.name} nadrobno.",
          "requires": ["tomato:raw"],
          "produces": ["tomato:cut"]
        },
        {
          "text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci na strednom ohni 2 minúty, kým sa začne lesknúť.",
          "requires": ["oil:raw", "velky_hrniec:free"],
          "produces": ["oil:heated", "velky_hrniec:hot"]
        },
        {
          "text": "Prisyp {flour.amount} {flour.name} do veľkého hrnca. Opekaj hladkú pšeničnú múku za stáleho miešania na miernom ohni asi 1 minútu, kým zápražka nebude jemne zlatistá.",
          "requires": ["flour:raw", "oil:heated", "velky_hrniec:hot"],
          "produces": ["flour:roux", "oil:used", "velky_hrniec:occupied"]
        },
        {
          "text": "Prilej {flour.water} vody do veľkého hrnca. Prilievaj ju po častiach a miešaj metličkou, aby v omáčke nezostali hrudky. Pridaj paradajky a {sugar.amount} {sugar.name}. Omáčku var v hrnci na miernom ohni 8 minút, kým zhustne a začne jemne bublať. Ochutnaj ju; ak treba, dochuť ju soľou a cukrom.",
          "requires": ["tomato:cut", "sugar:raw", "flour:roux", "oil:used", "velky_hrniec:occupied"],
          "produces": ["tomato:sauce", "sugar:sauce", "flour:sauce", "oil:used", "velky_hrniec:occupied"]
        },
        {
          "text": "Vlož papriky do veľkého hrnca. Prikry ho a var papriky v omáčke na miernom ohni približne 35 minút, kým zmäknú a mäsová náplň bude uvarená aj v strede.",
          "requires": ["pepper:stuffed", "beef:stuffed", "onion:stuffed", "rice:stuffed", "egg:stuffed", "marjoram:stuffed", "garlic:stuffed", "tomato:sauce", "sugar:sauce", "flour:sauce", "oil:used", "velky_hrniec:occupied"],
          "produces": ["pepper:cooked", "beef:cooked", "onion:cooked", "rice:cooked", "egg:cooked", "marjoram:cooked", "garlic:cooked", "tomato:cooked", "sugar:cooked", "flour:cooked", "oil:cooked", "velky_hrniec:free"]
        },
        {
          "text": "Podávaj plnenú papriku s paradajkovou omáčkou a rozdeľ jedlo na {portions} porcií.",
          "requires": ["pepper:cooked", "beef:cooked", "onion:cooked", "rice:cooked", "egg:cooked", "marjoram:cooked", "garlic:cooked", "tomato:cooked", "sugar:cooked", "flour:cooked", "oil:cooked"],
          "produces": ["pepper:served", "beef:served", "onion:served", "rice:served", "egg:served", "marjoram:served", "garlic:served", "tomato:served", "sugar:served", "flour:served", "oil:served"]
        }
      ],
      "storage": {
        "refrigerated_days": 1,
        "instruction": "Plnenú papriku s ryžou rozdeľ do plytkých nádob a do jednej hodiny ju schlaď. V chladničke ju zjedz do 24 hodín; porcie na neskôr hneď zamraz. Ohrievaj iba raz, kým bude celá horúca."
      }
