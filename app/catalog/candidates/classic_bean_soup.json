      "instructions": [
        {
          "text": "Prepláchni {beans.amount} {beans.name} v sitku pod studenou vodou. Potom sceď vodu.",
          "requires": [
            "beans:raw",
            "sitko:free"
          ],
          "produces": [
            "beans:rinsed",
            "sitko:used"
          ]
        },
        {
          "text": "Namoč červenú fazuľu v miske do vody najmenej na 12 hodín, kým napučí.",
          "requires": [
            "beans:rinsed",
            "miska:free"
          ],
          "produces": [
            "beans:soaked",
            "miska:used"
          ]
        },
        {
          "text": "Sceď červenú fazuľu v sitku a prepláchni ju čistou vodou.",
          "requires": [
            "beans:soaked",
            "sitko:used"
          ],
          "produces": [
            "beans:rinsed_after_soak"
          ]
        },
        {
          "text": "Nakrájaj {onion.amount} {onion.name} najemno, {carrot.amount} {carrot.name} na kolieska a {potato.amount} {potato.name} na 2 cm kocky. Rozdrv {garlic.amount} {garlic.name} plochou stranou noža.",
          "requires": [
            "onion:raw",
            "carrot:raw",
            "potato:raw",
            "garlic:raw",
            "noz:free",
            "doska_na_krajanie:free"
          ],
          "produces": [
            "onion:chopped",
            "carrot:sliced",
            "potato:cubed",
            "garlic:crushed",
            "noz:used",
            "doska_na_krajanie:used"
          ]
        },
        {
          "text": "Nalej {oil.amount} {oil.name} do hrnca.",
          "requires": [
            "oil:raw",
            "velky_hrniec:free"
          ],
          "produces": [
            "oil:heated",
            "velky_hrniec:used"
          ]
        },
        {
          "text": "Opekaj cibuľu a mrkvu vo veľkom hrnci na strednom ohni 5 minút, kým cibuľa zmäkne.",
          "requires": [
            "onion:chopped",
            "carrot:sliced",
            "oil:heated",
            "velky_hrniec:used"
          ],
          "produces": [
            "onion:softened",
            "carrot:softened",
            "oil:used"
          ]
        },
        {
          "text": "Odstav hrniec z ohňa. Prisyp {paprika.amount} {paprika.name} a premiešaj ju 30 sekúnd.",
          "requires": [
            "onion:softened",
            "paprika:raw",
            "velky_hrniec:used"
          ],
          "produces": [
            "onion:seasoned",
            "paprika:bloomed"
          ]
        },
        {
          "text": "Pridaj {beans.reference_name} a cesnak do hrnca. Nalej {beans.water} vody do hrnca. Na silnom ohni priveď obsah hrnca do prudkého varu a bez pokrievky var 30 minút. Potom stíš oheň a var fazuľu na miernom ohni ďalších 30 minút, kým fazuľa zmäkne; spolu ju var najmenej 60 minút. Ak ešte nie je mäkká, var ju ďalej a skontroluj ju každých 10 minút.",
          "requires": [
            "beans:rinsed_after_soak",
            "garlic:crushed",
            "onion:seasoned",
            "carrot:softened",
            "oil:used",
            "paprika:bloomed",
            "velky_hrniec:used"
          ],
          "produces": [
            "beans:nearly_tender",
            "garlic:cooked",
            "onion:cooked",
            "carrot:cooked",
            "oil:cooked",
            "paprika:cooked"
          ]
        },
        {
          "text": "Pridaj zemiaky do hrnca. Prisyp {salt.amount} {salt.name} a {pepper.amount} {pepper.name}. Var zemiaky s fazuľou vo veľkom hrnci na miernom ohni 15 minút, kým zmäknú.",
          "requires": [
            "beans:nearly_tender",
            "potato:cubed",
            "salt:raw",
            "pepper:raw",
            "velky_hrniec:used"
          ],
          "produces": [
            "beans:cooked",
            "potato:cooked",
            "salt:dissolved",
            "pepper:dissolved"
          ]
        },
        {
          "text": "Podávaj fazuľovú polievku horúcu, keď sú fazuľa aj zemiaky mäkké.",
          "requires": [
            "beans:cooked",
            "potato:cooked",
            "carrot:cooked",
            "onion:cooked",
            "garlic:cooked",
            "oil:cooked",
            "paprika:cooked",
            "salt:dissolved",
            "pepper:dissolved"
          ],
          "produces": [
            "beans:served",
            "potato:served",
            "carrot:served",
            "onion:served",
            "garlic:served",
            "oil:served",
            "paprika:served",
            "salt:served",
            "pepper:served"
          ]
        }
      ],
      "storage": {
        "refrigerated_days": 3,
        "instruction": "Fazuľovú polievku rozdeľ do plytkých nádob a najneskôr do 2 hodín ju odlož do chladničky. Zjedz ju do 3 dní a pred podávaním ju dôkladne prehrej."
      }
