      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {chicken.amount} {chicken.name} a {cucumber.amount} {cucumber.name} na tenké prúžky. {tomato.amount} {tomato.name} nakrájaj na malé kúsky, {lettuce.amount} {lettuce.name} na tenké pásiky a {garlic.amount} {garlic.name} najemno. Priprav {lemon.amount} {lemon.name} na dochutenie a vytlač z neho šťavu.", "requires": ["chicken:raw", "cucumber:raw", "tomato:raw", "lettuce:raw", "garlic:raw", "lemon:raw"], "produces": ["chicken:cut", "cucumber:cut", "tomato:cut", "lettuce:cut", "garlic:cut", "lemon:juiced"]},
        {"text": "Premiešaj {skyr.amount} {skyr.name} s cesnakom, citrónovou šťavou, soľou a čiernym korením v miske.", "requires": ["skyr:raw", "garlic:cut", "lemon:juiced", "miska:free"], "produces": ["skyr:mixed", "garlic:mixed", "lemon:mixed", "miska:occupied"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 2 minúty, kým sa začne lesknúť.", "requires": ["oil:raw", "panvica:free"], "produces": ["oil:hot", "panvica:occupied"]},
        {"text": "Opekaj kuracie prsia v panvici na strednom ohni 8 minút a priebežne ich obracaj, kým budú zlatisté a v strede bez ružových miest.", "requires": ["chicken:cut", "oil:hot", "panvica:occupied"], "produces": ["chicken:cooked", "oil:used"]},
        {"text": "Vyber kuracie mäso z panvice a odlož ho na chvíľu bokom.", "requires": ["chicken:cooked", "oil:used", "panvica:occupied"], "produces": ["chicken:resting", "panvica:free"]},
        {"text": "Zohrej {tortilla.amount} {tortilla.name} v suchej panvici na strednom ohni 1 minútu z každej strany, kým zmäknú a budú sa dať ľahko zvinúť.", "requires": ["tortilla:raw", "panvica:free"], "produces": ["tortilla:warmed", "panvica:free"]},
        {"text": "Rozlož omáčku z bieleho skyru, kuracie mäso, uhorku, paradajky a šalát na tortilly. Pevne ich zaviň.", "requires": ["tortilla:warmed", "skyr:mixed", "garlic:mixed", "lemon:mixed", "chicken:resting", "cucumber:cut", "tomato:cut", "lettuce:cut", "miska:occupied"], "produces": ["tortilla:filled", "skyr:filled", "garlic:filled", "lemon:filled", "chicken:filled", "cucumber:filled", "tomato:filled", "lettuce:filled", "oil:filled", "miska:free"]},
        {"text": "Podávaj wrapy hneď alebo ich zabaľ na neskôr. Pripravené jedlo rozdeľ na {portions} porcií.", "requires": ["tortilla:filled", "skyr:filled", "garlic:filled", "lemon:filled", "chicken:filled", "cucumber:filled", "tomato:filled", "lettuce:filled", "oil:filled"], "produces": ["tortilla:served", "skyr:served", "garlic:served", "lemon:served", "chicken:served", "cucumber:served", "tomato:served", "lettuce:served", "oil:served"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Kuracie mäso, zeleninu a skyrovú omáčku uchovaj v oddelených uzatvárateľných nádobách najviac 3 dni. Wrap zlož až pred jedlom, aby tortilla nezvlhla."}
