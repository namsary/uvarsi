        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "70", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "pepper", "role": "vegetable", "candidates": ["bell_pepper"], "amount_per_adult": "60", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "na malé kúsky"},
        {"key": "paprika", "role": "seasoning", "candidates": ["paprika_powder"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "sour_cream", "role": "dairy", "candidates": ["sour_cream"], "amount_per_adult": "50", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "flour", "role": "starch", "candidates": ["wheat_flour"], "amount_per_adult": "10", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "12", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "parsley", "role": "seasoning", "candidates": ["parsley"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {turkey.amount} {turkey.name} {turkey.cut}, {onion.amount} {onion.name} {onion.cut}, {pepper.amount} {pepper.name} {pepper.cut} a {parsley.amount} {parsley.name} {parsley.cut}. Mäso zľahka osoľ.", "requires": ["turkey:raw", "onion:raw", "pepper:raw", "parsley:raw"], "produces": ["turkey:cut", "onion:cut", "pepper:cut", "parsley:cut"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci na silnom ohni 2 minúty, kým sa začne lesknúť. Opekaj morčacie prsia 3 minúty za stáleho miešania, kým na povrchu stuhnú. Pri väčšej dávke opekaj mäso po častiach. Vyber ho na tanier.", "requires": ["oil:raw", "turkey:cut"], "produces": ["oil:used", "turkey:seared"]},
        {"text": "Opekaj cibuľu vo veľkom hrnci na strednom ohni 7 minút, kým bude zlatistá. Pridaj papriku a opekaj ju 3 minúty, kým zmäkne.", "requires": ["onion:cut", "pepper:cut", "oil:used"], "produces": ["onion:cooked", "pepper:cooked"]},
        {"text": "Odstav hrniec z ohňa. Vmiešaj {paprika.amount} {paprika.name}. Hneď nato prilej {turkey.water} vody, aby paprika nezhorkla.", "requires": ["paprika:raw", "onion:cooked"], "produces": ["paprika:base"]},
        {"text": "Vráť morčacie prsia do hrnca a hrniec postav späť na oheň. Prikry ho a dus morčacie prsia v hrnci na miernom ohni 10 minút, kým šťava jemne bublá a mäso v strede nebude ružové.", "requires": ["turkey:seared", "paprika:base"], "produces": ["turkey:simmered", "paprika:cooked"]},
        {"text": "Ošúp {potato.amount} {potato.name} a nakrájaj ich {potato.cut}. Vlož zemiaky do hrnca, dolej studenú vodu tak, aby boli ponorené, a vodu osoľ. Var zemiaky v hrnci na miernom ohni 20 minút, kým zmäknú, potom ich sceď.", "requires": ["potato:raw"], "produces": ["potato:cooked"]},
        {"text": "Rozšľahaj v miske {sour_cream.amount} {sour_cream.name}, {flour.amount} {flour.name} a tri lyžice horúcej šťavy z hrnca dohladka. Zmes vlievaj do veľkého hrnca za stáleho miešania. Var morčacie prsia v omáčke na miernom ohni 4 minúty, kým omáčka zhustne a začne jemne bublať.", "requires": ["sour_cream:raw", "flour:raw", "turkey:simmered"], "produces": ["sour_cream:cooked", "flour:cooked", "turkey:cooked"]},
        {"text": "Dochuť omáčku soľou a čiernym korením. Podávaj morčacie na paprike so zemiakmi posypanými petržlenovou vňaťou a rozdeľ jedlo na {portions} porcií.", "requires": ["turkey:cooked", "sour_cream:cooked", "flour:cooked", "paprika:cooked", "onion:cooked", "pepper:cooked", "oil:used", "potato:cooked", "parsley:cut"], "produces": ["turkey:served", "sour_cream:served", "flour:served", "paprika:served", "onion:served", "pepper:served", "oil:served", "potato:served", "parsley:served"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Mäso s omáčkou a zemiaky rozdeľ do plytkých nádob, do jednej hodiny ich schlaď a odlož do chladničky. Zjedz ich do 3 dní; omáčku prehrievaj na miernom ohni s lyžicou vody iba raz, kým je horúca, a nevar ju prudko."}
    }
  ],
