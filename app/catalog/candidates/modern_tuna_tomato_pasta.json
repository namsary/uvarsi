      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {tomato.amount} {tomato.name} na menšie kúsky, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno. Sceď {tuna.amount} {tuna.name}.", "requires": ["tomato:raw", "onion:raw", "garlic:raw", "tuna:raw", "sitko:free"], "produces": ["tomato:cut", "onion:cut", "garlic:cut", "tuna:drained", "sitko:free"]},
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci vo vriacej osolenej vode na strednom ohni 9 minút, kým budú mäkké, ale stále pevné na zahryznutie.", "requires": ["pasta:raw", "hrniec:free"], "produces": ["pasta:cooked", "hrniec:occupied"]},
        {"text": "Odober z hrnca {pasta.water} vody, potom cestoviny sceď cez sitko.", "requires": ["pasta:cooked", "hrniec:occupied", "sitko:free"], "produces": ["pasta:drained", "hrniec:free", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Pridaj cibuľu a opekaj ju 4 minúty, kým zmäkne.", "requires": ["oil:raw", "onion:cut", "panvica:free"], "produces": ["oil:used", "onion:cooked", "panvica:occupied"]},
        {"text": "Pridaj paradajky do panvice. Vmiešaj cesnak a {oregano.amount} {oregano.name}. Var paradajky v panvici na miernom ohni 10 minút, kým zmäknú a omáčka zhustne.", "requires": ["tomato:cut", "garlic:cut", "oregano:raw", "onion:cooked", "oil:used", "panvica:occupied"], "produces": ["tomato:cooked", "garlic:cooked", "oregano:cooked", "oil:cooked"]},
        {"text": "Vmiešaj {tuna.reference_name} a cestoviny do panvice. Prehrievaj cestoviny s tuniakom na miernom ohni 3 minúty, kým omáčka začne jemne bublať; ak je príliš hustá, použi časť odloženej vody.", "requires": ["tuna:drained", "pasta:drained", "tomato:cooked", "garlic:cooked", "oregano:cooked", "oil:cooked", "panvica:occupied"], "produces": ["tuna:cooked", "pasta:combined"]},
        {"text": "Dochuť jedlo soľou a čiernym korením. Podávaj ho teplé a rozdeľ na {portions} porcií.", "requires": ["tuna:cooked", "pasta:combined", "tomato:cooked", "onion:cooked", "garlic:cooked", "oil:cooked", "oregano:cooked", "panvica:occupied"], "produces": ["tuna:served", "pasta:served", "tomato:served", "onion:served", "garlic:served", "oil:served", "oregano:served", "panvica:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Jedlo rozdeľ do plytkých nádob a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 3 dní a ohrievaj iba porciu, ktorú práve podávaš."}
    }
