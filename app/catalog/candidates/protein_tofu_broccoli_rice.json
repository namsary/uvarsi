      "modes": ["standard", "high_protein", "vegetarian", "vegan"],
      "equipment": ["panvica", "hrniec", "miska", "tanier", "nôž", "doska na krájanie"],
      "slots": [
        {"key": "tofu", "role": "protein", "candidates": ["tofu"], "amount_per_adult": "200", "unit": "g", "child_factor": "0.65", "required": true, "use": "main", "cut": "na kocky"},
        {"key": "rice", "role": "starch", "candidates": ["rice"], "amount_per_adult": "60", "unit": "g", "child_factor": "0.55", "required": true, "use": "main", "cut": null, "water_ml_per_adult": "120"},
        {"key": "broccoli", "role": "vegetable", "candidates": ["broccoli"], "amount_per_adult": "180", "unit": "g", "child_factor": "0.7", "required": true, "use": "addition", "cut": "na malé ružičky"},
        {"key": "carrot", "role": "vegetable", "candidates": ["carrot"], "amount_per_adult": "100", "unit": "g", "child_factor": "0.65", "required": true, "use": "addition", "cut": "na tenké prúžky"},
        {"key": "soy", "role": "seasoning", "candidates": ["soy_sauce"], "amount_per_adult": "20", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "8", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {rice.amount} {rice.name} studenou vodou.", "requires": ["rice:raw"], "produces": ["rice:rinsed"]},
        {"text": "Nalej {rice.water} vody do hrnca.", "requires": ["hrniec:free"], "produces": ["hrniec:occupied"]},
        {"text": "Vsyp ryžu do hrnca.", "requires": ["rice:rinsed", "hrniec:occupied"], "produces": ["rice:ready"]},
        {"text": "Var ryžu v prikrytom hrnci na miernom ohni 15 minút, kým zmäkne a vsiakne vodu.", "requires": ["rice:ready", "hrniec:occupied"], "produces": ["rice:cooked", "hrniec:free"]},
        {"text": "Osuš {tofu.amount} {tofu.name} a nakrájaj ho na kocky. Rozdeľ {broccoli.amount} {broccoli.name} na malé ružičky, {carrot.amount} {carrot.name} nakrájaj na tenké prúžky a {garlic.amount} {garlic.name} najemno.", "requires": ["tofu:raw", "broccoli:raw", "carrot:raw", "garlic:raw"], "produces": ["tofu:cut", "broccoli:cut", "carrot:cut", "garlic:cut"]},
        {"text": "Premiešaj {soy.amount} {soy.name} s cesnakom v miske.", "requires": ["soy:raw", "garlic:cut", "miska:free"], "produces": ["soy:mixed", "garlic:mixed", "miska:occupied"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 2 minúty, kým sa začne lesknúť.", "requires": ["oil:raw", "panvica:free"], "produces": ["oil:hot", "panvica:occupied"]},
        {"text": "Opekaj tofu v panvici na strednom ohni 8 minút a priebežne ho obracaj, kým bude z viacerých strán zlatisté.", "requires": ["tofu:cut", "oil:hot", "panvica:occupied", "tanier:free"], "produces": ["tofu:browned", "oil:used"]},
        {"text": "Vyber tofu na tanier.", "requires": ["tofu:browned", "panvica:occupied", "tanier:free"], "produces": ["tofu:resting", "tanier:occupied"]},
        {"text": "Opekaj brokolicu a mrkvu v panvici na strednom ohni 6 minút, kým trochu zmäknú, ale zostanú pevné.", "requires": ["broccoli:cut", "carrot:cut", "oil:used", "panvica:occupied"], "produces": ["broccoli:cooked", "carrot:cooked"]},
        {"text": "Vráť tofu do panvice.", "requires": ["tofu:resting", "broccoli:cooked", "carrot:cooked", "panvica:occupied", "tanier:occupied"], "produces": ["tofu:in_pan", "tanier:free"]},
        {"text": "Vlej sójovú omáčku do panvice. Prehrievaj tofu a zeleninu v panvici na miernom ohni 2 minúty, kým zelenina zmäkne a omáčka ju obalí.", "requires": ["soy:mixed", "garlic:mixed", "tofu:in_pan", "broccoli:cooked", "carrot:cooked", "miska:occupied", "panvica:occupied"], "produces": ["soy:cooked", "garlic:cooked", "tofu:cooked", "broccoli:finished", "carrot:finished", "miska:free"]},
        {"text": "Podávaj tofu so zeleninou a ryžou. Jedlo rozdeľ na {portions} porcií.", "requires": ["tofu:cooked", "broccoli:finished", "carrot:finished", "soy:cooked", "garlic:cooked", "oil:used", "rice:cooked", "panvica:occupied"], "produces": ["tofu:served", "broccoli:served", "carrot:served", "soy:served", "garlic:served", "oil:served", "rice:served", "panvica:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Jedlo rozdeľ do plytkých uzatvárateľných nádob a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 3 dní a pri ohrievaní ho dôkladne prehrej."}
    }
