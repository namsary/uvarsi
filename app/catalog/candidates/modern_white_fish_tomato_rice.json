      "instructions": [
        {"text": "Predhrej rúru na 200 °C. Prepláchni {rice.amount} {rice.name}. Nakrájaj {tomato.amount} {tomato.name} na menšie kúsky, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno. Rozdeľ {fish.amount} {fish.name} na porcie.", "requires": ["rura:free", "rice:raw", "tomato:raw", "onion:raw", "garlic:raw", "fish:raw"], "produces": ["rura:hot", "rice:rinsed", "tomato:cut", "onion:cut", "garlic:cut", "fish:portioned"]},
        {"text": "Premiešaj v pekáči ryžu s paradajkami, cibuľou, cesnakom, {oil.amount} {oil.name}, {oregano.amount} {oregano.name}, {rice.water} vody, soľou a čiernym korením. Rozlož ryžu rovnomerne po dne; pri väčšej dávke zmes rozdeľ do dvoch pekáčov.", "requires": ["oil:raw", "rice:rinsed", "tomato:cut", "onion:cut", "garlic:cut", "oregano:raw", "pekac:free"], "produces": ["oil:arranged", "rice:arranged", "tomato:arranged", "onion:arranged", "garlic:arranged", "oregano:arranged", "pekac:occupied"]},
        {"text": "Peč ryžu v prikrytom pekáči pri 200 °C 25 minút, kým takmer vsiakne tekutinu a zrnká začnú mäknúť.", "requires": ["rice:arranged", "tomato:arranged", "onion:arranged", "garlic:arranged", "oregano:arranged", "oil:arranged", "pekac:occupied", "rura:hot"], "produces": ["rice:partly_cooked", "tomato:cooked", "onion:cooked", "garlic:cooked", "oregano:cooked", "oil:cooked"]},
        {"text": "Vlož rybu do pekáča. Nechaj pekáč odkrytý. Peč rybu s ryžou v pekáči pri 200 °C ďalších 12 minút, kým sa ryba bude ľahko oddeľovať vidličkou a ryža bude mäkká.", "requires": ["fish:portioned", "rice:partly_cooked", "tomato:cooked", "onion:cooked", "garlic:cooked", "oregano:cooked", "oil:cooked", "pekac:occupied", "rura:hot"], "produces": ["fish:cooked", "rice:cooked"]},
        {"text": "Nechaj jedlo v pekáči 5 minút odpočívať. Podávaj rybu s paradajkovou ryžou a rozdeľ ju na {portions} porcií.", "requires": ["fish:cooked", "rice:cooked", "tomato:cooked", "onion:cooked", "garlic:cooked", "oregano:cooked", "oil:cooked", "pekac:occupied"], "produces": ["fish:served", "rice:served", "tomato:served", "onion:served", "garlic:served", "oregano:served", "oil:served", "pekac:free", "rura:free"]}
      ],
