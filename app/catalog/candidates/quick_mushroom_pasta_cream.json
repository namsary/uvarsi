        {"key": "parsley", "role": "seasoning", "candidates": ["parsley"], "amount_per_adult": "5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {mushrooms.amount} {mushrooms.name} na plátky, {onion.amount} {onion.name} nadrobno, {garlic.amount} {garlic.name} najemno a {parsley.amount} {parsley.name} nadrobno. Nastrúhaj {cheese.amount} {cheese.name} najemno.", "requires": ["mushrooms:raw", "onion:raw", "garlic:raw", "parsley:raw", "cheese:raw"], "produces": ["mushrooms:cut", "onion:cut", "garlic:cut", "parsley:cut", "cheese:grated"]},
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci vo vriacej osolenej vode na strednom ohni 9 minút, kým budú mäkké, ale stále pevné. Odober z hrnca {pasta.water} vody a potom cestoviny sceď cez sitko.", "requires": ["pasta:raw", "hrniec:free", "sitko:free"], "produces": ["pasta:cooked", "hrniec:free", "sitko:free"]},
        {"text": "Rozohrej {butter.amount} {butter.name} vo veľkej panvici na strednom ohni 1 minútu, kým sa roztopí a začne jemne bublať. Opekaj cibuľu 3 minúty, kým zmäkne.", "requires": ["butter:raw", "onion:cut", "velka_panvica:free"], "produces": ["butter:used", "onion:cooked", "velka_panvica:occupied"]},
        {"text": "Pridaj šampiňóny a {thyme.amount} {thyme.name} do panvice. Opekaj šampiňóny na silnom ohni 8 minút, kým pustia šťavu, tá sa odparí a huby budú zlatisté. Mrazené šampiňóny nerozmrazuj, daj ich do panvice rovno z mrazničky a opekaj ich o 4 minúty dlhšie. Pridaj cesnak do panvice a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["mushrooms:cut", "thyme:raw", "garlic:cut", "onion:cooked", "velka_panvica:occupied"], "produces": ["mushrooms:cooked", "thyme:cooked", "garlic:cooked"]},
        {"text": "Prilej {cream.amount} {cream.name} do panvice. Var šampiňóny v smotane na miernom ohni 3 minúty, kým omáčka začne jemne bublať a zhustne.", "requires": ["cream:raw", "mushrooms:cooked", "velka_panvica:occupied"], "produces": ["cream:cooked", "mushrooms:sauced"]},
        {"text": "Pridaj cestoviny do panvice. Zohrievaj cestoviny v omáčke na miernom ohni 2 minúty, kým omáčka jemne bublá a obalí ich. Ak je omáčka hustá, prilievaj po troškách odloženú vodu z cestovín, kým bude krémová.", "requires": ["pasta:cooked", "cream:cooked", "mushrooms:sauced", "velka_panvica:occupied"], "produces": ["pasta:combined"]},
        {"text": "Dochuť cestoviny čiernym korením a soľou až po ochutnaní, syr na tanieri je slaný. Rozdeľ ich na {portions} porcií, navrch nasyp tvrdý syr a petržlenovú vňať a podávaj.", "requires": ["pasta:combined", "cream:cooked", "mushrooms:sauced", "cheese:grated", "parsley:cut", "onion:cooked", "garlic:cooked", "thyme:cooked", "butter:used", "velka_panvica:occupied"], "produces": ["pasta:served", "cream:served", "mushrooms:served", "cheese:served", "parsley:served", "onion:served", "garlic:served", "thyme:served", "butter:served", "velka_panvica:free"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Cestoviny s omáčkou rozdeľ do plytkých nádob, do 2 hodín ich odlož do chladničky a zjedz do 2 dní. Syr pridaj až na tanier a pri ohrievaní vmiešaj lyžicu vody."}
