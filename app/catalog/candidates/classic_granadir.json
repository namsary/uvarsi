      "instructions": [
        {
          "text": "Ošúp {potato.amount} {potato.name} a nakrájaj ich na 2 cm kocky.",
          "requires": [
            "potato:raw",
            "noz:free",
            "doska_na_krajanie:free"
          ],
          "produces": [
            "potato:cubed",
            "noz:used",
            "doska_na_krajanie:used"
          ]
        },
        {
          "text": "Uvar zemiaky vo veľkom hrnci vo vriacej vode na strednom ohni 12 minút, kým zmäknú, ale nerozpadajú sa.",
          "requires": [
            "potato:cubed",
            "velky_hrniec:free"
          ],
          "produces": [
            "potato:cooked",
            "velky_hrniec:used"
          ]
        },
        {
          "text": "Uvar {pasta.amount} {pasta.name} v druhom hrnci vo vriacej vode na strednom ohni 8 minút, kým zmäknú a stále držia tvar.",
          "requires": [
            "pasta:raw",
            "druhy_hrniec:free"
          ],
          "produces": [
            "pasta:cooked",
            "druhy_hrniec:used"
          ]
        },
        {
          "text": "Sceď zemiaky aj cestoviny v cedidle a nechaj ich dobre odkvapkať.",
          "requires": [
            "potato:cooked",
            "pasta:cooked",
            "cedidlo:free"
          ],
          "produces": [
            "potato:drained",
            "pasta:drained",
            "cedidlo:used"
          ]
        },
        {
          "text": "Nakrájaj {onion.amount} {onion.name} najemno na doske na krájanie.",
          "requires": [
            "onion:raw",
            "noz:used",
            "doska_na_krajanie:used"
          ],
          "produces": [
            "onion:chopped"
          ]
        },
        {
          "text": "Nalej {oil.amount} {oil.name} do panvice.",
          "requires": [
            "oil:raw",
            "panvica:free"
          ],
          "produces": [
            "oil:heated",
            "panvica:used"
          ]
        },
        {
          "text": "Opekaj cibuľu v panvici na strednom ohni 6 minút dozlatista.",
          "requires": [
            "onion:chopped",
            "oil:heated",
            "panvica:used"
          ],
          "produces": [
            "onion:browned",
            "oil:used"
          ]
        },
        {
          "text": "Odstav panvicu z ohňa, pridaj {paprika.amount} {paprika.name} a premiešaj ju 30 sekúnd.",
          "requires": [
            "onion:browned",
            "paprika:raw",
            "panvica:used"
          ],
          "produces": [
            "onion:seasoned",
            "paprika:bloomed"
          ]
        },
        {
          "text": "Pridaj zemiaky a cestoviny do panvice. Prisyp {salt.amount} {salt.name} a {pepper.amount} {pepper.name}. Premiešaj všetko 1 minútu a podávaj horúce.",
          "requires": [
            "potato:drained",
            "pasta:drained",
            "onion:seasoned",
            "oil:used",
            "paprika:bloomed",
            "salt:raw",
            "pepper:raw",
            "panvica:used"
          ],
          "produces": [
            "potato:served",
            "pasta:served",
            "onion:served",
            "oil:served",
            "paprika:served",
            "salt:served",
            "pepper:served"
          ]
        }
      ],
      "storage": {
        "refrigerated_days": 2,
        "instruction": "Granadír rozdeľ do plytkých nádob a odlož do chladničky najneskôr do 2 hodín. Zjedz ho do 2 dní a zohrievaj iba porciu, ktorú hneď zješ."
      }
    }
