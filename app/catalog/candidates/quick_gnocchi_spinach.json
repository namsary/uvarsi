      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {garlic.amount} {garlic.name} najemno. Nastrúhaj {cheese.amount} {cheese.name} najemno.", "requires": ["garlic:raw", "cheese:raw"], "produces": ["garlic:cut", "cheese:grated"]},
        {"text": "Uvar {gnocchi.amount} {gnocchi.name} v hrnci vo vriacej osolenej vode na strednom ohni 3 minúty, kým vyplávajú na hladinu a zmäknú. Sceď gnocchi cez sitko.", "requires": ["gnocchi:raw", "hrniec:free", "sitko:free"], "produces": ["gnocchi:cooked", "hrniec:free", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Vmiešaj cesnak do panvice a opekaj ho 1 minútu, kým jemne zozlatne. Pridaj {spinach.amount} {spinach.name} do panvice a opekaj ho 4 minúty, kým zvädne a zmäkne.", "requires": ["oil:raw", "garlic:cut", "spinach:raw", "panvica:free"], "produces": ["oil:used", "garlic:cooked", "spinach:cooked", "panvica:occupied"]},
        {"text": "Vlej {cream.amount} {cream.name} do panvice. Prisyp tvrdý syr do panvice. Var smotanu na varenie so špenátom v panvici na miernom ohni 3 minúty, kým omáčka začne bublať a zhustne.", "requires": ["cream:raw", "cheese:grated", "spinach:cooked", "garlic:cooked", "oil:used", "panvica:occupied"], "produces": ["cream:cooked", "cheese:melted", "spinach:sauced"]},
        {"text": "Pridaj gnocchi do panvice. Prehrievaj gnocchi v panvici na miernom ohni 2 minúty, kým ich omáčka rovnomerne obalí a začne jemne bublať.", "requires": ["gnocchi:cooked", "cream:cooked", "cheese:melted", "spinach:sauced", "panvica:occupied"], "produces": ["gnocchi:combined", "cream:combined", "cheese:combined", "spinach:combined", "garlic:combined", "oil:cooked"]},
        {"text": "Dochuť gnocchi soľou a čiernym korením. Podávaj ich teplé a rozdeľ na {portions} porcií.", "requires": ["gnocchi:combined", "cream:combined", "cheese:combined", "spinach:combined", "garlic:combined", "oil:cooked", "panvica:occupied"], "produces": ["gnocchi:served", "cream:served", "cheese:served", "spinach:served", "garlic:served", "oil:served", "panvica:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Gnocchi rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní a pri ohrievaní pridaj lyžicu vody."}
