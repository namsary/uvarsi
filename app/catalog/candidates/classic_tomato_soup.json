      "instructions": [
        {
          "text": "Nakrájaj {tomato.amount} {tomato.name} na štvrtiny, {carrot.amount} {carrot.name} na tenké kolieska a {onion.amount} {onion.name} najemno. Rozdrv {garlic.amount} {garlic.name} plochou stranou noža.",
          "requires": [
            "tomato:raw",
            "carrot:raw",
            "onion:raw",
            "garlic:raw",
            "noz:free",
            "doska_na_krajanie:free"
          ],
          "produces": [
            "tomato:quartered",
            "carrot:sliced",
            "onion:chopped",
            "garlic:crushed",
            "noz:used",
            "doska_na_krajanie:used"
          ]
        },
        {
          "text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci na strednom ohni 2 minúty, kým sa začne lesknúť.",
          "requires": [
            "oil:raw",
            "velky_hrniec:free"
          ],
          "produces": [
            "oil:heated",
            "velky_hrniec:used"
          ]
        },
        {
          "text": "Opekaj cibuľu a mrkvu vo veľkom hrnci na strednom ohni 6 minút, kým cibuľa zmäkne.",
          "requires": [
            "onion:chopped",
            "carrot:sliced",
            "oil:heated",
            "velky_hrniec:used"
          ],
          "produces": [
            "onion:softened",
            "carrot:softened",
            "oil:used"
          ]
        },
        {
          "text": "Pridaj paradajky a cesnak do hrnca. Prilej {tomato.water} vody a obsah hrnca priveď do varu. Potom var paradajky vo veľkom hrnci na miernom ohni 25 minút, kým paradajky a mrkva zmäknú.",
          "requires": [
            "tomato:quartered",
            "garlic:crushed",
            "onion:softened",
            "carrot:softened",
            "oil:used",
            "velky_hrniec:used"
          ],
          "produces": [
            "tomato:cooked",
            "garlic:cooked",
            "onion:cooked",
            "carrot:cooked",
            "oil:cooked"
          ]
        },
        {
          "text": "Rozmixuj obsah hrnca ponorným mixérom 1 minútu, kým je polievka hladká.",
          "requires": [
            "tomato:cooked",
            "garlic:cooked",
            "onion:cooked",
            "carrot:cooked",
            "oil:cooked",
            "ponorny_mixer:free"
          ],
          "produces": [
            "tomato:pureed",
            "garlic:pureed",
            "onion:pureed",
            "carrot:pureed",
            "oil:mixed",
            "ponorny_mixer:used"
          ]
        },
        {
          "text": "Vsyp {pasta.amount} {pasta.name} do hrnca. Var cestoviny vo veľkom hrnci na miernom ohni 9 minút, kým budú mäkké, ale ešte pevné na zahryznutie.",
          "requires": [
            "pasta:raw",
            "tomato:pureed",
            "velky_hrniec:used"
          ],
          "produces": [
            "pasta:cooked"
          ]
        },
        {
          "text": "Prisyp {salt.amount} {salt.name} a {pepper.amount} {pepper.name} do hrnca. Prehrievaj rozmixované paradajky vo veľkom hrnci na miernom ohni 3 minúty, kým polievka začne jemne bublať.",
          "requires": [
            "tomato:pureed",
            "pasta:cooked",
            "salt:raw",
            "pepper:raw",
            "velky_hrniec:used"
          ],
          "produces": [
            "tomato:hot",
            "pasta:hot",
            "salt:dissolved",
            "pepper:dissolved"
          ]
        },
        {
          "text": "Podávaj paradajkovú polievku horúcu, keď je hladká a jemne bublá.",
          "requires": [
            "tomato:hot",
            "pasta:hot",
            "carrot:pureed",
            "onion:pureed",
            "garlic:pureed",
            "oil:mixed",
            "salt:dissolved",
            "pepper:dissolved"
          ],
          "produces": [
            "tomato:served",
            "pasta:served",
            "carrot:served",
            "onion:served",
            "garlic:served",
            "oil:served",
            "salt:served",
            "pepper:served"
          ]
        }
      ],
      "storage": {
        "refrigerated_days": 3,
        "instruction": "Paradajkovú polievku rozdeľ do plytkých nádob a najneskôr do 2 hodín ju odlož do chladničky. Zjedz ju do 3 dní a pred podávaním ju priveď k miernemu varu."
      }
