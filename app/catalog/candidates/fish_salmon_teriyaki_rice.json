      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {rice.amount} {rice.name} v sitku pod studenou vodou.", "requires": ["rice:raw"], "produces": ["rice:rinsed"]},
        {"text": "Nalej {rice.water} vody do hrnca a pridaj štipku soli. Vsyp ryžu do hrnca a prikry ho. Var ryžu na miernom ohni 15 minút, kým voda vsiakne a ryža zmäkne. Potom ju nechaj 5 minút prikrytú postáť.", "requires": ["rice:rinsed"], "produces": ["rice:cooked"]},
        {"text": "Nakrájaj {garlic.amount} {garlic.name} {garlic.cut} a rozdeľ {broccoli.amount} {broccoli.name} {broccoli.cut}.", "requires": ["garlic:raw", "broccoli:raw"], "produces": ["garlic:cut", "broccoli:cut"]},
        {"text": "Premiešaj v miske {soy.amount} {soy.name}, {sugar.amount} {sugar.name}, {vinegar.amount} {vinegar.name}, cesnak a {salmon.water} vody, kým sa cukor rozpustí.", "requires": ["soy:raw", "sugar:raw", "vinegar:raw", "garlic:cut"], "produces": ["soy:sauce", "sugar:sauce", "vinegar:sauce", "garlic:sauce"]},
        {"text": "Uvar brokolicu v malom hrnci s osolenou vodou na strednom ohni 4 minúty, kým zmäkne, ale ostane jasne zelená. Mrazenú brokolicu nerozmrazuj, var ju rovno z mrazničky o 2 minúty dlhšie. Sceď brokolicu cez sitko.", "requires": ["broccoli:cut"], "produces": ["broccoli:cooked"]},
        {"text": "Osuš {salmon.amount} {salmon.name} papierovou utierkou, rozdeľ ho {salmon.cut} a okoreň. Soľ nepridávaj, sójová omáčka je slaná.", "requires": ["salmon:raw"], "produces": ["salmon:portioned"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj lososa kožou nadol 4 minúty, kým bude koža chrumkavá. Potom ho obráť a opekaj ešte 2 minúty, kým bude na povrchu zlatistý.", "requires": ["oil:raw", "salmon:portioned"], "produces": ["oil:used", "salmon:seared"]},
        {"text": "Stíš oheň a vylej omáčku z misky do panvice. Var lososa v omáčke na strednom ohni 2 minúty a stále ho polievaj, kým omáčka začne bublať, zhustne a začne sa lesknúť.", "requires": ["salmon:seared", "soy:sauce", "sugar:sauce", "vinegar:sauce", "garlic:sauce"], "produces": ["salmon:glazed", "soy:glazed", "sugar:glazed", "vinegar:glazed", "garlic:glazed"]},
        {"text": "Podávaj lososa na ryži s brokolicou a polej ho teriyaki omáčkou z panvice. Jedlo rozdeľ na {portions} porcií.", "requires": ["salmon:glazed", "rice:cooked", "broccoli:cooked", "soy:glazed", "sugar:glazed", "vinegar:glazed", "garlic:glazed", "oil:used"], "produces": ["salmon:served", "rice:served", "broccoli:served", "soy:served", "sugar:served", "vinegar:served", "garlic:served", "oil:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Lososa s omáčkou, ryžu a brokolicu ulož do plytkých uzavretých nádob, do jednej hodiny ich schlaď a odlož do chladničky. Zjedz ich do 2 dní a ryžu ohrievaj iba raz, kým bude celá horúca."}
