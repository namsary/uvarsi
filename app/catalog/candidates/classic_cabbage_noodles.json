      "instructions": [
        {
          "text": "Nakrájaj {cabbage.amount} {cabbage.name} na tenké rezance a {onion.amount} {onion.name} najemno.",
          "requires": [
            "cabbage:raw",
            "onion:raw",
            "noz:free",
            "doska_na_krajanie:free"
          ],
          "produces": [
            "cabbage:shredded",
            "onion:chopped",
            "noz:used",
            "doska_na_krajanie:used"
          ]
        },
        {
          "text": "Nalej {oil.amount} {oil.name} do panvice.",
          "requires": [
            "oil:raw",
            "panvica:free"
          ],
          "produces": [
            "oil:heated",
            "panvica:used"
          ]
        },
        {
          "text": "Opekaj cibuľu v panvici na strednom ohni 4 minúty, kým zmäkne.",
          "requires": [
            "onion:chopped",
            "oil:heated",
            "panvica:used"
          ],
          "produces": [
            "onion:softened",
            "oil:used"
          ]
        },
        {
          "text": "Pridaj bielu hlávkovú kapustu, {sugar.amount} {sugar.name}, {salt.amount} {salt.name} a {pepper.amount} {pepper.name}. Pri väčšej dávke opekaj kapustu po častiach, aby sa zmestila do panvice a mohla zozlatnúť. Každú časť opekaj na strednom ohni asi 18 minút a pravidelne miešaj, kým kapusta zmäkne a miestami zozlatne.",
          "requires": [
            "cabbage:shredded",
            "onion:softened",
            "oil:used",
            "sugar:raw",
            "salt:raw",
            "pepper:raw",
            "panvica:used"
          ],
          "produces": [
            "cabbage:cooked",
            "onion:cooked",
            "oil:cooked",
            "sugar:caramelized",
            "salt:dissolved",
            "pepper:mixed"
          ]
        },
        {
          "text": "Uvar {pasta.amount} {pasta.name}; na tento recept zvoľ fliačky a vo veľkom hrnci ich var vo vriacej vode na strednom ohni 8 minút, kým budú mäkké, ale stále pevné.",
          "requires": [
            "pasta:raw",
            "velky_hrniec:free"
          ],
          "produces": [
            "pasta:cooked",
            "velky_hrniec:used"
          ]
        },
        {
          "text": "Sceď cestoviny a nechaj ich krátko odkvapkať.",
          "requires": [
            "pasta:cooked",
            "velky_hrniec:used",
            "cedidlo:free"
          ],
          "produces": [
            "pasta:drained",
            "velky_hrniec:free",
            "cedidlo:used"
          ]
        },
        {
          "text": "Prehrievaj cestoviny s kapustou v panvici na strednom ohni 2 minúty, kým sa z nich začne pariť. Kapustové fliačky podávaj horúce.",
          "requires": [
            "pasta:drained",
            "cabbage:cooked",
            "onion:cooked",
            "oil:cooked",
            "sugar:caramelized",
            "salt:dissolved",
            "pepper:mixed",
            "panvica:used"
          ],
          "produces": [
            "pasta:served",
            "cabbage:served",
            "onion:served",
            "oil:served",
            "sugar:served",
            "salt:served",
            "pepper:served"
          ]
        }
      ],
      "storage": {
        "refrigerated_days": 3,
        "instruction": "Kapustové fliačky rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní a ohrievaj iba porciu, ktorú hneď zješ."
      }
