      "instructions": [
        {"text": "Nakrájaj {tomato.amount} {tomato.name} a {mozzarella.amount} {mozzarella.name} na malé kúsky a {garlic.amount} {garlic.name} najemno.", "requires": ["tomato:raw", "mozzarella:raw", "garlic:raw"], "produces": ["tomato:cut", "mozzarella:cut", "garlic:cut"]},
