        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci vo vriacej osolenej vode na strednom ohni približne 9 minút, kým budú mäkké, ale pevné na zahryznutie.", "requires": ["pasta:raw", "hrniec:free"], "produces": ["pasta:cooked", "hrniec:occupied"]},
        {"text": "Sceď cestoviny cez sitko. Vlož cestoviny do veľkej misky. Premiešaj ich s paradajkovou zmesou, kým ich šťava s pestom rovnomerne obalí a mozzarella začne mäknúť.", "requires": ["pasta:cooked", "tomato:marinated", "mozzarella:marinated", "garlic:marinated", "pesto:mixed", "oil:mixed", "hrniec:occupied", "sitko:free", "velka_miska:occupied"], "produces": ["pasta:mixed", "tomato:mixed", "mozzarella:softened", "garlic:mixed", "pesto:combined", "oil:combined", "hrniec:free", "sitko:free"]},
        {"text": "Podávaj cestoviny s paradajkami a mozzarellou hneď a rozdeľ ich na {portions} porcií.", "requires": ["pasta:mixed", "tomato:mixed", "mozzarella:softened", "garlic:mixed", "pesto:combined", "oil:combined", "velka_miska:occupied"], "produces": ["pasta:served", "tomato:served", "mozzarella:served", "garlic:served", "pesto:served", "oil:served", "velka_miska:free"]}
      ],
