      "instructions": [
        {"text": "Nakrájaj {chicken.amount} {chicken.name} na rezance, {mushrooms.amount} {mushrooms.name} na plátky a {onion.amount} {onion.name} nadrobno. Cesnak nakrájaj najemno a {cheese.amount} {cheese.name} nastrúhaj.", "requires": ["chicken:raw", "mushrooms:raw", "onion:raw", "garlic:raw", "cheese:raw"], "produces": ["chicken:cut", "mushrooms:cut", "onion:cut", "garlic:cut", "cheese:grated"]},
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci s osolenou vodou na strednom ohni asi 9 minút, kým budú mäkké, ale stále pevné. Potom ich sceď cez sitko.", "requires": ["pasta:raw", "hrniec:free", "sitko:free"], "produces": ["pasta:cooked", "hrniec:free", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj cibuľu 4 minúty, kým zmäkne.", "requires": ["oil:raw", "onion:cut", "panvica:free"], "produces": ["oil:used", "onion:cooked", "panvica:occupied"]},
        {"text": "Opekaj kuracie prsia v panvici na strednom ohni 6 minút, kým budú zlatisté. Pri väčšej dávke mäso priprav po častiach.", "requires": ["chicken:cut", "oil:used", "onion:cooked", "panvica:occupied"], "produces": ["chicken:browned"]},
        {"text": "Pridaj šampiňóny a {garlic.amount} {garlic.name} do panvice. Opekaj šampiňóny s cesnakom v panvici na strednom ohni 6 minút, kým huby zmäknú a na dne nezostane takmer žiadna šťava.", "requires": ["mushrooms:cut", "garlic:cut", "chicken:browned", "panvica:occupied"], "produces": ["mushrooms:cooked", "garlic:cooked"]},
        {"text": "Prilej {cream.amount} {cream.name} do panvice. Var kuracie prsia v smotanovej omáčke na miernom ohni 4 minúty, kým omáčka začne jemne bublať a mäso nebude v strede ružové.", "requires": ["cream:raw", "mushrooms:cooked", "garlic:cooked", "chicken:browned", "panvica:occupied"], "produces": ["cream:cooked", "chicken:cooked"]},
        {"text": "Pridaj cestoviny do panvice. Zohrievaj cestoviny v omáčke na miernom ohni 2 minúty, kým omáčka jemne bublá a cestoviny sa ňou rovnomerne obalia.", "requires": ["pasta:cooked", "cream:cooked", "chicken:cooked", "mushrooms:cooked", "panvica:occupied"], "produces": ["pasta:combined", "panvica:free"]},
        {"text": "Dochuť jedlo soľou a čiernym korením. Rozdeľ ho na {portions} porcií, navrch nasyp syr a podávaj.", "requires": ["chicken:cooked", "pasta:combined", "mushrooms:cooked", "onion:cooked", "garlic:cooked", "cream:cooked", "cheese:grated", "oil:used"], "produces": ["chicken:served", "pasta:served", "mushrooms:served", "onion:served", "garlic:served", "cream:served", "cheese:served", "oil:served"]}
      ],
