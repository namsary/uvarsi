      "name_template": "Rybí guláš s chlebom",
      "family": "fish_fish_goulash",
      "method": "pot",
      "minutes": 45,
      "modes": ["standard", "high_protein"],
      "equipment": ["hrniec", "vareška", "nôž", "doska na krájanie", "papierová utierka"],
      "slots": [
        {"key": "fish", "role": "protein", "candidates": ["white_fish"], "amount_per_adult": "180", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na kocky veľké 3 centimetre", "water_ml_per_adult": "180"},
        {"key": "bread", "role": "starch", "candidates": ["bread"], "amount_per_adult": "70", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": null},
        {"key": "potato", "role": "starch", "candidates": ["potato"], "amount_per_adult": "150", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "na malé kocky"},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "80", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "pepper", "role": "vegetable", "candidates": ["bell_pepper"], "amount_per_adult": "80", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "na kúsky"},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "12", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "paprika", "role": "seasoning", "candidates": ["paprika_powder"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "paste", "role": "vegetable", "candidates": ["tomato_paste"], "amount_per_adult": "15", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "marjoram", "role": "seasoning", "candidates": ["marjoram"], "amount_per_adult": "0.5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "parsley", "role": "seasoning", "candidates": ["parsley"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {onion.amount} {onion.name} {onion.cut}, {garlic.amount} {garlic.name} {garlic.cut}, {pepper.amount} {pepper.name} {pepper.cut} a {parsley.amount} {parsley.name} {parsley.cut}. Ošúp {potato.amount} {potato.name} a nakrájaj ich {potato.cut}.", "requires": ["onion:raw", "garlic:raw", "pepper:raw", "parsley:raw", "potato:raw"], "produces": ["onion:cut", "garlic:cut", "pepper:cut", "parsley:cut", "potato:cut"]},
        {"text": "Nalej {oil.amount} {oil.name} do hrnca. Opekaj cibuľu v hrnci na strednom ohni 7 minút, kým bude zlatistá. Pridaj cesnak a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["oil:raw", "onion:cut", "garlic:cut"], "produces": ["oil:used", "onion:cooked", "garlic:cooked"]},
        {"text": "Odstav hrniec z ohňa. Vmiešaj {paprika.amount} {paprika.name} a {paste.amount} {paste.name}.", "requires": ["paprika:raw", "paste:raw"], "produces": ["paprika:base", "paste:base"]},
        {"text": "Prilej {fish.water} vody do hrnca a pridaj zemiaky. Prisyp {marjoram.amount} {marjoram.name} a štipku soli. Priveď vodu so zemiakmi do varu a var zemiaky na miernom ohni 12 minút, kým takmer zmäknú.", "requires": ["potato:cut", "marjoram:raw", "paprika:base", "paste:base"], "produces": ["potato:simmered", "marjoram:cooked", "paprika:cooked", "paste:cooked"]},
        {"text": "Pridaj papriku do hrnca. Var papriku so zemiakmi na miernom ohni 5 minút, kým paprika zmäkne a zemiaky budú celkom mäkké.", "requires": ["pepper:cut", "potato:simmered"], "produces": ["pepper:cooked", "potato:cooked"]},
        {"text": "Osuš {fish.amount} {fish.name} papierovou utierkou, nakrájaj ju {fish.cut} a zľahka osoľ.", "requires": ["fish:raw"], "produces": ["fish:cut"]},
        {"text": "Vlož rybu do hrnca. Jemne ju ponor do omáčky. Var rybu na miernom ohni 6 minút, kým kocky stuhnú a guláš začne jemne bublať. Nemiešaj prudko, aby sa ryba nerozpadla.", "requires": ["fish:cut"], "produces": ["fish:cooked"]},
        {"text": "Dochuť guláš soľou a čiernym korením a jemne vmiešaj petržlenovú vňať. Nakrájaj {bread.amount} {bread.name} na krajce.", "requires": ["parsley:cut", "bread:raw"], "produces": ["parsley:used", "bread:sliced"]},
        {"text": "Podávaj rybí guláš s chlebom a rozdeľ ho na {portions} porcií.", "requires": ["fish:cooked", "bread:sliced", "potato:cooked", "onion:cooked", "garlic:cooked", "pepper:cooked", "oil:used", "paprika:cooked", "paste:cooked", "marjoram:cooked", "parsley:used"], "produces": ["fish:served", "bread:served", "potato:served", "onion:served", "garlic:served", "pepper:served", "oil:served", "paprika:served", "paste:served", "marjoram:served", "parsley:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Vychladnutý guláš ulož do uzavretej nádoby a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 2 dní a ohrievaj ho len raz, pomaly a bez miešania, aby sa ryba nerozpadla. Chlieb skladuj oddelene."}
    }
  ],
