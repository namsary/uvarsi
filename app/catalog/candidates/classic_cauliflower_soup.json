      "instructions": [
        {
          "text": "Nakrájaj {cauliflower.amount} {cauliflower.name} na malé ružičky. Ošúp {potato.amount} {potato.name} a nakrájaj ich na 2 cm kocky. Nakrájaj {carrot.amount} {carrot.name} na tenké kolieska a {onion.amount} {onion.name} najemno. Rozdrv {garlic.amount} {garlic.name}.",
          "requires": [
            "cauliflower:raw",
            "potato:raw",
            "carrot:raw",
            "onion:raw",
            "garlic:raw",
            "noz:free",
            "doska_na_krajanie:free"
          ],
          "produces": [
            "cauliflower:florets",
            "potato:cubed",
            "carrot:sliced",
            "onion:chopped",
            "garlic:crushed",
            "noz:used",
            "doska_na_krajanie:used"
          ]
        },
        {
          "text": "Nalej {oil.amount} {oil.name} do hrnca.",
          "requires": [
            "oil:raw",
            "velky_hrniec:free"
          ],
          "produces": [
            "oil:heated",
            "velky_hrniec:used"
          ]
        },
        {
          "text": "Opekaj cibuľu s mrkvou vo veľkom hrnci na strednom ohni 5 minút, kým cibuľa zmäkne.",
          "requires": [
            "onion:chopped",
            "carrot:sliced",
            "oil:heated",
            "velky_hrniec:used"
          ],
          "produces": [
            "onion:softened",
            "carrot:softened",
            "oil:used"
          ]
        },
        {
          "text": "Nalej {potato.water} vody do hrnca. Var zemiaky vo veľkom hrnci na miernom ohni 10 minút, kým čiastočne zmäknú.",
          "requires": [
            "potato:cubed",
            "onion:softened",
            "carrot:softened",
            "oil:used",
            "velky_hrniec:used"
          ],
          "produces": [
            "potato:partly_cooked",
            "onion:cooked",
            "carrot:cooked",
            "oil:cooked"
          ]
        },
        {
          "text": "Pridaj karfiol, cesnak a {pasta.amount} {pasta.name}. Var karfiol so zemiakmi a cestovinami vo veľkom hrnci na miernom ohni ďalších 10 minút, kým zemiaky aj cestoviny zmäknú a karfiol zostane pevný na zahryznutie.",
          "requires": [
            "cauliflower:florets",
            "garlic:crushed",
            "pasta:raw",
            "potato:partly_cooked",
            "velky_hrniec:used"
          ],
          "produces": [
            "cauliflower:cooked",
            "garlic:cooked",
            "pasta:cooked",
            "potato:cooked"
          ]
        },
        {
          "text": "Prisyp {salt.amount} {salt.name} a {pepper.amount} {pepper.name}. Polievku povar 2 minúty, kým začne jemne bublať.",
          "requires": [
            "cauliflower:cooked",
            "pasta:cooked",
            "salt:raw",
            "pepper:raw",
            "velky_hrniec:used"
          ],
          "produces": [
            "cauliflower:finished",
            "pasta:cooked",
            "salt:dissolved",
            "pepper:dissolved"
          ]
        },
        {
          "text": "Podávaj karfiolovú polievku horúcu, kým sú ružičky mäkké a držia tvar.",
          "requires": [
            "cauliflower:finished",
            "potato:cooked",
            "carrot:cooked",
            "onion:cooked",
            "garlic:cooked",
            "oil:cooked",
            "salt:dissolved",
            "pepper:dissolved"
          ],
          "produces": [
            "cauliflower:served",
            "pasta:served",
            "potato:served",
            "carrot:served",
            "onion:served",
            "garlic:served",
            "oil:served",
            "salt:served",
            "pepper:served"
          ]
        }
      ],
      "storage": {
        "refrigerated_days": 3,
        "instruction": "Karfiolovú polievku rozdeľ do plytkých nádob a najneskôr do 2 hodín ju odlož do chladničky. Zjedz ju do 3 dní a pred podávaním ju priveď k miernemu varu."
