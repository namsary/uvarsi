        {"key": "meat", "role": "protein", "candidates": ["beef_mince"], "amount_per_adult": "180", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": null},
        {"key": "bread", "role": "starch", "candidates": ["bread"], "amount_per_adult": "35", "unit": "g", "child_factor": "0.55", "required": true, "use": "addition", "cut": null, "water_ml_per_adult": "40"},
        {"key": "egg", "role": "protein", "candidates": ["egg"], "amount_per_adult": "0.5", "unit": "piece", "child_factor": "0.65", "required": true, "use": "addition", "cut": null},
        {"key": "tomato", "role": "vegetable", "candidates": ["tomato"], "amount_per_adult": "250", "unit": "g", "child_factor": "0.65", "required": true, "use": "main", "cut": "nahrubo"},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "60", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "10", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Predhrej rúru na 200 °C.", "requires": ["rura:free"], "produces": ["rura:heated"]},
        {"text": "Namoč {bread.amount} {bread.name} do {bread.water} vody na 5 minút, kým zmäkne.", "requires": ["bread:raw"], "produces": ["bread:soaked"]},
        {"text": "Nakrájaj {onion.amount} {onion.name} {onion.cut} a priprav {tomato.amount} {tomato.name} {tomato.cut}.", "requires": ["onion:raw", "tomato:raw"], "produces": ["onion:cut", "tomato:prepared"]},
        {"text": "Premiešaj v mise {meat.amount} {meat.name}, vytlačený chlieb, {egg.amount} {egg.name}, polovicu cibule, {garlic.amount} {garlic.name}, soľ a čierne korenie. Zmes mies rukami 2 minúty, kým bude držať pokope.", "requires": ["meat:raw", "bread:soaked", "egg:raw", "onion:cut", "garlic:raw", "misa:free"], "produces": ["meat:mixed", "bread:mixed", "egg:mixed", "onion:divided", "garlic:mixed", "misa:occupied"]},
        {"text": "Priprav z mäsovej zmesi guľky veľké ako vlašský orech a rozlož ich na plech.", "requires": ["meat:mixed", "bread:mixed", "egg:mixed", "garlic:mixed", "misa:occupied", "plech:free"], "produces": ["meat:formed", "bread:formed", "egg:formed", "garlic:formed", "misa:free", "plech:occupied"]},
        {"text": "Peč guľky z mletého hovädzieho mäsa na plechu v rúre pri 200 °C 18 minút, kým budú zlatisté a v strede prepečené.", "requires": ["meat:formed", "bread:formed", "egg:formed", "garlic:formed", "plech:occupied", "rura:heated"], "produces": ["meat:cooked", "bread:cooked", "egg:cooked", "garlic:cooked", "plech:free", "rura:free"]},
        {"text": "Rozohrej v hrnci {oil.amount} {oil.name} na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj v ňom zvyšnú cibuľu 3 minúty, kým bude mäkká a zlatistá.", "requires": ["onion:divided", "oil:raw", "hrniec:free"], "produces": ["onion:cooked", "oil:used", "hrniec:occupied"]},
        {"text": "Pridaj paradajky do hrnca a dus ich na miernom ohni 15 minút, kým zmäknú a vytvoria hustú omáčku.", "requires": ["tomato:prepared", "onion:cooked", "oil:used", "hrniec:occupied"], "produces": ["tomato:cooked", "oil:cooked"]},
        {"text": "Zohrievaj guľky z mletého hovädzieho mäsa v omáčke v hrnci na miernom ohni 3 minúty, kým omáčka jemne bublá.", "requires": ["meat:cooked", "bread:cooked", "egg:cooked", "garlic:cooked", "tomato:cooked", "onion:cooked", "oil:cooked", "hrniec:occupied"], "produces": ["meat:served", "bread:served", "egg:served", "garlic:served", "tomato:served", "onion:served", "oil:served", "hrniec:free"]},
        {"text": "Dochuť omáčku soľou a čiernym korením a rozdeľ jedlo na {portions} porcií.", "requires": ["meat:served", "bread:served", "garlic:served", "tomato:served", "onion:served", "oil:served"], "produces": []}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Mäsové guľky s omáčkou rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní."}
    }
  ],
