      "instructions": [
        {
          "text": "Prepláchni {lentils.amount} {lentils.name} v sitku pod studenou vodou a nechaj ju odkvapkať.",
          "requires": [
            "lentils:raw",
            "sitko:free"
          ],
          "produces": [
            "lentils:rinsed",
            "sitko:used"
          ]
        },
        {
          "text": "Ošúp {potato.amount} {potato.name} a nakrájaj ich na 2 cm kocky. Nakrájaj {carrot.amount} {carrot.name} na tenké kolieska a {onion.amount} {onion.name} najemno.",
          "requires": [
            "potato:raw",
            "carrot:raw",
            "onion:raw",
            "noz:free",
            "doska_na_krajanie:free"
          ],
          "produces": [
            "potato:cubed",
            "carrot:sliced",
            "onion:chopped",
            "noz:used",
            "doska_na_krajanie:used"
          ]
        },
        {
          "text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci a opekaj cibuľu na strednom ohni 5 minút, kým zmäkne.",
          "requires": [
            "oil:raw",
            "onion:chopped",
            "velky_hrniec:free"
          ],
          "produces": [
            "oil:used",
            "onion:softened",
            "velky_hrniec:used"
          ]
        },
        {
          "text": "Vlož šošovicu do hrnca, prilej {lentils.water} vody a var ju na miernom ohni 20 minút, kým čiastočne zmäkne.",
          "requires": [
            "lentils:rinsed",
            "onion:softened",
            "oil:used",
            "velky_hrniec:used"
          ],
          "produces": [
            "lentils:partly_cooked",
            "onion:cooked",
            "oil:cooked"
          ]
        },
        {
          "text": "Pridaj zemiaky a mrkvu. Podľa potreby dolej vodu a var ich vo veľkom hrnci na miernom ohni ďalších 15 minút, kým šošovica aj zemiaky zmäknú.",
          "requires": [
            "lentils:partly_cooked",
            "potato:cubed",
            "carrot:sliced",
            "velky_hrniec:used"
          ],
          "produces": [
            "lentils:cooked",
            "potato:cooked",
            "carrot:cooked"
          ]
        },
        {
          "text": "Premiešaj v mise metličkou {cream.amount} {cream.name} a {flour.amount} {flour.name}. Primiešaj naberačku horúcej polievky, aby sa zátrepka postupne zohriala.",
          "requires": [
            "cream:raw",
            "flour:raw",
            "misa:free",
            "metlicka:free"
          ],
          "produces": [
            "cream:tempered",
            "flour:slurry",
            "misa:used",
            "metlicka:used"
          ]
        },
        {
          "text": "Premiešaj polievku s pripravenou smotanovou zátrepkou a var ju vo veľkom hrnci na miernom ohni 5 minút, kým začne jemne bublať a mierne zhustne.",
          "requires": [
            "lentils:cooked",
            "potato:cooked",
            "carrot:cooked",
            "cream:tempered",
            "flour:slurry",
            "velky_hrniec:used",
            "varecha:free"
          ],
          "produces": [
            "lentils:thickened",
            "potato:finished",
            "carrot:finished",
            "cream:cooked",
            "flour:cooked",
            "varecha:used"
          ]
        },
        {
          "text": "Odstav hrniec z ohňa. Vmiešaj {vinegar.amount} {vinegar.name}, {salt.amount} {salt.name} a {pepper.amount} {pepper.name}.",
          "requires": [
            "lentils:thickened",
            "vinegar:raw",
            "salt:raw",
            "pepper:raw",
            "velky_hrniec:used",
            "varecha:used"
          ],
          "produces": [
            "lentils:finished",
            "vinegar:mixed",
            "salt:dissolved",
            "pepper:mixed"
          ]
        },
        {
          "text": "Podávaj kyslú šošovicovú polievku horúcu, keď je šošovica mäkká a polievka krémová.",
          "requires": [
            "lentils:finished",
            "potato:finished",
            "carrot:finished",
            "onion:cooked",
            "cream:cooked",
            "flour:cooked",
            "vinegar:mixed",
            "oil:cooked",
            "salt:dissolved",
            "pepper:mixed"
          ],
          "produces": [
            "lentils:served",
            "potato:served",
            "carrot:served",
            "onion:served",
            "cream:served",
            "flour:served",
            "vinegar:served",
            "oil:served",
            "salt:served",
            "pepper:served"
          ]
        }
      ],
      "storage": {
        "refrigerated_days": 2,
        "instruction": "Šošovicovú polievku rozdeľ do plytkých nádob a odlož do chladničky najneskôr do 2 hodín. Zjedz ju do 2 dní a zohrievaj iba raz."
      }
