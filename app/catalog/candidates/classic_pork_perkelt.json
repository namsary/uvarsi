      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {
          "text": "Nakrájaj {pork.amount} {pork.name} na menšie kocky, {onion.amount} {onion.name} nadrobno, {pepper.amount} {pepper.name} na pásiky a {tomato.amount} {tomato.name} na malé kúsky.",
          "requires": ["pork:raw", "onion:raw", "pepper:raw", "tomato:raw"],
          "produces": ["pork:cut", "onion:cut", "pepper:cut", "tomato:cut"]
        },
        {
          "text": "Rozohrej vo veľkom hrnci {oil.amount} {oil.name} na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj v ňom cibuľu s {garlic.amount} {garlic.name} 5 minút, kým cibuľa zozlatne.",
          "requires": ["onion:cut", "garlic:raw", "oil:raw", "velky_hrniec:free"],
          "produces": ["onion:cooked", "garlic:cooked", "oil:used", "velky_hrniec:occupied"]
        },
        {
          "text": "Pridaj {pork.name} do hrnca. Opekaj bravčové pliecko vo veľkom hrnci na strednom ohni 8 minút, kým bude mäso na povrchu zlatisté.",
          "requires": ["pork:cut", "onion:cooked", "oil:used", "velky_hrniec:occupied"],
          "produces": ["pork:browned"]
        },
        {
          "text": "Odstav hrniec z ohňa, prisyp {paprika.amount} {paprika.name} a premiešaj.",
          "requires": ["paprika:raw", "pork:browned", "velky_hrniec:occupied"],
          "produces": ["paprika:combined"]
        },
        {
          "text": "Pridaj papriku a paradajky do hrnca a prilej {pork.water} vody. Hrniec prikry a dus bravčové pliecko so zeleninou na miernom ohni 50 minút, kým mäso zmäkne a šťava začne bublať.",
          "requires": ["pork:browned", "paprika:combined", "pepper:cut", "tomato:cut", "velky_hrniec:occupied"],
          "produces": ["pork:cooked", "pepper:cooked", "tomato:cooked", "oil:cooked", "velky_hrniec:free"]
        },
        {
          "text": "Uvar {pasta.amount} {pasta.name} v malom hrnci v osolenej vode na miernom ohni 8 minút, kým cestoviny zmäknú, potom ich sceď.",
          "requires": ["pasta:raw", "maly_hrniec:free"],
          "produces": ["pasta:cooked", "maly_hrniec:free"]
        },
        {
          "text": "Dochuť perkelt soľou a čiernym korením.",
          "requires": ["pork:cooked", "pepper:cooked", "tomato:cooked", "oil:cooked"],
          "produces": []
        },
        {
          "text": "Podávaj bravčový perkelt s cestovinami a rozdeľ ho na {portions} porcií.",
          "requires": ["pork:cooked", "pasta:cooked", "onion:cooked", "garlic:cooked", "paprika:combined", "pepper:cooked", "tomato:cooked", "oil:cooked"],
          "produces": ["pork:served", "pasta:served", "onion:served", "garlic:served", "paprika:served", "pepper:served", "tomato:served", "oil:served"]
        }
      ],
