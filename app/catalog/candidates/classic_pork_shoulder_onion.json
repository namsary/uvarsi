      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {
          "text": "Prepláchni {rice.amount} {rice.name} studenou vodou.",
          "requires": ["rice:raw"],
          "produces": ["rice:rinsed"]
        },
        {
          "text": "Nalej {rice.water} vody do hrnca. Vsyp ryžu do hrnca. Prikry ho a var ryžu v malom hrnci na miernom ohni 15 minút, kým voda vsiakne a ryža zmäkne.",
          "requires": ["rice:rinsed", "maly_hrniec:free"],
          "produces": ["rice:cooked", "maly_hrniec:free"]
        },
        {
          "text": "Nakrájaj {pork.amount} {pork.name} na hrubšie plátky a {onion.amount} {onion.name} na polmesiačiky.",
          "requires": ["pork:raw", "onion:raw"],
          "produces": ["pork:cut", "onion:cut"]
        },
        {
          "text": "Rozohrej v hrnci s hrubým dnom {oil.amount} {oil.name} na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj v ňom cibuľu s {garlic.amount} {garlic.name} 6 minút, kým cibuľa zozlatne.",
          "requires": ["onion:cut", "garlic:raw", "oil:raw", "hrniec_s_hrubym_dnom:free"],
          "produces": ["onion:cooked", "garlic:cooked", "oil:used", "hrniec_s_hrubym_dnom:occupied"]
        },
        {
          "text": "Pridaj {pork.name} do hrnca. Opekaj bravčové pliecko v hrnci s hrubým dnom na strednom ohni 8 minút, kým bude mäso na povrchu zlatisté.",
          "requires": ["pork:cut", "onion:cooked", "oil:used", "hrniec_s_hrubym_dnom:occupied"],
          "produces": ["pork:browned"]
        },
        {
          "text": "Odstav hrniec z ohňa. Prisyp {paprika.amount} {paprika.name}. Hneď premiešaj.",
          "requires": ["paprika:raw", "pork:browned", "hrniec_s_hrubym_dnom:occupied"],
          "produces": ["paprika:combined"]
        },
        {
          "text": "Prilej {pork.water} vody do hrnca. Hrniec prikry a dus bravčové pliecko na miernom ohni 60 minút, kým bude mäkké a cibuľová šťava začne bublať.",
          "requires": ["pork:browned", "paprika:combined", "hrniec_s_hrubym_dnom:occupied"],
          "produces": ["pork:cooked", "oil:cooked", "hrniec_s_hrubym_dnom:free"]
        },
        {
          "text": "Dochuť mäso soľou a čiernym korením.",
          "requires": ["pork:cooked", "onion:cooked", "oil:cooked"],
          "produces": []
        },
        {
          "text": "Podávaj bravčové pliecko s cibuľovou šťavou a ryžou a rozdeľ jedlo na {portions} porcií.",
          "requires": ["pork:cooked", "rice:cooked", "onion:cooked", "garlic:cooked", "paprika:combined", "oil:cooked"],
          "produces": ["pork:served", "rice:served", "onion:served", "garlic:served", "paprika:served", "oil:served"]
        }
      ],
      "storage": {
        "refrigerated_days": 1,
        "instruction": "Mäso s ryžou rozdeľ do plytkých nádob a do jednej hodiny ho schlaď. V chladničke ho zjedz do 24 hodín; porcie na neskôr hneď zamraz. Ohrievaj iba raz, kým bude celé horúce."
      }
    }
