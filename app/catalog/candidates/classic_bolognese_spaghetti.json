      "instructions": [
        {"text": "Nakrájaj {onion.amount} {onion.name} nadrobno, {carrot.amount} {carrot.name} na malé kocky a {tomato.amount} {tomato.name} nahrubo. Nastrúhaj {cheese.amount} {cheese.name} najemno.", "requires": ["onion:raw", "carrot:raw", "tomato:raw", "cheese:raw"], "produces": ["onion:cut", "carrot:cut", "tomato:prepared", "cheese:grated"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v hrnci na omáčku a na strednom ohni opekaj cibuľu 5 minút, kým bude mäkká a zlatistá.", "requires": ["onion:cut", "oil:raw", "hrniec_na_omacku:free"], "produces": ["onion:cooked", "oil:used", "hrniec_na_omacku:occupied"]},
        {"text": "Pridaj {meat.amount} {meat.name} a mrkvu do hrnca. Pri väčšej dávke opekaj mäso po častiach, aby sa namiesto dusenia opieklo. Každú časť opekaj na strednom ohni asi 8 minút a varechou mäso rozdeľ na malé kúsky, kým bude miestami zlatisté.", "requires": ["meat:raw", "carrot:cut", "onion:cooked", "oil:used", "hrniec_na_omacku:occupied"], "produces": ["meat:browned", "carrot:cooked", "oil:cooked"]},
        {"text": "Pridaj paradajky a {garlic.amount} {garlic.name} do hrnca. Dus paradajky s mletým hovädzím mäsom na miernom ohni 25 minút, kým omáčka jemne bublá a je hustá.", "requires": ["tomato:prepared", "garlic:raw", "meat:browned", "carrot:cooked", "onion:cooked", "hrniec_na_omacku:occupied"], "produces": ["tomato:cooked", "garlic:cooked", "meat:cooked"]},
        {"text": "Uvar {pasta.amount} {pasta.name}; na tento recept zvoľ špagety a var ich v hrnci s osolenou vodou na strednom ohni asi 9 minút, kým budú mäkké, ale stále pevné.", "requires": ["pasta:raw", "hrniec_na_cestoviny:free"], "produces": ["pasta:cooked", "hrniec_na_cestoviny:free"]},
        {"text": "Sceď cestoviny cez sitko a nechaj ich krátko odkvapkať.", "requires": ["pasta:cooked", "sitko:free"], "produces": ["pasta:drained", "sitko:free"]},
        {"text": "Dochuť omáčku soľou a čiernym korením.", "requires": ["tomato:cooked", "meat:cooked", "carrot:cooked", "onion:cooked"], "produces": []},
        {"text": "Podávaj špagety s omáčkou a najemno nastrúhaným tvrdým syrom. Jedlo rozdeľ na {portions} porcií.", "requires": ["pasta:drained", "tomato:cooked", "garlic:cooked", "meat:cooked", "carrot:cooked", "onion:cooked", "oil:cooked", "cheese:grated", "hrniec_na_omacku:occupied"], "produces": ["pasta:served", "tomato:served", "garlic:served", "meat:served", "carrot:served", "onion:served", "oil:served", "cheese:served", "hrniec_na_omacku:free"]}
      ],
