      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {carrot.amount} {carrot.name} na tenké prúžky, {pepper.amount} {pepper.name}, {cabbage.amount} {cabbage.name} a {onion.amount} {onion.name} na tenké pásiky a {garlic.amount} {garlic.name} najemno.", "requires": ["carrot:raw", "pepper:raw", "cabbage:raw", "onion:raw", "garlic:raw"], "produces": ["carrot:cut", "pepper:cut", "cabbage:cut", "onion:cut", "garlic:cut"]},
        {"text": "Uvar {noodles.amount} {noodles.name} v hrnci vo vriacej osolenej vode na strednom ohni 4 minúty, kým zmäknú. Sceď vaječné rezance cez sitko a prepláchni ich studenou vodou, aby sa nezlepili.", "requires": ["noodles:raw", "hrniec:free", "sitko:free"], "produces": ["noodles:cooked", "hrniec:free", "sitko:free"]},
        {"text": "Rozšľahaj {egg.amount} {egg.name} so štipkou soli v miske.", "requires": ["egg:raw", "miska:free"], "produces": ["egg:beaten", "miska:occupied"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na silnom ohni 1 minútu, kým sa začne lesknúť. Opekaj cibuľu, mrkvu a kapustu za častého miešania 4 minúty, kým zmäknú, ale ostanú chrumkavé.", "requires": ["oil:raw", "onion:cut", "carrot:cut", "cabbage:cut", "velka_panvica:free"], "produces": ["oil:used", "onion:cooked", "carrot:cooked", "cabbage:cooked", "velka_panvica:occupied"]},
        {"text": "Pridaj papriku a cesnak do panvice. Opekaj papriku s cesnakom na silnom ohni 2 minúty, kým paprika zmäkne.", "requires": ["pepper:cut", "garlic:cut", "onion:cooked", "velka_panvica:occupied"], "produces": ["pepper:cooked", "garlic:cooked"]},
        {"text": "Vlej vajcia do panvice. Miešaj ich so zeleninou na strednom ohni 2 minúty, kým stuhnú na mäkkú praženicu.", "requires": ["egg:beaten", "pepper:cooked", "velka_panvica:occupied", "miska:occupied"], "produces": ["egg:cooked", "miska:free"]},
        {"text": "Pridaj vaječné rezance a {soy.amount} {soy.name} do panvice. Opekaj vaječné rezance so zeleninou za stáleho miešania na silnom ohni 3 minúty, kým vsiaknu omáčku a budú horúce.", "requires": ["noodles:cooked", "soy:raw", "egg:cooked", "velka_panvica:occupied"], "produces": ["noodles:fried", "soy:cooked"]},
        {"text": "Dochuť jedlo čiernym korením a podávaj ho hneď. Rozdeľ ho na {portions} porcií.", "requires": ["noodles:fried", "soy:cooked", "egg:cooked", "pepper:cooked", "carrot:cooked", "cabbage:cooked", "onion:cooked", "garlic:cooked", "oil:used", "velka_panvica:occupied"], "produces": ["noodles:served", "soy:served", "egg:served", "pepper:served", "carrot:served", "cabbage:served", "onion:served", "garlic:served", "oil:served", "velka_panvica:free"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Rezance rozdeľ do plytkých nádob, do 2 hodín ich odlož do chladničky a zjedz do 2 dní. Prehrej ich v panvici s lyžicou vody, kým budú celé horúce."}
