        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "15", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {pepper.amount} {pepper.name} {pepper.cut}, {tomato.amount} {tomato.name} {tomato.cut} a {onion.amount} {onion.name} {onion.cut}.", "requires": ["pepper:raw", "tomato:raw", "onion:raw"], "produces": ["pepper:cut", "tomato:cut", "onion:cut"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni. Pridaj cibuľu a opekaj ju 5 minút, kým zmäkne a začne zlatnúť.", "requires": ["oil:raw", "onion:cut", "panvica:free"], "produces": ["oil:used", "onion:cooked", "panvica:occupied"]},
        {"text": "Pridaj papriku do panvice a opekaj ju na strednom ohni 7 minút, kým mierne zmäkne.", "requires": ["pepper:cut", "onion:cooked", "panvica:occupied"], "produces": ["pepper:cooked"]},
        {"text": "Pridaj paradajky, panvicu prikry a zeleninu dus na miernom ohni 8 minút, kým paradajky pustia šťavu a paprika zmäkne.", "requires": ["tomato:cut", "pepper:cooked", "onion:cooked", "oil:used", "panvica:occupied"], "produces": ["tomato:cooked", "oil:cooked"]},
        {"text": "Rozšľahaj v mise {egg.amount} {egg.name} so soľou a čiernym korením.", "requires": ["egg:raw", "misa:free"], "produces": ["egg:beaten", "misa:occupied"]},
        {"text": "Vlej vajcia do panvice. Opekaj vajcia so zeleninou na miernom ohni 4 minúty, kým vajcia stuhnú, ale ostanú šťavnaté.", "requires": ["egg:beaten", "tomato:cooked", "pepper:cooked", "onion:cooked", "panvica:occupied", "misa:occupied"], "produces": ["egg:cooked", "misa:free"]},
        {"text": "Dochuť lečo soľou a čiernym korením a rozdeľ ho na {portions} porcií.", "requires": ["egg:cooked", "tomato:cooked", "pepper:cooked", "onion:cooked", "oil:cooked", "panvica:occupied"], "produces": ["egg:served", "tomato:served", "pepper:served", "onion:served", "oil:served", "panvica:free"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Lečo rozdeľ do plytkých nádob a odlož do chladničky najneskôr do 2 hodín. Zjedz ho do 2 dní."}
