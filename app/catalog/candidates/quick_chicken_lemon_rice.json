        {"key": "lemon", "role": "seasoning", "candidates": ["lemon"], "amount_per_adult": "0.25", "unit": "piece", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "butter", "role": "fat", "candidates": ["butter"], "amount_per_adult": "12", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "6", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "flour", "role": "starch", "candidates": ["wheat_flour"], "amount_per_adult": "5", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "30", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "parsley", "role": "seasoning", "candidates": ["parsley"], "amount_per_adult": "5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {rice.amount} {rice.name} v sitku pod studenou vodou.", "requires": ["rice:raw", "sitko:free"], "produces": ["rice:rinsed", "sitko:free"]},
        {"text": "Nalej {rice.water} vody do hrnca a pridaj štipku soli. Vsyp ryžu do hrnca a prikry ho. Var ryžu na miernom ohni 15 minút, kým voda vsiakne a ryža zmäkne. Päť minút pred koncom rozlož na ryžu {peas.amount} {peas.name} a znova prikry. Mrazený hrášok nerozmrazuj, para z ryže ho prehreje.", "requires": ["rice:rinsed", "peas:raw", "hrniec:free"], "produces": ["rice:cooked", "peas:cooked", "hrniec:free"]},
        {"text": "Nakrájaj {chicken.amount} {chicken.name} na tenšie plátky, {onion.amount} {onion.name} nadrobno, {garlic.amount} {garlic.name} najemno a {parsley.amount} {parsley.name} nadrobno. Umy {lemon.amount} {lemon.name}, nastrúhaj z neho kôru a vytlač šťavu.", "requires": ["chicken:raw", "onion:raw", "garlic:raw", "parsley:raw", "lemon:raw"], "produces": ["chicken:cut", "onion:cut", "garlic:cut", "parsley:cut", "lemon:prepared"]},
        {"text": "Prisyp {flour.amount} {flour.name} do misky. Kuracie plátky osoľ, okoreň a z oboch strán ich zľahka obaľ v múke.", "requires": ["flour:raw", "chicken:cut"], "produces": ["flour:coating", "chicken:floured"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Opeč kuracie prsia v panvici na strednom ohni 3 minúty z každej strany, kým budú zlatisté, a vyber ich na tanier. Pri väčšej dávke ich opekaj po častiach.", "requires": ["oil:raw", "chicken:floured", "flour:coating", "velka_panvica:free"], "produces": ["oil:used", "chicken:browned", "flour:browned", "velka_panvica:occupied"]},
        {"text": "Pridaj {butter.amount} {butter.name} a cibuľu do panvice. Opekaj cibuľu v panvici na miernom ohni 3 minúty, kým bude dosklovita. Pridaj cesnak do panvice a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["butter:raw", "onion:cut", "garlic:cut", "velka_panvica:occupied"], "produces": ["butter:used", "onion:cooked", "garlic:cooked"]},
        {"text": "Prilej {chicken.water} vody. Vytlač do panvice citrónovú šťavu, na každú porciu asi 1 lyžicu, a primiešaj polovicu kôry. Vráť kuracie prsia do panvice. Var kuracie prsia v citrónovej omáčke na miernom ohni 5 minút, kým omáčka zhustne, jemne bublá a mäso v strede nebude ružové.", "requires": ["chicken:browned", "lemon:prepared", "garlic:cooked", "velka_panvica:occupied"], "produces": ["chicken:cooked", "lemon:sauce", "flour:cooked"]},
        {"text": "Premiešaj ryžu s hráškom, zvyšnou citrónovou kôrou a petržlenovou vňaťou.", "requires": ["rice:cooked", "peas:cooked", "parsley:cut", "lemon:sauce"], "produces": ["rice:finished", "parsley:combined", "lemon:finished"]},
        {"text": "Dochuť omáčku soľou a čiernym korením. Rozdeľ ryžu s hráškom na {portions} porcií, navrch polož kuracie prsia, polej ich citrónovou omáčkou a podávaj.", "requires": ["chicken:cooked", "rice:finished", "peas:cooked", "lemon:finished", "butter:used", "oil:used", "flour:cooked", "onion:cooked", "garlic:cooked", "parsley:combined", "velka_panvica:occupied"], "produces": ["chicken:served", "rice:served", "peas:served", "lemon:served", "butter:served", "oil:served", "flour:served", "onion:served", "garlic:served", "parsley:served", "velka_panvica:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Ryžu a kuracie prsia s omáčkou rozdeľ do plytkých nádob a najneskôr do hodiny ich odlož do chladničky. Zjedz ich do 3 dní a prehrievaj s lyžicou vody, kým budú celé horúce."}
    }
