        {"key": "flour", "role": "starch", "candidates": ["wheat_flour"], "amount_per_adult": "12", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "milk", "role": "dairy", "candidates": ["milk"], "amount_per_adult": "160", "unit": "ml", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "cheese", "role": "dairy", "candidates": ["hard_cheese"], "amount_per_adult": "20", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno nastrúhaný"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Predhrej rúru na 190 °C.", "requires": ["rura:free"], "produces": ["rura:hot"]},
        {"text": "Nakrájaj {onion.amount} {onion.name} {onion.cut}, {carrot.amount} {carrot.name} {carrot.cut}, {garlic.amount} {garlic.name} {garlic.cut} a {tomato.amount} {tomato.name} {tomato.cut}. Nastrúhaj {cheese.amount} {cheese.name} najemno. Ako cestoviny použi lasagňové plátky, ktoré netreba predvárať.", "requires": ["onion:raw", "carrot:raw", "garlic:raw", "tomato:raw", "cheese:raw"], "produces": ["onion:cut", "carrot:cut", "garlic:cut", "tomato:cut", "cheese:grated"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj {turkey.amount} {turkey.name} 7 minút a vareškou ho rozdeľ na drobné kúsky, kým stratí ružovú farbu a bude miestami zlatisté. Pri väčšej dávke opekaj mäso po častiach.", "requires": ["oil:raw", "turkey:raw"], "produces": ["oil:used", "turkey:browned"]},
        {"text": "Pridaj cibuľu a mrkvu do veľkého hrnca. Opekaj cibuľu s mrkvou a mäsom na strednom ohni 5 minút, kým cibuľa zmäkne.", "requires": ["onion:cut", "carrot:cut", "turkey:browned"], "produces": ["onion:cooked", "carrot:cooked"]},
        {"text": "Vmiešaj {paste.amount} {paste.name} a {oregano.amount} {oregano.name}, pridaj paradajky a cesnak a prilej {pasta.water} vody. Var paradajky s mletým morčacím mäsom vo veľkom hrnci bez pokrievky na miernom ohni 15 minút, kým omáčka jemne bublá a paradajky sa rozpadnú. Omáčka má zostať riedka, cestoviny ju v rúre vsiaknu. Dochuť ju soľou a čiernym korením.", "requires": ["paste:raw", "oregano:raw", "tomato:cut", "garlic:cut", "onion:cooked", "carrot:cooked"], "produces": ["paste:sauce", "oregano:sauce", "tomato:sauce", "garlic:sauce", "turkey:sauce", "onion:sauce", "carrot:sauce"]},
        {"text": "Rozohrej {butter.amount} {butter.name} v hrnci na miernom ohni 1 minútu, kým sa roztopí a začne bublať. Vsyp {flour.amount} {flour.name} do hrnca. Opekaj hladkú pšeničnú múku s maslom na miernom ohni 1 minútu za stáleho miešania, kým začne bublať.", "requires": ["butter:raw", "flour:raw"], "produces": ["butter:roux", "flour:roux"]},
        {"text": "Prilej {milk.amount} {milk.name}. Prilievaj ho po troškách a stále miešaj metličkou, aby nevznikli hrudky. Var mlieko s múkou v hrnci na miernom ohni 5 minút za stáleho miešania, kým biela omáčka zhustne a začne bublať. Odstav hrniec a omáčku osoľ.", "requires": ["milk:raw", "butter:roux", "flour:roux"], "produces": ["milk:bechamel", "butter:bechamel", "flour:bechamel"]},
        {"text": "Rozdeľ {pasta.amount} {pasta.name} na tri rovnaké časti. Rozlož tretinu mletého morčacieho mäsa s paradajkami do pekáča, prikry ju jednou časťou cestovín a polej tretinou bielej omáčky. Vrstvy zopakuj, kým spotrebuješ omáčky aj cestoviny; navrchu má byť biela omáčka. Pri väčšej dávke rozdeľ vrstvy do dvoch pekáčov, aby lasagne neboli príliš vysoké.", "requires": ["turkey:sauce", "tomato:sauce", "paste:sauce", "oregano:sauce", "garlic:sauce", "onion:sauce", "carrot:sauce", "oil:used", "pasta:raw", "milk:bechamel", "butter:bechamel", "flour:bechamel"], "produces": ["turkey:layered", "tomato:layered", "paste:layered", "oregano:layered", "garlic:layered", "onion:layered", "carrot:layered", "oil:layered", "pasta:layered", "milk:layered", "butter:layered", "flour:layered"]},
        {"text": "Rozlož tvrdý syr po povrchu lasagní.", "requires": ["cheese:grated", "pasta:layered"], "produces": ["cheese:layered"]},
        {"text": "Peč cestoviny s mletým morčacím mäsom v pekáči pri 190 °C 40 minút, kým bude omáčka na okrajoch bublať, cestoviny zmäknú a syr bude zlatistý. Prvých 20 minút ich peč prikryté alobalom.", "requires": ["turkey:layered", "tomato:layered", "paste:layered", "oregano:layered", "garlic:layered", "onion:layered", "carrot:layered", "oil:layered", "pasta:layered", "milk:layered", "butter:layered", "flour:layered", "cheese:layered", "rura:hot"], "produces": ["turkey:baked", "tomato:baked", "paste:baked", "oregano:baked", "garlic:baked", "onion:baked", "carrot:baked", "oil:baked", "pasta:baked", "milk:baked", "butter:baked", "flour:baked", "cheese:baked"]},
        {"text": "Nechaj lasagne 10 minút odpočívať a rozdeľ ich na {portions} porcií.", "requires": ["turkey:baked", "tomato:baked", "paste:baked", "oregano:baked", "garlic:baked", "onion:baked", "carrot:baked", "oil:baked", "pasta:baked", "milk:baked", "butter:baked", "flour:baked", "cheese:baked"], "produces": ["turkey:served", "tomato:served", "paste:served", "oregano:served", "garlic:served", "onion:served", "carrot:served", "oil:served", "pasta:served", "milk:served", "butter:served", "flour:served", "cheese:served"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Vychladnuté lasagne rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní a porciu prehrej iba raz, prikrytú, kým bude celá horúca."}
