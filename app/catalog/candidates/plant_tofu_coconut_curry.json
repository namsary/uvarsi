        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "6", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {rice.amount} {rice.name} v sitku. Nalej {rice.water} vody do hrnca. Vsyp ryžu do hrnca. Osoľ ju.", "requires": ["rice:raw", "sitko:free", "hrniec:free"], "produces": ["rice:ready", "sitko:free", "hrniec:occupied"]},
        {"text": "Priveď ryžu v hrnci do varu, prikry ju a var na miernom ohni 15 minút, kým zmäkne a vsiakne vodu. Potom ju odstav.", "requires": ["rice:ready", "hrniec:occupied"], "produces": ["rice:cooked", "hrniec:free"]},
        {"text": "Osuš {tofu.amount} {tofu.name} a nakrájaj ho na kocky. Rozober {broccoli.amount} {broccoli.name} na malé ružičky, {carrot.amount} {carrot.name} nakrájaj na tenké kolieska, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno.", "requires": ["tofu:raw", "broccoli:raw", "carrot:raw", "onion:raw", "garlic:raw"], "produces": ["tofu:cut", "broccoli:cut", "carrot:cut", "onion:cut", "garlic:cut"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v hlbokej panvici. Tofu opekaj na strednom ohni 7 až 8 minút a priebežne ho obracaj, kým bude z viacerých strán zlatisté.", "requires": ["oil:raw", "tofu:cut", "hlboka_panvica_s_pokrievkou:free", "tanier:free"], "produces": ["oil:hot", "tofu:browned", "hlboka_panvica_s_pokrievkou:occupied"]},
        {"text": "Vyber tofu na tanier. Do panvice daj cibuľu, mrkvu a brokolicu a opekaj ich na strednom ohni 5 minút, kým trochu zmäknú.", "requires": ["tofu:browned", "oil:hot", "onion:cut", "carrot:cut", "broccoli:cut", "hlboka_panvica_s_pokrievkou:occupied", "tanier:free"], "produces": ["tofu:resting", "onion:softened", "carrot:softened", "broccoli:softened", "tanier:occupied"]},
        {"text": "Prisyp {curry.amount} {curry.name} do panvice. Pridaj cesnak do panvice. Miešaj 30 sekúnd, kým sa korenie rozvonia.", "requires": ["curry:raw", "garlic:cut", "onion:softened", "carrot:softened", "broccoli:softened", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["curry:toasted", "garlic:cooked"]},
        {"text": "Vráť tofu do panvice. Prilej {coconut.amount} {coconut.name} do panvice. Prikry ju a var kari na miernom ohni 6 minút, kým brokolica zmäkne, ale zostane pevná, a omáčka začne jemne bublať.", "requires": ["tofu:resting", "coconut:raw", "curry:toasted", "garlic:cooked", "onion:softened", "carrot:softened", "broccoli:softened", "hlboka_panvica_s_pokrievkou:occupied", "tanier:occupied"], "produces": ["tofu:cooked", "coconut:cooked", "curry:cooked", "garlic:finished", "onion:cooked", "carrot:cooked", "broccoli:cooked", "oil:cooked", "tanier:free"]},
        {"text": "Dochuť kari soľou a čiernym korením. Podávaj ho s ryžou a jedlo rozdeľ na {portions} porcií.", "requires": ["tofu:cooked", "coconut:cooked", "curry:cooked", "garlic:finished", "onion:cooked", "carrot:cooked", "broccoli:cooked", "oil:cooked", "rice:cooked", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["tofu:served", "coconut:served", "curry:served", "garlic:served", "onion:served", "carrot:served", "broccoli:served", "oil:served", "rice:served", "hlboka_panvica_s_pokrievkou:free"]}
      ],
      "storage": {"refrigerated_days": 1, "instruction": "Kari a ryžu rozdeľ do plytkých nádob a do jednej hodiny ich schlaď. V chladničke ich zjedz do 24 hodín; porcie na neskôr hneď zamraz. Ohrievaj iba raz, kým budú celé horúce."}
