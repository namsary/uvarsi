        {"key": "turkey", "role": "protein", "candidates": ["turkey_breast"], "amount_per_adult": "160", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na pásiky hrubé 1 centimeter"},
        {"key": "tortilla", "role": "starch", "candidates": ["tortilla"], "amount_per_adult": "2", "unit": "piece", "child_factor": "0.5", "required": true, "use": "main", "cut": null},
        {"key": "pepper", "role": "vegetable", "candidates": ["bell_pepper"], "amount_per_adult": "120", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na pásiky"},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "60", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na tenké pásiky"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "lettuce", "role": "vegetable", "candidates": ["lettuce"], "amount_per_adult": "40", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na pásiky"},
        {"key": "sour_cream", "role": "dairy", "candidates": ["sour_cream"], "amount_per_adult": "40", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "cumin", "role": "seasoning", "candidates": ["cumin"], "amount_per_adult": "1", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "paprika", "role": "seasoning", "candidates": ["paprika_powder"], "amount_per_adult": "2", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "lemon", "role": "seasoning", "candidates": ["lemon"], "amount_per_adult": "0.25", "unit": "piece", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na polovice"},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "10", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {turkey.amount} {turkey.name} {turkey.cut}, {pepper.amount} {pepper.name} {pepper.cut}, {onion.amount} {onion.name} {onion.cut} a {garlic.amount} {garlic.name} {garlic.cut}.", "requires": ["turkey:raw", "pepper:raw", "onion:raw", "garlic:raw"], "produces": ["turkey:cut", "pepper:cut", "onion:cut", "garlic:cut"]},
        {"text": "Nakrájaj {lettuce.amount} {lettuce.name} {lettuce.cut} a {lemon.amount} {lemon.name} {lemon.cut}. Premiešaj v miske {sour_cream.amount} {sour_cream.name} so štipkou soli..", "requires": ["lettuce:raw", "lemon:raw", "sour_cream:raw"], "produces": ["lettuce:cut", "lemon:cut", "sour_cream:seasoned"]},
        {"text": "Vlož morčacie prsia do misky, prisyp {cumin.amount} {cumin.name}, soľ a čierne korenie a premiešaj.", "requires": ["turkey:cut", "cumin:raw"], "produces": ["turkey:seasoned", "cumin:rub"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na silnom ohni 2 minúty, kým sa začne lesknúť. Opekaj morčacie prsia 4 minúty za stáleho miešania, kým budú na povrchu zlatisté a v strede nebudú ružové. Pri väčšej dávke opekaj mäso po častiach. Vyber ho na tanier.", "requires": ["oil:raw", "turkey:seasoned", "cumin:rub"], "produces": ["oil:used", "turkey:seared", "cumin:cooked"]},
        {"text": "Opekaj cibuľu s paprikou vo veľkej panvici na strednom ohni 5 minút, kým zmäknú, ale ostanú jemne chrumkavé. Pri väčšej dávke opekaj zeleninu po častiach. Pridaj cesnak a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["onion:cut", "pepper:cut", "garlic:cut", "oil:used"], "produces": ["onion:cooked", "pepper:cooked", "garlic:cooked"]},
        {"text": "Vráť morčacie prsia do panvice a premiešaj ich so zeleninou. Odstav panvicu z ohňa. Vmiešaj {paprika.amount} {paprika.name}. Zmes pokvapkaj šťavou vytlačenou z citróna a dochuť soľou.", "requires": ["turkey:seared", "onion:cooked", "pepper:cooked", "garlic:cooked", "paprika:raw", "lemon:cut"], "produces": ["turkey:filling", "onion:filling", "pepper:filling", "garlic:filling", "paprika:filling", "lemon:filling"]},
        {"text": "Zohrievaj {tortilla.amount} {tortilla.name} v malej suchej panvici na strednom ohni 30 sekúnd z každej strany, kým bude mäkká a pružná. Pri viacerých tortillách to opakuj s každou zvlášť.", "requires": ["tortilla:raw"], "produces": ["tortilla:warm"]},
        {"text": "Podávaj morčaciu zmes v tortillách s kyslou smotanou a rímskym šalátom; každý si tortillu naplní a zroluje sám. Jedlo rozdeľ na {portions} porcií.", "requires": ["turkey:filling", "onion:filling", "pepper:filling", "garlic:filling", "paprika:filling", "lemon:filling", "cumin:cooked", "oil:used", "tortilla:warm", "sour_cream:seasoned", "lettuce:cut"], "produces": ["turkey:served", "onion:served", "pepper:served", "garlic:served", "paprika:served", "lemon:served", "cumin:served", "oil:served", "tortilla:served", "sour_cream:served", "lettuce:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Morčaciu zmes ulož do uzavretej nádoby a najneskôr do 2 hodín ju odlož do chladničky; tortilly, šalát a kyslú smotanu skladuj zvlášť. Zjedz ju do 2 dní a zmes prehrej v panvici iba raz, kým je horúca."}
    }
  ],
