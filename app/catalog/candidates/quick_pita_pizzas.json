      "instructions": [
        {"text": "Predhrej rúru na 200 °C.", "requires": ["rura:free"], "produces": ["rura:hot"]},
        {"text": "Nakrájaj {ham.amount} {ham.name} na pásiky, {mushrooms.amount} {mushrooms.name} na tenké plátky, {pepper.amount} {pepper.name} na tenké pásiky, {mozzarella.amount} {mozzarella.name} na tenké plátky a {garlic.amount} {garlic.name} najemno.", "requires": ["ham:raw", "mushrooms:raw", "pepper:raw", "mozzarella:raw", "garlic:raw"], "produces": ["ham:cut", "mushrooms:cut", "pepper:cut", "mozzarella:cut", "garlic:cut"]},
        {"text": "Premiešaj v miske {paste.amount} {paste.name}, {paste.water} vody, {oil.amount} {oil.name}, cesnak, {oregano.amount} {oregano.name} a štipku soli.", "requires": ["paste:raw", "oil:raw", "garlic:cut", "oregano:raw"], "produces": ["paste:sauce", "oil:sauce", "garlic:sauce", "oregano:sauce"]},
        {"text": "Rozlož {pita.amount} {pita.name} na plech vystlaný papierom na pečenie. Každú placku natri tenkou vrstvou paradajkovej omáčky, navrch rozlož šunku, šampiňóny a papriku a prikry ich mozzarellou.", "requires": ["pita:raw", "paste:sauce", "ham:cut", "mushrooms:cut", "pepper:cut", "mozzarella:cut", "plech:free"], "produces": ["pita:topped", "paste:topped", "ham:topped", "mushrooms:topped", "pepper:topped", "mozzarella:topped", "plech:occupied"]},
        {"text": "Peč pita placky na plechu v rúre pri 200 °C 10 minút, kým sa mozzarella roztopí, začne bublať a okraje placiek budú chrumkavé.", "requires": ["pita:topped", "rura:hot", "plech:occupied"], "produces": ["pita:baked", "paste:baked", "ham:baked", "mushrooms:baked", "pepper:baked", "mozzarella:baked", "oil:baked", "garlic:baked", "oregano:baked"]},
        {"text": "Podávaj pizze teplé a rozdeľ ich na {portions} porcií.", "requires": ["pita:baked", "ham:baked", "mozzarella:baked", "paste:baked", "mushrooms:baked", "pepper:baked", "garlic:baked", "oregano:baked", "oil:baked", "plech:occupied"], "produces": ["pita:served", "ham:served", "mozzarella:served", "paste:served", "mushrooms:served", "pepper:served", "garlic:served", "oregano:served", "oil:served", "plech:free"]}
      ],
