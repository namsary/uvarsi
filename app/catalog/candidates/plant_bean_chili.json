      "instructions": [
        {"text": "Sceď a prepláchni {beans.amount} {beans.name}. Nakrájaj {tomato.amount} {tomato.name} a {pepper.amount} {pepper.name} na malé kúsky, {carrot.amount} {carrot.name} na malé kocky, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno.", "requires": ["beans:raw", "tomato:raw", "pepper:raw", "carrot:raw", "onion:raw", "garlic:raw", "sitko:free"], "produces": ["beans:drained", "tomato:cut", "pepper:cut", "carrot:cut", "onion:cut", "garlic:cut", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v hlbokej panvici. Cibuľu, mrkvu a papriku opekaj na strednom ohni 6 minút, kým trochu zmäknú.", "requires": ["oil:raw", "onion:cut", "carrot:cut", "pepper:cut", "hlboka_panvica_s_pokrievkou:free"], "produces": ["oil:hot", "onion:softened", "carrot:softened", "pepper:softened", "hlboka_panvica_s_pokrievkou:occupied"]},
        {"text": "Prisyp {cumin.amount} {cumin.name} a {chili.amount} {chili.name} do panvice. Pridaj cesnak do panvice. Miešaj 30 sekúnd, kým sa korenie rozvonia.", "requires": ["cumin:raw", "chili:raw", "garlic:cut", "oil:hot", "onion:softened", "carrot:softened", "pepper:softened", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["cumin:toasted", "chili:toasted", "garlic:cooked"]},
        {"text": "Vmiešaj paradajky, fazuľu a {tomato.water} vody do panvice. Prikry ju a var chilli na miernom ohni 15 minút, kým mrkva zmäkne a omáčka zhustne.", "requires": ["tomato:cut", "beans:drained", "cumin:toasted", "chili:toasted", "garlic:cooked", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["tomato:cooked", "beans:cooked", "onion:cooked", "carrot:cooked", "pepper:cooked", "garlic:finished", "cumin:cooked", "chili:cooked", "oil:cooked"]},
        {"text": "Dochuť chilli soľou a čiernym korením. Podávaj ho horúce a rozdeľ na {portions} porcií.", "requires": ["tomato:cooked", "beans:cooked", "onion:cooked", "carrot:cooked", "pepper:cooked", "garlic:finished", "cumin:cooked", "chili:cooked", "oil:cooked", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["tomato:served", "beans:served", "onion:served", "carrot:served", "pepper:served", "garlic:served", "cumin:served", "chili:served", "oil:served", "hlboka_panvica_s_pokrievkou:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Chilli rozdeľ do plytkých uzatvárateľných nádob a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 3 dní alebo jednotlivé porcie zamraz."}
