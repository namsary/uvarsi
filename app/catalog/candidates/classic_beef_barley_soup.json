      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {barley.amount} {barley.name} v sitku pod studenou vodou.", "requires": ["barley:raw", "sitko:free"], "produces": ["barley:rinsed", "sitko:free"]},
        {"text": "Nakrájaj {meat.amount} {meat.name} {meat.cut}, {carrot.amount} {carrot.name} {carrot.cut}, {potato.amount} {potato.name} {potato.cut} a {onion.amount} {onion.name} {onion.cut}.", "requires": ["meat:raw", "carrot:raw", "potato:raw", "onion:raw"], "produces": ["meat:cut", "carrot:cut", "potato:cut", "onion:cut"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci a opekaj na ňom cibuľu na strednom ohni 5 minút, kým bude mäkká a zlatistá.", "requires": ["onion:cut", "oil:raw", "velky_hrniec:free"], "produces": ["onion:cooked", "oil:used", "velky_hrniec:occupied"]},
        {"text": "Opekaj {meat.name} s cibuľou vo veľkom hrnci na strednom ohni 8 minút, kým bude mäso zo všetkých strán zlatisté.", "requires": ["meat:cut", "onion:cooked", "oil:used", "velky_hrniec:occupied"], "produces": ["meat:browned", "oil:cooked"]},
        {"text": "Pridaj {barley.name} a {garlic.amount} {garlic.name} do hrnca a nalej {barley.water} vody. Var krúpy s mäsom vo veľkom hrnci na miernom ohni 55 minút, kým mäso takmer zmäkne a krúpy napučia.", "requires": ["barley:rinsed", "garlic:raw", "meat:browned", "onion:cooked", "oil:cooked", "velky_hrniec:occupied"], "produces": ["barley:partly_cooked", "garlic:cooked", "meat:partly_cooked"]},
        {"text": "Pridaj {carrot.name} a {potato.name} do hrnca. Var mrkvu a zemiaky s mäsom a krúpami vo veľkom hrnci na miernom ohni ďalších 20 minút, kým budú mäso, krúpy aj zelenina mäkké.", "requires": ["barley:partly_cooked", "meat:partly_cooked", "carrot:cut", "potato:cut", "onion:cooked", "velky_hrniec:occupied"], "produces": ["barley:cooked", "meat:cooked", "carrot:cooked", "potato:cooked"]},
        {"text": "Dochuť polievku soľou a čiernym korením a rozdeľ ju na {portions} porcií.", "requires": ["barley:cooked", "garlic:cooked", "meat:cooked", "carrot:cooked", "potato:cooked", "onion:cooked", "oil:cooked", "velky_hrniec:occupied"], "produces": ["barley:served", "garlic:served", "meat:served", "carrot:served", "potato:served", "onion:served", "oil:served", "velky_hrniec:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Hovädziu polievku rozdeľ do plytkých nádob a najneskôr do 2 hodín ju odlož do chladničky. Zjedz ju do 3 dní."}
    }
