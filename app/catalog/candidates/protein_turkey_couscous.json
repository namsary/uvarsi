      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {pepper.amount} {pepper.name} a {zucchini.amount} {zucchini.name} na malé kúsky a {onion.amount} {onion.name} nadrobno. Priprav si {turkey.amount} {turkey.name}.", "requires": ["pepper:raw", "zucchini:raw", "onion:raw", "turkey:raw"], "produces": ["pepper:cut", "zucchini:cut", "onion:cut", "turkey:ready"]},
        {"text": "Nalej {couscous.water} vody do hrnca a priveď ju na silnom ohni do varu. Odstav hrniec, nasyp doň {couscous.amount} {couscous.name}, prikry ho a nechaj kuskus 8 minút napučať, kým zmäkne a vsiakne vodu.", "requires": ["couscous:raw", "hrniec:free"], "produces": ["couscous:hydrated", "hrniec:occupied"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj cibuľu 4 minúty, kým zosklovatie.", "requires": ["oil:raw", "onion:cut", "panvica:free"], "produces": ["oil:used", "onion:cooked", "panvica:occupied"]},
        {"text": "Pridaj mleté morčacie mäso do panvice, rozdeľ ho vareškou na menšie kúsky a opekaj na strednom ohni 7 minút, kým bude mäso zlatisté a nezostanú v ňom ružové miesta. Pri väčšej dávke mäso opeč po častiach.", "requires": ["turkey:ready", "onion:cooked", "oil:used", "panvica:occupied"], "produces": ["turkey:cooked"]},
        {"text": "Prisyp papriku a cuketu do panvice. Opekaj papriku s cuketou a morčacím mäsom na strednom ohni 6 minút, kým zelenina zmäkne, ale stále si zachová tvar.", "requires": ["pepper:cut", "zucchini:cut", "turkey:cooked", "panvica:occupied"], "produces": ["pepper:cooked", "zucchini:cooked"]},
        {"text": "Premiešaj kuskus vidličkou, aby bol sypký, a spoj ho v mise s morčacím mäsom a zeleninou. Jedlo osoľ, okoreň a rozdeľ na {portions} porcií.", "requires": ["couscous:hydrated", "turkey:cooked", "pepper:cooked", "zucchini:cooked", "onion:cooked", "oil:used", "misa:free", "hrniec:occupied", "panvica:occupied"], "produces": ["couscous:served", "turkey:served", "pepper:served", "zucchini:served", "onion:served", "oil:served", "misa:occupied", "hrniec:free", "panvica:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Hotové jedlo rozdeľ do plytkých uzatvárateľných nádob a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 3 dní a pred podávaním ho dôkladne zohrej."}
