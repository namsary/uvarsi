      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Predhrej rúru na 190 °C.", "requires": ["rura:free"], "produces": ["rura:hot"]},
        {"text": "Namoč {bread.amount} {bread.name} do {bread.water} vody na 5 minút, kým zmäkne.", "requires": ["bread:raw"], "produces": ["bread:soaked"]},
        {"text": "Nakrájaj {onion.amount} {onion.name} {onion.cut}.", "requires": ["onion:raw"], "produces": ["onion:cut"]},
        {"text": "Premiešaj v mise {meat.amount} {meat.name}, vytlačený chlieb, {egg.amount} {egg.name}, cibuľu, {garlic.amount} {garlic.name}, {paprika.amount} {paprika.name}, soľ a čierne korenie. Zmes mies rukami 2 minúty, kým bude držať pokope.", "requires": ["meat:raw", "bread:soaked", "egg:raw", "onion:cut", "garlic:raw", "paprika:raw", "misa:free"], "produces": ["meat:mixed", "bread:mixed", "egg:mixed", "onion:mixed", "garlic:mixed", "paprika:mixed", "misa:occupied"]},
        {"text": "Nalej {oil.amount} {oil.name} do pekáča. Olej rovnomerne rozotri po dne. Pri dávke nad 8 porcií rozdeľ zmes na dva rovnaké bochníky, použi dva pekáče a olej rozdeľ medzi ne. Pri menšej dávke vytvaruj zmes do jedného pevného bochníka a polož ho do pekáča.", "requires": ["meat:mixed", "bread:mixed", "egg:mixed", "onion:mixed", "garlic:mixed", "paprika:mixed", "oil:raw", "misa:occupied", "pekac:free"], "produces": ["meat:formed", "bread:formed", "egg:formed", "onion:formed", "garlic:formed", "paprika:formed", "oil:used", "misa:free", "pekac:occupied"]},
        {"text": "Peč sekanú z mletého hovädzieho mäsa v pripravenom pekáči alebo pekáčoch pri 190 °C 45 minút, kým bude povrch zlatistý a stred každého bochníka bez ružovej farby.", "requires": ["meat:formed", "bread:formed", "egg:formed", "onion:formed", "garlic:formed", "paprika:formed", "oil:used", "pekac:occupied", "rura:hot"], "produces": ["meat:cooked", "bread:cooked", "egg:cooked", "onion:cooked", "garlic:cooked", "paprika:cooked", "oil:cooked", "pekac:free"]},
        {"text": "Ošúp {potato.amount} {potato.name} počas pečenia sekanej a nakrájaj zemiaky na rovnaké kúsky.", "requires": ["potato:raw"], "produces": ["potato:cut"]},
        {"text": "Vlož zemiaky do hrnca. Dolej studenú vodu tak, aby boli ponorené, a vodu osoľ. Var zemiaky v hrnci na miernom ohni 18 minút, kým zmäknú, potom ich sceď.", "requires": ["potato:cut", "hrniec:free"], "produces": ["potato:cooked", "hrniec:occupied"]},
        {"text": "Prilej {milk.amount} {milk.name} do hrnca. Pridaj {butter.amount} {butter.name}. Zohrievaj zemiaky s mliekom a maslom v hrnci na miernom ohni 2 minúty, kým sa maslo roztopí a mlieko začne pariť. Potom všetko roztlač pučidlom na hladkú kašu.", "requires": ["milk:raw", "butter:raw", "potato:cooked", "hrniec:occupied"], "produces": ["milk:combined", "butter:combined", "potato:mashed", "hrniec:free"]},
        {"text": "Dochuť zemiakovú kašu soľou.", "requires": ["potato:mashed", "milk:combined"], "produces": []},
        {"text": "Nechaj sekanú 8 minút odpočívať, potom ju nakrájaj a podávaj so zemiakovou kašou. Rozdeľ jedlo na {portions} porcií.", "requires": ["meat:cooked", "bread:cooked", "egg:cooked", "onion:cooked", "garlic:cooked", "paprika:cooked", "oil:cooked", "potato:mashed", "milk:combined", "butter:combined"], "produces": ["meat:served", "bread:served", "egg:served", "onion:served", "garlic:served", "paprika:served", "oil:served", "potato:served", "milk:served", "butter:served"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Sekanú a zemiakovú kašu rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní."}
