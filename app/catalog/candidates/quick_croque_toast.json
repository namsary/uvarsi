      "active": true,
      "name_template": "Zapekané toasty so šunkou a syrom",
      "family": "quick_croque_toast",
      "method": "oven",
      "minutes": 30,
      "modes": ["standard"],
      "equipment": ["rúra", "plech", "malý hrniec", "metlička", "strúhadlo", "nôž", "doska na krájanie"],
      "slots": [
        {"key": "bread", "role": "starch", "candidates": ["bread"], "amount_per_adult": "100", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "nakrájaný na tenké krajce"},
        {"key": "ham", "role": "protein", "candidates": ["ham"], "amount_per_adult": "60", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": null},
        {"key": "cheese", "role": "dairy", "candidates": ["hard_cheese"], "amount_per_adult": "45", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "nastrúhaný"},
        {"key": "tomato", "role": "vegetable", "candidates": ["tomato"], "amount_per_adult": "100", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na plátky"},
        {"key": "butter", "role": "fat", "candidates": ["butter"], "amount_per_adult": "10", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "flour", "role": "starch", "candidates": ["wheat_flour"], "amount_per_adult": "8", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "milk", "role": "dairy", "candidates": ["milk"], "amount_per_adult": "80", "unit": "ml", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "mustard", "role": "seasoning", "candidates": ["mustard"], "amount_per_adult": "5", "unit": "g", "child_factor": "0.4", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["salt", "black_pepper"],
      "instructions": [
        {"text": "Predhrej rúru na 200 °C. Nakrájaj {tomato.amount} {tomato.name} na plátky a nastrúhaj {cheese.amount} {cheese.name}.", "requires": ["tomato:raw", "cheese:raw", "rura:free"], "produces": ["tomato:cut", "cheese:grated", "rura:hot"]},
        {"text": "Rozohrej {butter.amount} {butter.name} v malom hrnci na miernom ohni 1 minútu, kým sa roztopí a začne bublať. Vmiešaj {flour.amount} {flour.name}. Miešaj múku s maslom 1 minútu, kým sa spoja do hladkej zmesi.", "requires": ["butter:raw", "flour:raw", "maly_hrniec:free"], "produces": ["butter:cooked", "flour:cooked", "maly_hrniec:occupied"]},
        {"text": "Prilej {milk.amount} {milk.name} do hrnca. Var mlieko s múkou na miernom ohni 3 minúty a stále miešaj metličkou, kým omáčka zhustne a začne bublať. Dochuť ju čiernym korením a soľou až po ochutnaní, šunka a syr sú slané.", "requires": ["milk:raw", "butter:cooked", "flour:cooked", "maly_hrniec:occupied", "metlicka:free"], "produces": ["milk:sauce", "maly_hrniec:occupied", "metlicka:free"]},
        {"text": "Rozlož {bread.amount} {bread.name} {bread.cut} na plech vystlaný papierom na pečenie. Každý krajec natri tenko {mustard.amount} {mustard.name} a polož naň {ham.amount} {ham.name} a plátky paradajok.", "requires": ["bread:raw", "mustard:raw", "ham:raw", "tomato:cut", "plech:free"], "produces": ["bread:topped", "mustard:spread", "ham:topped", "tomato:topped", "plech:occupied"]},
        {"text": "Priprav toasty: na šunku a paradajky rozotri lyžicou omáčku z hrnca a navrch nasyp tvrdý syr.", "requires": ["milk:sauce", "cheese:grated", "bread:topped", "ham:topped", "maly_hrniec:occupied"], "produces": ["milk:topped", "butter:topped", "flour:topped", "cheese:topped", "maly_hrniec:free"]},
        {"text": "Peč biely chlieb so šunkou a syrom na plechu v rúre pri 200 °C 12 minút, kým syr zozlatne a okraje chleba budú chrumkavé.", "requires": ["bread:topped", "ham:topped", "cheese:topped", "milk:topped", "plech:occupied", "rura:hot"], "produces": ["bread:baked", "ham:baked", "cheese:baked", "milk:baked", "rura:free"]},
        {"text": "Podávaj toasty teplé a rozdeľ ich na {portions} porcií.", "requires": ["bread:baked", "ham:baked", "cheese:baked", "milk:baked", "butter:topped", "flour:topped", "tomato:topped", "mustard:spread", "plech:occupied"], "produces": ["bread:served", "ham:served", "cheese:served", "milk:served", "butter:served", "flour:served", "tomato:served", "mustard:served", "plech:free"]}
      ],
      "storage": {"refrigerated_days": 1, "instruction": "Toasty jedz hneď, kým sú chrumkavé. Zvyšok ulož do uzavretej nádoby, do 2 hodín ho odlož do chladničky, zjedz do druhého dňa a prehrej ho v rúre pri 180 °C."}
    }
  ],
