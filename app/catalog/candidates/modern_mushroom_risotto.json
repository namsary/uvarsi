      "slots": [
        {"key": "rice", "role": "starch", "candidates": ["rice"], "amount_per_adult": "85", "unit": "g", "child_factor": "0.55", "required": true, "use": "main", "cut": null, "water_ml_per_adult": "230"},
        {"key": "mushrooms", "role": "vegetable", "candidates": ["mushrooms"], "amount_per_adult": "180", "unit": "g", "child_factor": "0.65", "required": true, "use": "main", "cut": "na plátky"},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "50", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "butter", "role": "fat", "candidates": ["butter"], "amount_per_adult": "12", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "cheese", "role": "dairy", "candidates": ["hard_cheese"], "amount_per_adult": "30", "unit": "g", "child_factor": "0.55", "required": true, "use": "addition", "cut": "najemno nastrúhaný"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {mushrooms.amount} {mushrooms.name} na plátky, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno. Nastrúhaj {cheese.amount} {cheese.name} najemno.", "requires": ["mushrooms:raw", "onion:raw", "garlic:raw", "cheese:raw"], "produces": ["mushrooms:cut", "onion:cut", "garlic:cut", "cheese:grated"]},
        {"text": "Rozohrej {butter.amount} {butter.name} v hrnci na strednom ohni 2 minúty, kým sa roztopí a začne peniť. Pridaj šampiňóny a opekaj ich 7 minút, kým budú zlatisté. Odober ich na tanier.", "requires": ["butter:raw", "mushrooms:cut", "hrniec:free", "tanier:free"], "produces": ["butter:used", "mushrooms:browned", "hrniec:occupied", "tanier:occupied"]},
        {"text": "Pridaj cibuľu do hrnca. Opekaj cibuľu na strednom ohni 4 minúty, kým zmäkne. Vmiešaj cesnak do hrnca. Opekaj cesnak na strednom ohni ešte 1 minútu, kým sa rozvonia.", "requires": ["onion:cut", "garlic:cut", "butter:used", "hrniec:occupied"], "produces": ["onion:cooked", "garlic:cooked"]},
        {"text": "Prisyp {rice.amount} {rice.name} do hrnca. Opekaj ryžu na strednom ohni 2 minúty, kým sa začne lesknúť a zrnká budú na okrajoch priesvitné.", "requires": ["rice:raw", "onion:cooked", "garlic:cooked", "hrniec:occupied"], "produces": ["rice:toasted"]},
        {"text": "Rozdeľ {rice.water} vody na tri približne rovnaké dávky. Vodu prilievaj k ryži postupne, vždy až keď ryža predchádzajúcu dávku takmer vsiakne. Var ryžu v hrnci na miernom ohni približne 18 minút, kým bude rizoto krémové a zrnká mäkké s mierne pevným stredom.", "requires": ["rice:toasted", "hrniec:occupied"], "produces": ["rice:cooked"]},
        {"text": "Vráť šampiňóny z taniera do hrnca. Odstav hrniec z ohňa, prisyp tvrdý syr a premiešaj, kým sa syr rozpustí. Dochuť soľou a čiernym korením.", "requires": ["mushrooms:browned", "rice:cooked", "cheese:grated", "tanier:occupied", "hrniec:occupied"], "produces": ["mushrooms:combined", "cheese:melted", "butter:cooked", "tanier:free"]},
        {"text": "Podávaj rizoto hneď a rozdeľ ho na {portions} porcií.", "requires": ["rice:cooked", "mushrooms:combined", "onion:cooked", "garlic:cooked", "butter:cooked", "cheese:melted", "hrniec:occupied"], "produces": ["rice:served", "mushrooms:served", "onion:served", "garlic:served", "butter:served", "cheese:served", "hrniec:free"]}
      ],
      "storage": {"refrigerated_days": 1, "instruction": "Rizoto rozdeľ do plytkých nádob a do jednej hodiny ho schlaď. V chladničke ho zjedz do 24 hodín; porcie na neskôr hneď zamraz. Ohrievaj iba raz, kým bude celé horúce."}
    }
