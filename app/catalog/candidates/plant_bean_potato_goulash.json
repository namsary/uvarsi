    "pantry_basics": ["water", "salt", "black_pepper"],
    "instructions": [
      {"text": "Sceď a prepláchni {beans.amount} {beans.name}. Nakrájaj {potato.amount} {potato.name} na dvojcentimetrové kocky, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno.", "requires": ["beans:raw", "potato:raw", "onion:raw", "garlic:raw", "sitko:free"], "produces": ["beans:drained", "potato:cut", "onion:cut", "garlic:cut", "sitko:free"]},
      {"text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci. Cibuľu opekaj na strednom ohni 5 minút, kým zmäkne.", "requires": ["oil:raw", "onion:cut", "velky_hrniec_s_pokrievkou:free"], "produces": ["oil:hot", "onion:softened", "velky_hrniec_s_pokrievkou:occupied"]},
      {"text": "Odstav hrniec z ohňa. Prisyp {paprika.amount} {paprika.name} do hrnca. Pridaj cesnak do hrnca. Hneď premiešaj, aby korenie nezhorklo.", "requires": ["paprika:raw", "garlic:cut", "oil:hot", "onion:softened", "velky_hrniec_s_pokrievkou:occupied"], "produces": ["paprika:combined", "garlic:combined"]},
      {"text": "Vmiešaj {tomato.amount} {tomato.name}, zemiaky a {potato.water} vody. Osoľ, prikry a var zemiaky v hrnci na miernom ohni 18 až 20 minút, kým zmäknú.", "requires": ["tomato:raw", "potato:cut", "paprika:combined", "garlic:combined", "velky_hrniec_s_pokrievkou:occupied"], "produces": ["tomato:cooked", "potato:cooked", "onion:cooked", "garlic:cooked", "paprika:cooked", "oil:cooked"]},
      {"text": "Pridaj {beans.reference_name} a {marjoram.amount} {marjoram.name} do hrnca. Var {beans.reference_name} so zemiakmi v hrnci na miernom ohni bez pokrievky ďalších 8 minút, kým guláš začne jemne bublať a mierne zhustne. Dochuť soľou a čiernym korením.", "requires": ["beans:drained", "marjoram:raw", "tomato:cooked", "potato:cooked", "velky_hrniec_s_pokrievkou:occupied"], "produces": ["beans:cooked", "marjoram:cooked"]},
      {"text": "Podávaj guláš horúci a rozdeľ ho na {portions} porcií.", "requires": ["beans:cooked", "potato:cooked", "tomato:cooked", "onion:cooked", "garlic:cooked", "paprika:cooked", "marjoram:cooked", "oil:cooked", "velky_hrniec_s_pokrievkou:occupied"], "produces": ["beans:served", "potato:served", "tomato:served", "onion:served", "garlic:served", "paprika:served", "marjoram:served", "oil:served", "velky_hrniec_s_pokrievkou:free"]}
    ],
