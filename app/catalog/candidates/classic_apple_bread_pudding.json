      "instructions": [
        {
          "text": "Nakrájaj {bread.amount} {bread.name} na tenké plátky. Nahrubo nastrúhaj {apple.amount} {apple.name}.",
          "requires": [
            "bread:raw",
            "apple:raw",
            "noz:free",
            "doska_na_krajanie:free",
            "struhadlo:free"
          ],
          "produces": [
            "bread:sliced",
            "apple:grated",
            "noz:used",
            "doska_na_krajanie:used",
            "struhadlo:used"
          ]
        },
        {
          "text": "Rozšľahaj {milk.amount} {milk.name}, {egg.amount} {egg.name} a {sugar.amount} {sugar.name} v mise, kým sa cukor čiastočne rozpustí.",
          "requires": [
            "milk:raw",
            "egg:raw",
            "sugar:raw",
            "misa:free",
            "metlicka:free"
          ],
          "produces": [
            "milk:custard",
            "egg:custard",
            "sugar:dissolved",
            "misa:used",
            "metlicka:used"
          ]
        },
        {
          "text": "Predhrej rúru na 180 °C a zapekaciu misu vytri {butter.amount} {butter.name}.",
          "requires": [
            "butter:raw",
            "rura:free",
            "zapekacia_misa:free"
          ],
          "produces": [
            "butter:greased",
            "rura:heated",
            "zapekacia_misa:greased"
          ]
        },
        {
          "text": "Namoč polovicu chleba vo vaječnom mlieku a ulož ho na dno misy. Rozlož naň jablká. Pridaj {cinnamon.amount} {cinnamon.name}. Prikry zvyšným chlebom a prelej zvyškom mliečnej zmesi.",
          "requires": [
            "bread:sliced",
            "apple:grated",
            "cinnamon:raw",
            "milk:custard",
            "egg:custard",
            "sugar:dissolved",
            "butter:greased",
            "misa:used",
            "zapekacia_misa:greased"
          ],
          "produces": [
            "bread:layered",
