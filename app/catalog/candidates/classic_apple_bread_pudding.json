            "milk:absorbing",
            "egg:absorbing",
            "sugar:layered",
            "butter:layered",
            "zapekacia_misa:used"
          ]
        },
        {
          "text": "Nechaj žemľovku 10 minút postáť, aby chlieb vsiakol mliečnu zmes.",
          "requires": [
            "bread:layered",
            "milk:absorbing",
            "egg:absorbing",
            "zapekacia_misa:used"
