      "modes": ["standard", "high_protein"],
      "equipment": ["hrniec", "malý hrniec", "veľká miska", "miska", "nôž", "doska na krájanie"],
      "slots": [
        {"key": "fish", "role": "protein", "candidates": ["smoked_mackerel"], "amount_per_adult": "250", "unit": "g", "child_factor": "0.5", "required": true, "use": "main", "cut": null},
        {"key": "potato", "role": "starch", "candidates": ["potato"], "amount_per_adult": "220", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": null},
        {"key": "egg", "role": "protein", "candidates": ["egg"], "amount_per_adult": "1", "unit": "piece", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "pickle", "role": "vegetable", "candidates": ["pickled_cucumber"], "amount_per_adult": "1", "unit": "piece", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na malé kocky"},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "30", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "sour_cream", "role": "dairy", "candidates": ["sour_cream"], "amount_per_adult": "40", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "mustard", "role": "seasoning", "candidates": ["mustard"], "amount_per_adult": "6", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "5", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "lemon", "role": "seasoning", "candidates": ["lemon"], "amount_per_adult": "0.25", "unit": "piece", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na polovice"},
        {"key": "dill", "role": "seasoning", "candidates": ["dill"], "amount_per_adult": "4", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Vlož {potato.amount} {potato.name} do hrnca. Nechaj ich v šupke, dolej studenú vodu tak, aby boli ponorené, a vodu osoľ.", "requires": ["potato:raw"], "produces": ["potato:pot"]},
        {"text": "Var zemiaky v hrnci na miernom ohni 25 minút, kým zmäknú. Potom ich sceď a nechaj 15 minút vychladnúť.", "requires": ["potato:pot"], "produces": ["potato:cooked"]},
        {"text": "Vlož {egg.amount} {egg.name} do malého hrnca. Dolej studenú vodu do výšky asi 2 cm nad vajcia. Var vajcia v malom hrnci na strednom ohni 10 minút od začiatku varu, kým žĺtok úplne stuhne. Uvarené vajcia schlaď v studenej vode a ošúp.", "requires": ["egg:raw"], "produces": ["egg:cooked"]},
        {"text": "Priprav {fish.amount} {fish.name}: stiahni z nej kožu, odstráň hlavu a všetky kosti a mäso natrhaj na väčšie kúsky.", "requires": ["fish:raw"], "produces": ["fish:flaked"]},
        {"text": "Nakrájaj {onion.amount} {onion.name} {onion.cut}, {pickle.amount} {pickle.name} {pickle.cut}, {dill.amount} {dill.name} {dill.cut} a {lemon.amount} {lemon.name} {lemon.cut}.", "requires": ["onion:raw", "pickle:raw", "dill:raw", "lemon:raw"], "produces": ["onion:cut", "pickle:cut", "dill:cut", "lemon:cut"]},
        {"text": "Premiešaj v miske {sour_cream.amount} {sour_cream.name}, {mustard.amount} {mustard.name}, {oil.amount} {oil.name}, šťavu vytlačenú z citróna a čierne korenie na hladkú zálievku.", "requires": ["sour_cream:raw", "mustard:raw", "oil:raw", "lemon:cut"], "produces": ["sour_cream:dressing", "mustard:dressing", "oil:dressing", "lemon:dressing"]},
        {"text": "Ošúp vychladnuté zemiaky a nakrájaj ich na kocky. Premiešaj ich vo veľkej miske s cibuľou, uhorkami, kôprom a zálievkou.", "requires": ["potato:cooked", "onion:cut", "pickle:cut", "dill:cut", "sour_cream:dressing", "mustard:dressing", "oil:dressing", "lemon:dressing"], "produces": ["potato:salad", "onion:salad", "pickle:salad", "dill:salad", "sour_cream:salad", "mustard:salad", "oil:salad", "lemon:salad"]},
        {"text": "Pridaj makrelu do veľkej misky. Šalát jemne premiešaj, aby sa ryba nerozpadla na drobné kúsky, a nechaj ho 15 minút v chladničke odležať. Ochutnaj ho a až potom ho dosoľ, údená ryba je slaná.", "requires": ["fish:flaked", "potato:salad"], "produces": ["fish:salad"]},
        {"text": "Rozdeľ šalát na {portions} porcií, na každú porciu polož vajcia nakrájané na štvrtiny a podávaj.", "requires": ["fish:salad", "potato:salad", "onion:salad", "pickle:salad", "dill:salad", "sour_cream:salad", "mustard:salad", "oil:salad", "lemon:salad", "egg:cooked"], "produces": ["fish:served", "potato:served", "onion:served", "pickle:served", "dill:served", "sour_cream:served", "mustard:served", "oil:served", "lemon:served", "egg:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Šalát ulož do uzavretej nádoby a hneď ho odlož do chladničky. Zjedz ho do 2 dní a podávaj ho studený; vajcia pridávaj až na tanier."}
    }
  ],
