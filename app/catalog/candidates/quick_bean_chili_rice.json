      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {rice.amount} {rice.name} v sitku pod studenou vodou.", "requires": ["rice:raw", "sitko:free"], "produces": ["rice:rinsed", "sitko:free"]},
        {"text": "Nalej {rice.water} vody do hrnca a pridaj štipku soli. Priveď vodu v hrnci na silnom ohni do varu, kým začne bublať. Vsyp ryžu do hrnca a prikry ho. Var ryžu na miernom ohni 15 minút, kým voda vsiakne a ryža zmäkne. Potom ju nechaj 5 minút prikrytú postáť.", "requires": ["rice:rinsed", "hrniec:free"], "produces": ["rice:cooked", "hrniec:occupied"]},
        {"text": "Nakrájaj {pepper.amount} {pepper.name} na kocky, {tomato.amount} {tomato.name} nahrubo, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno.", "requires": ["pepper:raw", "tomato:raw", "onion:raw", "garlic:raw"], "produces": ["pepper:cut", "tomato:cut", "onion:cut", "garlic:cut"]},
        {"text": "Sceď {beans.amount} {beans.name} a {corn.amount} {corn.name} cez sitko a prepláchni ich studenou vodou.", "requires": ["beans:raw", "corn:raw", "sitko:free"], "produces": ["beans:drained", "corn:drained", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci na strednom ohni 1 minútu, kým sa začne lesknúť. Opekaj cibuľu a papriku 5 minút, kým zmäknú. Pridaj cesnak do hrnca a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["oil:raw", "onion:cut", "pepper:cut", "garlic:cut", "velky_hrniec:free"], "produces": ["oil:used", "onion:cooked", "pepper:cooked", "garlic:cooked", "velky_hrniec:occupied"]},
        {"text": "Odstav hrniec z ohňa a vmiešaj {cumin.amount} {cumin.name}, {chili.amount} {chili.name}, {paprika.amount} {paprika.name} a {paste.amount} {paste.name}.", "requires": ["cumin:raw", "chili:raw", "paprika:raw", "paste:raw", "pepper:cooked", "velky_hrniec:occupied"], "produces": ["cumin:mixed", "chili:mixed", "paprika:mixed", "paste:mixed"]},
        {"text": "Pridaj paradajky, fazuľu a kukuricu do hrnca. Prilej {tomato.water} vody. Var červenú fazuľu s paradajkami vo veľkom hrnci na miernom ohni 12 minút, kým paradajky zmäknú a omáčka zhustne.", "requires": ["tomato:cut", "beans:drained", "corn:drained", "paste:mixed", "velky_hrniec:occupied"], "produces": ["tomato:cooked", "beans:cooked", "corn:cooked", "paste:cooked", "cumin:cooked", "chili:cooked", "paprika:cooked"]},
        {"text": "Dochuť chilli soľou a čiernym korením. Podávaj ho s ryžou a rozdeľ jedlo na {portions} porcií.", "requires": ["beans:cooked", "rice:cooked", "tomato:cooked", "corn:cooked", "paste:cooked", "cumin:cooked", "chili:cooked", "paprika:cooked", "pepper:cooked", "onion:cooked", "garlic:cooked", "oil:used", "hrniec:occupied", "velky_hrniec:occupied"], "produces": ["beans:served", "rice:served", "tomato:served", "corn:served", "paste:served", "cumin:served", "chili:served", "paprika:served", "pepper:served", "onion:served", "garlic:served", "oil:served", "hrniec:free", "velky_hrniec:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Ryžu a chilli rozdeľ do plytkých nádob, do hodiny ich schlaď a odlož do chladničky. Zjedz ich do 3 dní a prehrievaj s lyžicou vody, kým budú celé horúce."}
