      "pantry_basics": ["salt", "black_pepper"],
      "instructions": [
        {"text": "Predhrej rúru na 200 °C.", "requires": ["rura:free"], "produces": ["rura:hot"]},
        {"text": "Nakrájaj {chicken.amount} {chicken.name} pozdĺžne na tenšie plátky, {potato.amount} {potato.name} na menšie kocky, {zucchini.amount} {zucchini.name} na hrubšie polkolieska, {tomato.amount} {tomato.name} na mesiačiky a {pepper.amount} {pepper.name} na väčšie kúsky. {onion.amount} {onion.name} nakrájaj na mesiačiky a {garlic.amount} {garlic.name} najemno.", "requires": ["chicken:raw", "potato:raw", "zucchini:raw", "tomato:raw", "pepper:raw", "onion:raw", "garlic:raw"], "produces": ["chicken:cut", "potato:cut", "zucchini:cut", "tomato:cut", "pepper:cut", "onion:cut", "garlic:cut"]},
        {"text": "Premiešaj v miske {pesto.amount} {pesto.name}, {oregano.amount} {oregano.name}, cesnak, {oil.amount} {oil.name}, soľ a čierne korenie. Kuracie prsia v zmesi dôkladne obaľ.", "requires": ["pesto:raw", "oregano:raw", "garlic:cut", "oil:raw", "chicken:cut", "miska:free"], "produces": ["pesto:seasoned", "oregano:seasoned", "garlic:seasoned", "oil:seasoned", "chicken:seasoned", "miska:occupied"]},
        {"text": "Rozlož zemiaky, cuketu, paradajky, papriku a cibuľu na plech. Pri väčšej dávke rozdeľ zeleninu do dvoch plechov, aby neležala v hrubej vrstve.", "requires": ["potato:cut", "zucchini:cut", "tomato:cut", "pepper:cut", "onion:cut", "plech:free"], "produces": ["potato:arranged", "zucchini:arranged", "tomato:arranged", "pepper:arranged", "onion:arranged", "plech:occupied"]},
        {"text": "Peč zemiaky s cuketou na plechu pri 200 °C 15 minút, kým zemiaky začnú mäknúť a okraje zeleniny budú miestami zlatisté.", "requires": ["potato:arranged", "zucchini:arranged", "tomato:arranged", "pepper:arranged", "onion:arranged", "plech:occupied", "rura:hot"], "produces": ["potato:part_cooked", "zucchini:part_cooked", "tomato:part_cooked", "pepper:part_cooked", "onion:part_cooked"]},
        {"text": "Rozlož kuracie prsia medzi zeleninu. Zvyšok zmesi z misky rozotri po mäse.", "requires": ["chicken:seasoned", "pesto:seasoned", "oregano:seasoned", "garlic:seasoned", "oil:seasoned", "miska:occupied", "plech:occupied"], "produces": ["chicken:arranged", "pesto:arranged", "oregano:arranged", "garlic:arranged", "oil:arranged", "miska:free"]},
        {"text": "Peč kuracie prsia so zeleninou na plechu pri 200 °C 25 minút, kým budú zemiaky mäkké, mäso zlatisté a po narezaní v strede už nebude ružové.", "requires": ["chicken:arranged", "potato:part_cooked", "zucchini:part_cooked", "tomato:part_cooked", "pepper:part_cooked", "onion:part_cooked", "pesto:arranged", "oregano:arranged", "garlic:arranged", "oil:arranged", "plech:occupied", "rura:hot"], "produces": ["chicken:cooked", "potato:cooked", "zucchini:cooked", "tomato:cooked", "pepper:cooked", "onion:cooked", "pesto:cooked", "oregano:cooked", "garlic:cooked", "oil:cooked"]},
        {"text": "Nechaj jedlo 5 minút odpočívať a rozdeľ ho na {portions} porcií.", "requires": ["chicken:cooked", "potato:cooked", "zucchini:cooked", "tomato:cooked", "pepper:cooked", "onion:cooked", "pesto:cooked", "oregano:cooked", "garlic:cooked", "oil:cooked", "plech:occupied"], "produces": ["chicken:served", "potato:served", "zucchini:served", "tomato:served", "pepper:served", "onion:served", "pesto:served", "oregano:served", "garlic:served", "oil:served", "plech:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Jedlo rozdeľ do plytkých nádob a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 3 dní."}
