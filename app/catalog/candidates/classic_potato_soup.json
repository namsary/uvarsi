      "instructions": [
        {
          "text": "Ošúp {potato.amount} {potato.name} a nakrájaj ich na 2 cm kocky. Nakrájaj {carrot.amount} {carrot.name} na tenké kolieska a {onion.amount} {onion.name} najemno. Rozdrv {garlic.amount} {garlic.name} plochou stranou noža.",
          "requires": [
            "potato:raw",
            "carrot:raw",
            "onion:raw",
            "garlic:raw",
            "noz:free",
            "doska_na_krajanie:free"
          ],
          "produces": [
            "potato:cubed",
            "carrot:sliced",
            "onion:chopped",
            "garlic:crushed",
            "noz:used",
            "doska_na_krajanie:used"
          ]
        },
        {
          "text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci na strednom ohni 2 minúty, kým sa začne lesknúť.",
          "requires": [
            "oil:raw",
            "velky_hrniec:free"
          ],
          "produces": [
            "oil:heated",
            "velky_hrniec:used"
          ]
        },
        {
          "text": "Opekaj cibuľu a mrkvu vo veľkom hrnci na strednom ohni 6 minút, kým cibuľa zmäkne.",
          "requires": [
            "onion:chopped",
            "carrot:sliced",
            "oil:heated",
            "velky_hrniec:used"
          ],
          "produces": [
            "onion:softened",
            "carrot:softened",
            "oil:used"
          ]
        },
        {
          "text": "Odstav hrniec z ohňa. Prisyp {paprika.amount} {paprika.name} a premiešaj ju 30 sekúnd.",
          "requires": [
            "onion:softened",
            "paprika:raw",
            "velky_hrniec:used"
          ],
          "produces": [
            "onion:seasoned",
            "paprika:bloomed"
          ]
        },
        {
          "text": "Pridaj zemiaky a cesnak do hrnca. Prilej {potato.water} vody a obsah hrnca priveď do varu. Potom var zemiaky vo veľkom hrnci na miernom ohni 18 minút, kým zmäknú.",
          "requires": [
            "potato:cubed",
            "garlic:crushed",
            "onion:seasoned",
            "carrot:softened",
            "oil:used",
            "paprika:bloomed",
            "velky_hrniec:used"
          ],
          "produces": [
            "potato:cooked",
            "garlic:cooked",
            "onion:cooked",
            "carrot:cooked",
            "oil:cooked",
            "paprika:cooked"
          ]
        },
        {
          "text": "Prilej {milk.amount} {milk.name} do hrnca. Prisyp {salt.amount} {salt.name} a {pepper.amount} {pepper.name}. Prehrievaj zemiaky v polievke vo veľkom hrnci na miernom ohni 5 minút, kým polievka začne pariť.",
          "requires": [
            "potato:cooked",
            "milk:raw",
            "salt:raw",
            "pepper:raw",
            "velky_hrniec:used"
          ],
          "produces": [
            "potato:hot",
            "milk:heated",
            "salt:dissolved",
            "pepper:dissolved"
          ]
        },
        {
          "text": "Podávaj zemiakovú polievku horúcu s {bread.amount} {bread.name}, keď sú zemiaky mäkké a vývar mliečne jemný.",
          "requires": [
            "potato:hot",
            "bread:raw",
            "carrot:cooked",
            "onion:cooked",
            "garlic:cooked",
            "milk:heated",
            "oil:cooked",
            "paprika:cooked",
            "salt:dissolved",
            "pepper:dissolved"
          ],
          "produces": [
            "potato:served",
            "bread:served",
            "carrot:served",
            "onion:served",
            "garlic:served",
            "milk:served",
            "oil:served",
            "paprika:served",
            "salt:served",
            "pepper:served"
          ]
        }
      ],
