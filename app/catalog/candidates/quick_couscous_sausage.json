      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {sausage.amount} {sausage.name} na polkolieska, {pepper.amount} {pepper.name} a {zucchini.amount} {zucchini.name} na kocky, {tomato.amount} {tomato.name} nahrubo, {onion.amount} {onion.name} nadrobno, {garlic.amount} {garlic.name} najemno a {parsley.amount} {parsley.name} nadrobno.", "requires": ["sausage:raw", "pepper:raw", "zucchini:raw", "tomato:raw", "onion:raw", "garlic:raw", "parsley:raw"], "produces": ["sausage:cut", "pepper:cut", "zucchini:cut", "tomato:cut", "onion:cut", "garlic:cut", "parsley:cut"]},
        {"text": "Nalej {couscous.water} vody do hrnca a pridaj štipku soli. Priveď vodu v hrnci na silnom ohni do varu, kým začne bublať. Vsyp {couscous.amount} {couscous.name} do hrnca, odstav ho z ohňa a prikry. Nechaj kuskus 5 minút napučať, kým vsiakne všetku vodu, a potom ho prehrab vidličkou.", "requires": ["couscous:raw", "hrniec_s_pokrievkou:free"], "produces": ["couscous:cooked", "hrniec_s_pokrievkou:occupied"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v širokom hrnci na strednom ohni 1 minútu, kým sa začne lesknúť. Opekaj údenú klobásu 4 minúty, kým pustí tuk a bude zlatistá.", "requires": ["oil:raw", "sausage:cut", "siroky_hrniec:free"], "produces": ["oil:used", "sausage:browned", "siroky_hrniec:occupied"]},
        {"text": "Pridaj cibuľu, papriku a cuketu do hrnca. Opekaj papriku s cuketou na strednom ohni 6 minút, kým zmäknú. Pridaj cesnak do hrnca a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["onion:cut", "pepper:cut", "zucchini:cut", "garlic:cut", "sausage:browned", "siroky_hrniec:occupied"], "produces": ["onion:cooked", "pepper:cooked", "zucchini:cooked", "garlic:cooked"]},
        {"text": "Odstav hrniec z ohňa a vmiešaj {paprika.amount} {paprika.name} a {paste.amount} {paste.name}.", "requires": ["paprika:raw", "paste:raw", "pepper:cooked", "siroky_hrniec:occupied"], "produces": ["paprika:mixed", "paste:mixed"]},
        {"text": "Pridaj paradajky do hrnca a prilej {tomato.water} vody. Var paradajky s klobásou v širokom hrnci na miernom ohni 5 minút, kým paradajky zmäknú a vznikne hustá šťava.", "requires": ["tomato:cut", "paprika:mixed", "paste:mixed", "siroky_hrniec:occupied"], "produces": ["tomato:cooked", "paprika:cooked", "paste:cooked", "sausage:cooked"]},
        {"text": "Vmiešaj kuskus do hrnca. Zohrievaj kuskus so zeleninou a klobásou na miernom ohni 2 minúty, kým vsiakne šťavu a bude horúci.", "requires": ["couscous:cooked", "tomato:cooked", "sausage:cooked", "siroky_hrniec:occupied", "hrniec_s_pokrievkou:occupied"], "produces": ["couscous:combined", "hrniec_s_pokrievkou:free"]},
        {"text": "Dochuť jedlo soľou až po ochutnaní, klobása je slaná. Rozdeľ ho na {portions} porcií, navrch nasyp petržlenovú vňať a podávaj.", "requires": ["couscous:combined", "sausage:cooked", "pepper:cooked", "zucchini:cooked", "tomato:cooked", "paste:cooked", "onion:cooked", "garlic:cooked", "paprika:cooked", "parsley:cut", "oil:used", "siroky_hrniec:occupied"], "produces": ["couscous:served", "sausage:served", "pepper:served", "zucchini:served", "tomato:served", "paste:served", "onion:served", "garlic:served", "paprika:served", "parsley:served", "oil:served", "siroky_hrniec:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Kuskus rozdeľ do plytkých nádob, do 2 hodín ho odlož do chladničky a zjedz do 3 dní. Pri ohrievaní pridaj lyžicu vody, aby nebol suchý."}
