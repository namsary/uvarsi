      "pantry_basics": ["salt", "black_pepper"],
      "instructions": [
        {"text": "Sceď {tuna.amount} {tuna.name}. Nakrájaj {tomato.amount} {tomato.name} na malé kocky a {onion.amount} {onion.name} najemno. Nahrubo nastrúhaj {cheese.amount} {cheese.name}.", "requires": ["tuna:raw", "tomato:raw", "onion:raw", "cheese:raw", "sitko:free"], "produces": ["tuna:drained", "tomato:cut", "onion:cut", "cheese:grated", "sitko:free"]},
        {"text": "Premiešaj tuniaka, paradajku a cibuľu s {yogurt.amount} {yogurt.name} v mise. Zmes jemne osoľ a okoreň.", "requires": ["tuna:drained", "tomato:cut", "onion:cut", "yogurt:raw", "misa:free"], "produces": ["tuna:mixed", "tomato:mixed", "onion:mixed", "yogurt:mixed", "misa:occupied"]},
        {"text": "Rozlož {tortilla.amount} {tortilla.name}. Na polovicu každej daj tuniakovú náplň a syr, nechaj voľný okraj a tortilly prelož napoly.", "requires": ["tortilla:raw", "tuna:mixed", "tomato:mixed", "onion:mixed", "yogurt:mixed", "cheese:grated", "misa:occupied"], "produces": ["tortilla:filled", "tuna:filled", "tomato:filled", "onion:filled", "yogurt:filled", "cheese:filled", "misa:free"]},
        {"text": "Opekaj {tortilla.name} nasucho v panvici na strednom ohni 2 až 3 minúty z každej strany, kým bude zlatistá a syr sa roztopí. Pri väčšej dávke priprav tortilly po častiach.", "requires": ["tortilla:filled", "tuna:filled", "tomato:filled", "onion:filled", "yogurt:filled", "cheese:filled", "panvica:free"], "produces": ["tortilla:cooked", "tuna:hot", "tomato:hot", "onion:hot", "yogurt:hot", "cheese:melted", "panvica:free"]},
        {"text": "Podávaj tuniakovo-syrové tortilly horúce, prekrojené a rozdelené na {portions} porcií.", "requires": ["tortilla:cooked", "tuna:hot", "tomato:hot", "onion:hot", "yogurt:hot", "cheese:melted", "panvica:free"], "produces": ["tortilla:served", "tuna:served", "tomato:served", "onion:served", "yogurt:served", "cheese:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Nevyužitú náplň odlož do plytkej uzatvárateľnej nádoby najneskôr do 2 hodín a uchovaj ju v chladničke najviac 2 dni. Tortilly napĺňaj a opekaj až tesne pred podávaním."}
