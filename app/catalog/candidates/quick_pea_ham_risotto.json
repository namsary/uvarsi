      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {ham.amount} {ham.name} na malé kocky, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno. Priprav {peas.amount} {peas.name} a najemno nastrúhaj {cheese.amount} {cheese.name}.", "requires": ["ham:raw", "onion:raw", "garlic:raw", "peas:raw", "cheese:raw"], "produces": ["ham:cut", "onion:cut", "garlic:cut", "cheese:grated"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v širokom hrnci. Cibuľu opekaj na strednom ohni 4 minúty, kým zmäkne.", "requires": ["oil:raw", "onion:cut", "siroky_hrniec_s_pokrievkou:free"], "produces": ["oil:hot", "onion:softened", "siroky_hrniec_s_pokrievkou:occupied"]},
        {"text": "Pridaj cesnak a {rice.amount} {rice.name}. Miešaj 1 minútu, kým budú zrnká na okrajoch priesvitné.", "requires": ["garlic:cut", "rice:raw", "oil:hot", "onion:softened", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["garlic:toasted", "rice:toasted"]},
        {"text": "Prilej {rice.water} vody do hrnca. Priveď vodu s ryžou v hrnci na strednom ohni do varu. Prikry hrniec a var ryžu na miernom ohni 15 minút, kým bude takmer mäkká; počas varenia ju dvakrát premiešaj.", "requires": ["rice:toasted", "garlic:toasted", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["rice:partly_cooked", "onion:cooked", "garlic:cooked", "oil:cooked"]},
        {"text": "Vmiešaj hrášok a {ham.name} do hrnca. Var ryžu, hrášok a šunku v hrnci na miernom ohni bez pokrievky ďalšie 4 minúty, kým ryža zmäkne, hrášok bude jasne zelený a šunka horúca.", "requires": ["peas:raw", "ham:cut", "rice:partly_cooked", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["rice:cooked", "peas:cooked", "ham:cooked"]},
        {"text": "Odstav hrniec z ohňa, vmiešaj {cheese.name} a čierne korenie. Nechaj rizoto 2 minúty prikryté, kým sa syr roztopí a rizoto bude krémové.", "requires": ["cheese:grated", "rice:cooked", "peas:cooked", "ham:cooked", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["cheese:melted"]},
        {"text": "Podávaj hráškové rizoto so šunkou horúce a rozdeľ ho na {portions} porcií.", "requires": ["rice:cooked", "ham:cooked", "peas:cooked", "cheese:melted", "onion:cooked", "garlic:cooked", "oil:cooked", "siroky_hrniec_s_pokrievkou:occupied"], "produces": ["rice:served", "ham:served", "peas:served", "cheese:served", "onion:served", "garlic:served", "oil:served", "siroky_hrniec_s_pokrievkou:free"]}
      ],
      "storage": {"refrigerated_days": 1, "instruction": "Rizoto rozprestri do plytkej nádoby, do jednej hodiny ho schlaď a odlož do chladničky. Zjedz ho do 24 hodín a zohrej ho iba raz, kým bude celé horúce."}
