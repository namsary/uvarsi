        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "90", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "pepper", "role": "vegetable", "candidates": ["bell_pepper"], "amount_per_adult": "60", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": "na rezance"},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "12", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "paprika", "role": "seasoning", "candidates": ["paprika_powder"], "amount_per_adult": "5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "paste", "role": "vegetable", "candidates": ["tomato_paste"], "amount_per_adult": "10", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "flour", "role": "starch", "candidates": ["wheat_flour"], "amount_per_adult": "6", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {turkey.amount} {turkey.name} {turkey.cut}, {onion.amount} {onion.name} {onion.cut}, {garlic.amount} {garlic.name} {garlic.cut} a {pepper.amount} {pepper.name} {pepper.cut}.", "requires": ["turkey:raw", "onion:raw", "garlic:raw", "pepper:raw"], "produces": ["turkey:cut", "onion:cut", "garlic:cut", "pepper:cut"]},
        {"text": "Nalej {oil.amount} {oil.name} do veľkého hrnca. Opekaj cibuľu vo veľkom hrnci na strednom ohni 8 minút, kým bude zlatistá a mäkká. Pridaj cesnak a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["oil:raw", "onion:cut", "garlic:cut"], "produces": ["oil:used", "onion:cooked", "garlic:cooked"]},
        {"text": "Odstav hrniec z ohňa. Vmiešaj {paprika.amount} {paprika.name} a {paste.amount} {paste.name}.", "requires": ["paprika:raw", "paste:raw"], "produces": ["paprika:base", "paste:base"]},
        {"text": "Pridaj morčacie prsia do hrnca. Prilej {turkey.water} vody, premiešaj a osoľ.", "requires": ["turkey:cut", "paprika:base", "paste:base"], "produces": ["turkey:pot", "paprika:cooking", "paste:cooking"]},
        {"text": "Priveď vodu s mäsom do varu a prikry hrniec pokrievkou. Dus morčacie prsia v hrnci na miernom ohni 6 minút, kým kocky na povrchu stuhnú.", "requires": ["turkey:pot"], "produces": ["turkey:simmered"]},
        {"text": "Pridaj papriku do hrnca. Dus papriku s mäsom na miernom ohni 5 minút, kým paprika zmäkne.", "requires": ["pepper:cut"], "produces": ["pepper:cooked"]},
        {"text": "Rozšľahaj v miske {flour.amount} {flour.name} s tromi lyžicami studenej vody na hladkú kašičku bez hrudiek. Kašičku za stáleho miešania vylej do hrnca. Var morčacie prsia v omáčke na miernom ohni 3 minúty, kým omáčka zhustne a začne bublať.", "requires": ["flour:raw", "turkey:simmered", "paprika:cooking", "paste:cooking"], "produces": ["flour:cooked", "turkey:cooked", "paprika:cooked", "paste:cooked"]},
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci s osolenou vodou na strednom ohni asi 9 minút, kým budú mäkké, ale stále pevné. Odober z hrnca {pasta.water} vody a potom cestoviny sceď cez sitko.", "requires": ["pasta:raw"], "produces": ["pasta:cooked"]},
        {"text": "Dochuť perkelt soľou a čiernym korením. Ak je omáčka príliš hustá, prilievaj po troškách odloženú vodu z cestovín, kým bude krémová.", "requires": ["turkey:cooked"], "produces": []},
        {"text": "Podávaj morčací perkelt s cestovinami a rozdeľ jedlo na {portions} porcií.", "requires": ["turkey:cooked", "pasta:cooked", "onion:cooked", "garlic:cooked", "pepper:cooked", "oil:used", "paprika:cooked", "paste:cooked", "flour:cooked"], "produces": ["turkey:served", "pasta:served", "onion:served", "garlic:served", "pepper:served", "oil:served", "paprika:served", "paste:served", "flour:served"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Perkelt a cestoviny ulož oddelene do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní; perkelt prehrievaj na miernom ohni s lyžicou vody, aby mäso nevyschlo."}
    }
