      "pantry_basics": ["salt", "black_pepper"],
      "instructions": [
        {"text": "Priprav {zucchini.amount} {zucchini.name}: nahrubo ju nastrúhaj, premiešaj so štipkou soli a nechaj 5 minút postáť. Potom ju zabaľ do čistej utierky a vytlač čo najviac vody.", "requires": ["zucchini:raw", "cista_utierka:free"], "produces": ["zucchini:drained", "cista_utierka:used"]},
        {"text": "Priprav {cheese.amount} {cheese.name} a {garlic.amount} {garlic.name}: syr najemno nastrúhaj a cesnak nasekaj.", "requires": ["cheese:raw", "garlic:raw", "struhadlo:free"], "produces": ["cheese:grated", "garlic:cut", "struhadlo:used"]},
        {"text": "Premiešaj vo veľkej mise cuketu, {egg.amount} {egg.name}, {flour.amount} {flour.name}, syr a {paprika.amount} {paprika.name}. Pridaj čierne korenie; zmes má byť hustá a držať na lyžici.", "requires": ["zucchini:drained", "egg:raw", "flour:raw", "cheese:grated", "paprika:raw", "velka_misa:free"], "produces": ["zucchini:batter", "egg:batter", "flour:batter", "cheese:batter", "paprika:batter", "velka_misa:occupied"]},
        {"text": "Premiešaj v malej mise {yogurt.amount} {yogurt.name} s cesnakom a štipkou soli.", "requires": ["yogurt:raw", "garlic:cut", "mala_misa:free"], "produces": ["yogurt:mixed", "garlic:mixed", "mala_misa:occupied"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 1 minútu, kým sa začne lesknúť. Lyžicou ukladaj malé kôpky cesta a splošti ich na placky. Pri väčšej dávke pracuj po častiach.", "requires": ["oil:raw", "zucchini:batter", "egg:batter", "flour:batter", "cheese:batter", "paprika:batter", "panvica:free"], "produces": ["oil:hot", "panvica:occupied"]},
        {"text": "Opekaj placky z cukety v panvici na strednom ohni 3 až 4 minúty z každej strany, kým budú zlatisté, pevné a prepečené aj v strede.", "requires": ["oil:hot", "panvica:occupied", "velka_misa:occupied"], "produces": ["zucchini:cooked", "egg:cooked", "flour:cooked", "cheese:cooked", "paprika:cooked", "oil:cooked", "panvica:free", "velka_misa:free"]},
        {"text": "Podávaj cuketové placky s cesnakovým jogurtom a rozdeľ ich na {portions} porcií.", "requires": ["zucchini:cooked", "egg:cooked", "flour:cooked", "cheese:cooked", "paprika:cooked", "oil:cooked", "yogurt:mixed", "garlic:mixed", "mala_misa:occupied"], "produces": ["zucchini:served", "egg:served", "flour:served", "cheese:served", "yogurt:served", "garlic:served", "paprika:served", "oil:served", "mala_misa:free"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Placky a jogurtový dip odlož do samostatných plytkých nádob najneskôr do 2 hodín a uchovaj ich v chladničke. Zjedz ich do 2 dní; placky zohrej na suchej panvici, kým budú horúce, dip podávaj studený."}
