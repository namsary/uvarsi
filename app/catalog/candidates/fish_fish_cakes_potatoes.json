      "equipment": ["hrniec", "veľká panvica", "miska", "sekáčik", "nôž", "doska na krájanie"],
      "slots": [
        {"key": "fish", "role": "protein", "candidates": ["white_fish"], "amount_per_adult": "180", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na malé kúsky"},
        {"key": "bread", "role": "starch", "candidates": ["bread"], "amount_per_adult": "25", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "milk", "role": "dairy", "candidates": ["milk"], "amount_per_adult": "30", "unit": "ml", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "egg", "role": "protein", "candidates": ["egg"], "amount_per_adult": "0.5", "unit": "piece", "child_factor": "0.75", "required": true, "use": "addition", "cut": null},
        {"key": "onion", "role": "aromatic", "candidates": ["onion"], "amount_per_adult": "30", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "garlic", "role": "aromatic", "candidates": ["garlic"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "najemno"},
        {"key": "parsley", "role": "seasoning", "candidates": ["parsley"], "amount_per_adult": "5", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": "nadrobno"},
        {"key": "marjoram", "role": "seasoning", "candidates": ["marjoram"], "amount_per_adult": "1", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "crumbs", "role": "starch", "candidates": ["breadcrumbs"], "amount_per_adult": "20", "unit": "g", "child_factor": "0.6", "required": true, "use": "addition", "cut": null},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "15", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "potato", "role": "starch", "candidates": ["potato"], "amount_per_adult": "250", "unit": "g", "child_factor": "0.6", "required": true, "use": "main", "cut": "na polovice"},
        {"key": "butter", "role": "fat", "candidates": ["butter"], "amount_per_adult": "10", "unit": "g", "child_factor": "0.5", "required": true, "use": "addition", "cut": null},
        {"key": "lemon", "role": "seasoning", "candidates": ["lemon"], "amount_per_adult": "0.25", "unit": "piece", "child_factor": "0.5", "required": true, "use": "addition", "cut": "na mesiačiky"}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Ošúp {potato.amount} {potato.name} a nakrájaj ich {potato.cut}. Vlož zemiaky do hrnca, dolej studenú vodu tak, aby boli ponorené, a vodu osoľ.", "requires": ["potato:raw"], "produces": ["potato:pot"]},
        {"text": "Nakrájaj {bread.amount} {bread.name} na kocky. Vlož chlieb do misky a prilej {milk.amount} {milk.name}. Nechaj ho 5 minút nasiaknuť.", "requires": ["bread:raw", "milk:raw"], "produces": ["bread:soaked", "milk:soaked"]},
        {"text": "Nakrájaj {fish.amount} {fish.name} {fish.cut}, {onion.amount} {onion.name} {onion.cut}, {garlic.amount} {garlic.name} {garlic.cut} a {parsley.amount} {parsley.name} {parsley.cut}.", "requires": ["fish:raw", "onion:raw", "garlic:raw", "parsley:raw"], "produces": ["fish:cut", "onion:cut", "garlic:cut", "parsley:cut"]},
        {"text": "Rozmixuj rybu s nasiaknutým chlebom v sekáčiku krátko na hrubšiu hmotu. Ak sekáčik nemáš, rybu nasekaj nožom čo najjemnejšie a chlieb roztlač vidličkou.", "requires": ["fish:cut", "bread:soaked", "milk:soaked"], "produces": ["fish:minced", "bread:minced", "milk:minced"]},
        {"text": "Premiešaj v miske rybaciu hmotu, {egg.amount} {egg.name}, cibuľu, cesnak, polovicu petržlenovej vňate, {marjoram.amount} {marjoram.name}, soľ a čierne korenie.", "requires": ["fish:minced", "bread:minced", "milk:minced", "egg:raw", "onion:cut", "garlic:cut", "marjoram:raw"], "produces": ["fish:mixed", "bread:mixed", "milk:mixed", "egg:mixed", "onion:mixed", "garlic:mixed", "marjoram:mixed"]},
        {"text": "Vsyp {crumbs.amount} {crumbs.name} do misky. Mokrými rukami vytvaruj z rybacej hmoty placky hrubé asi 1,5 centimetra, dve na každú porciu, a obaľ ich v strúhanke.", "requires": ["fish:mixed", "crumbs:raw"], "produces": ["fish:shaped", "crumbs:coating"]},
        {"text": "Var zemiaky v hrnci na miernom ohni 20 minút, kým zmäknú.", "requires": ["potato:pot"], "produces": ["potato:cooked"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Karbonátky opekaj po častiach 4 minúty z každej strany, kým budú zlatisté a v strede pevné. Panvicu neprepĺňaj a podľa potreby dolej trochu oleja z fľaše.", "requires": ["oil:raw", "fish:shaped", "bread:mixed", "milk:mixed", "egg:mixed", "onion:mixed", "garlic:mixed", "marjoram:mixed", "crumbs:coating"], "produces": ["oil:used", "fish:fried", "bread:fried", "milk:fried", "egg:fried", "onion:fried", "garlic:fried", "marjoram:fried", "crumbs:fried"]},
        {"text": "Sceď zemiaky a vráť ich do hrnca. Pridaj {butter.amount} {butter.name} a petržlenovú vňať do hrnca. Zemiaky premiešaj, kým sa maslo roztopí.", "requires": ["potato:cooked", "butter:raw", "parsley:cut"], "produces": ["potato:buttered", "butter:used", "parsley:used"]},
        {"text": "Nakrájaj {lemon.amount} {lemon.name} {lemon.cut}.", "requires": ["lemon:raw"], "produces": ["lemon:cut"]},
        {"text": "Podávaj rybie karbonátky s maslovými zemiakmi a mesiačikmi citróna. Jedlo rozdeľ na {portions} porcií.", "requires": ["fish:fried", "bread:fried", "milk:fried", "egg:fried", "onion:fried", "garlic:fried", "parsley:used", "marjoram:fried", "crumbs:fried", "oil:used", "potato:buttered", "butter:used", "lemon:cut"], "produces": ["fish:served", "bread:served", "milk:served", "egg:served", "onion:served", "garlic:served", "parsley:served", "marjoram:served", "crumbs:served", "oil:served", "potato:served", "butter:served", "lemon:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Karbonátky a zemiaky ulož oddelene do uzavretých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 2 dní a karbonátky prehrej v rúre pri 180 °C asi 10 minút."}
    }
