      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {tomato.amount} {tomato.name} na malé kúsky a {onion.amount} {onion.name} najemno. Sceď {tuna.amount} {tuna.name}.", "requires": ["tomato:raw", "onion:raw", "tuna:raw", "sitko:free"], "produces": ["tomato:cut", "onion:cut", "tuna:drained", "sitko:free"]},
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci vo vriacej osolenej vode na strednom ohni 6 minút, kým budú čiastočne mäkké, ale zostanú pevné.", "requires": ["pasta:raw", "hrniec:free"], "produces": ["pasta:partly_cooked", "hrniec:occupied"]},
        {"text": "Pridaj {peas.amount} {peas.name} do hrnca. Var hrášok s cestovinami v hrnci na strednom ohni ďalšie 3 minúty, kým hrášok zmäkne a cestoviny budú pevné na zahryznutie.", "requires": ["pasta:partly_cooked", "peas:raw", "hrniec:occupied"], "produces": ["pasta:cooked", "peas:cooked"]},
        {"text": "Sceď cestoviny s hráškom cez sitko, opláchni ich studenou vodou a nechaj dobre odkvapkať.", "requires": ["pasta:cooked", "peas:cooked", "hrniec:occupied", "sitko:free"], "produces": ["pasta:cooled", "peas:cooled", "hrniec:free", "sitko:free"]},
        {"text": "Premiešaj {yogurt.amount} {yogurt.name} s {vinegar.amount} {vinegar.name}, soľou a čiernym korením v mise.", "requires": ["yogurt:raw", "vinegar:raw", "misa:free"], "produces": ["yogurt:mixed", "vinegar:mixed", "misa:occupied"]},
        {"text": "Vmiešaj cestoviny, hrášok, tuniaka, paradajky a cibuľu do jogurtového dresingu. Nechaj šalát 10 minút postáť, aby sa chute spojili.", "requires": ["pasta:cooled", "peas:cooled", "tuna:drained", "tomato:cut", "onion:cut", "yogurt:mixed", "vinegar:mixed", "misa:occupied"], "produces": ["pasta:combined", "peas:combined", "tuna:combined", "tomato:combined", "onion:combined", "yogurt:combined", "vinegar:combined"]},
        {"text": "Podávaj šalát vychladený alebo pri izbovej teplote a rozdeľ ho na {portions} porcií.", "requires": ["pasta:combined", "peas:combined", "tuna:combined", "tomato:combined", "onion:combined", "yogurt:combined", "vinegar:combined", "misa:occupied"], "produces": ["pasta:served", "peas:served", "tuna:served", "tomato:served", "onion:served", "yogurt:served", "vinegar:served", "misa:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Šalát rozdeľ do plytkých uzatvárateľných nádob a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 3 dní a nenechávaj ho zbytočne stáť v teple."}
