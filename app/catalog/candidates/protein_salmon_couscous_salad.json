      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Vsyp {couscous.amount} {couscous.name} do hrnca.", "requires": ["couscous:raw", "hrniec:free"], "produces": ["couscous:in_pot", "hrniec:occupied"]},
        {"text": "Zalej {couscous.water} vody do hrnca.", "requires": ["couscous:in_pot", "hrniec:occupied"], "produces": ["couscous:soaking"]},
        {"text": "Prikry hrniec a nechaj kuskus 8 minút postáť, kým zmäkne a vsiakne vodu. Potom ho prekypri vidličkou.", "requires": ["couscous:soaking", "hrniec:occupied"], "produces": ["couscous:cooked", "hrniec:free"]},
        {"text": "Nakrájaj {tomato.amount} {tomato.name} a {cucumber.amount} {cucumber.name} na menšie kúsky. Priprav {lemon.amount} {lemon.name} na dochutenie a vytlač z neho šťavu. Rozdeľ {salmon.amount} {salmon.name} na porcie.", "requires": ["tomato:raw", "cucumber:raw", "lemon:raw", "salmon:raw"], "produces": ["tomato:cut", "cucumber:cut", "lemon:juiced", "salmon:portioned"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 2 minúty, kým sa začne lesknúť.", "requires": ["oil:raw", "panvica:free"], "produces": ["oil:hot", "panvica:occupied"]},
        {"text": "Opekaj lososa v panvici na strednom ohni 4 minúty z každej strany, kým bude povrch zlatistý a mäso sa bude ľahko oddeľovať vidličkou.", "requires": ["salmon:portioned", "oil:hot", "panvica:occupied"], "produces": ["salmon:cooked", "oil:used", "panvica:free"]},
        {"text": "Premiešaj kuskus s paradajkami, uhorkou a citrónovou šťavou v miske. Dochuť šalát soľou a čiernym korením.", "requires": ["couscous:cooked", "tomato:cut", "cucumber:cut", "lemon:juiced", "miska:free"], "produces": ["couscous:mixed", "tomato:mixed", "cucumber:mixed", "lemon:mixed", "miska:occupied"]},
        {"text": "Podávaj šalát s lososom a rozdeľ jedlo na {portions} porcií.", "requires": ["couscous:mixed", "tomato:mixed", "cucumber:mixed", "lemon:mixed", "salmon:cooked", "oil:used", "miska:occupied"], "produces": ["couscous:served", "tomato:served", "cucumber:served", "lemon:served", "salmon:served", "oil:served", "miska:free"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Šalát a lososa odlož do oddelených uzatvárateľných nádob najneskôr do 2 hodín. V chladničke ich uchovaj najviac 2 dni a spoj ich až pred jedlom."}
