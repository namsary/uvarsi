      "instructions": [
        {
          "text": "Predhrej rúru na 200 °C.",
          "requires": ["rura:free"],
          "produces": ["rura:heated"]
        },
        {
          "text": "Ošúp {potato.amount} {potato.name} a nakrájaj zemiaky na mesiačiky.",
          "requires": ["potato:raw"],
          "produces": ["potato:cut"]
        },
        {
          "text": "Nakrájaj {onion.amount} {onion.name} na hrubšie mesiačiky.",
          "requires": ["onion:raw"],
          "produces": ["onion:cut"]
        },
        {
          "text": "Osuš {chicken.amount} {chicken.name} a nechaj ich celé.",
          "requires": ["chicken:raw"],
          "produces": ["chicken:prepared"]
        },
        {
          "text": "Premiešaj v miske {oil.amount} {oil.name}, {paprika.amount} {paprika.name}, {garlic.amount} {garlic.name}, soľ a čierne korenie.",
          "requires": ["oil:raw", "paprika:raw", "garlic:raw", "miska:free"],
          "produces": ["oil:seasoned", "paprika:paste", "garlic:paste", "miska:free"]
        },
        {
          "text": "Priprav kuracie stehná s paprikovou zmesou tak, aby bola koža rovnomerne pokrytá. Rozlož kuracie stehná do pekáča.",
          "requires": ["chicken:prepared", "oil:seasoned", "paprika:paste", "garlic:paste", "pekac:free"],
          "produces": ["chicken:seasoned", "oil:combined", "paprika:combined", "garlic:combined", "pekac:occupied"]
        },
        {
          "text": "Pridaj zemiaky a cibuľu do pekáča. Peč kuracie stehná so zemiakmi a cibuľou pri 200 °C približne 50 minút, kým koža zozlatne, zemiaky zmäknú a po narezaní pri kosti mäso nie je ružové a vyteká z neho číra šťava.",
          "requires": ["chicken:seasoned", "potato:cut", "onion:cut", "oil:combined", "paprika:combined", "garlic:combined", "pekac:occupied", "rura:heated"],
          "produces": ["chicken:cooked", "potato:cooked", "onion:cooked", "oil:cooked", "paprika:cooked", "garlic:cooked", "pekac:free", "rura:free"]
        },
        {
          "text": "Podávaj celé kuracie stehná so zemiakmi a rozdeľ jedlo na {portions} porcií.",
          "requires": ["chicken:cooked", "potato:cooked", "onion:cooked", "oil:cooked", "paprika:cooked", "garlic:cooked"],
          "produces": ["chicken:served", "potato:served", "onion:served", "oil:served", "paprika:served", "garlic:served"]
        }
