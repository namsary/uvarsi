      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {sausage.amount} {sausage.name} na polkolieska, {onion.amount} {onion.name} nadrobno, {pepper.amount} {pepper.name} na kocky, {tomato.amount} {tomato.name} na kocky a {garlic.amount} {garlic.name} najemno. Nastrúhaj {cheese.amount} {cheese.name}.", "requires": ["sausage:raw", "onion:raw", "pepper:raw", "tomato:raw", "garlic:raw", "cheese:raw"], "produces": ["sausage:cut", "onion:cut", "pepper:cut", "tomato:cut", "garlic:cut", "cheese:grated"]},
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci s osolenou vodou na strednom ohni asi 9 minút, kým budú mäkké, ale stále pevné. Odober z hrnca {pasta.water} vody a potom cestoviny sceď cez sitko.", "requires": ["pasta:raw", "hrniec:free", "sitko:free"], "produces": ["pasta:cooked", "hrniec:free", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na strednom ohni 1 minútu, kým sa začne lesknúť. Opekaj údenú klobásu v panvici na strednom ohni 4 minúty, kým bude na okrajoch zlatistá. Pri veľkej dávke použi široký hrniec.", "requires": ["oil:raw", "sausage:cut", "velka_panvica:free"], "produces": ["oil:used", "sausage:browned", "velka_panvica:occupied"]},
        {"text": "Pridaj cibuľu a papriku do panvice. Opekaj cibuľu s paprikou na strednom ohni 4 minúty, kým zmäknú. Pridaj cesnak do panvice a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["onion:cut", "pepper:cut", "garlic:cut", "sausage:browned", "velka_panvica:occupied"], "produces": ["onion:cooked", "pepper:cooked", "garlic:cooked"]},
        {"text": "Odstav panvicu z ohňa. Vmiešaj {paprika.amount} {paprika.name} a {paste.amount} {paste.name}.", "requires": ["paprika:raw", "paste:raw", "onion:cooked", "velka_panvica:occupied"], "produces": ["paprika:combined", "paste:combined"]},
        {"text": "Vráť panvicu na sporák. Pridaj paradajky do panvice. Prilej {tomato.water} vody a prisyp {oregano.amount} {oregano.name}. Var paradajky v omáčke na miernom ohni 10 minút, kým sa rozpadnú, omáčka zhustne a jemne bublá.", "requires": ["tomato:cut", "oregano:raw", "paste:combined", "velka_panvica:occupied"], "produces": ["tomato:cooked", "oregano:cooked", "paste:cooked"]},
        {"text": "Pridaj cestoviny do panvice. Zohrievaj cestoviny v omáčke na miernom ohni 2 minúty, kým sa omáčkou rovnomerne obalia a jemne bublá. Ak je omáčka hustá, prilievaj po troškách odloženú vodu z cestovín, kým bude krémová.", "requires": ["pasta:cooked", "tomato:cooked", "velka_panvica:occupied"], "produces": ["pasta:combined"]},
        {"text": "Dochuť cestoviny soľou a čiernym korením až po ochutnaní, klobása aj syr sú slané. Rozdeľ ich na {portions} porcií, navrch nasyp tvrdý syr a podávaj.", "requires": ["pasta:combined", "sausage:browned", "tomato:cooked", "pepper:cooked", "onion:cooked", "garlic:cooked", "paste:cooked", "paprika:combined", "oregano:cooked", "oil:used", "cheese:grated", "velka_panvica:occupied"], "produces": ["pasta:served", "sausage:served", "tomato:served", "pepper:served", "onion:served", "garlic:served", "paste:served", "paprika:served", "oregano:served", "oil:served", "cheese:served", "velka_panvica:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Cestoviny s omáčkou rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní, prehrievaj s lyžicou vody a syr nasyp až na tanier."}
