      "instructions": [
        {"text": "Nakrájaj {potato.amount} {potato.name} {potato.cut} a {onion.amount} {onion.name} {onion.cut}.", "requires": ["potato:raw", "onion:raw"], "produces": ["potato:cut", "onion:cut"]},
        {"text": "Nalej {oil.amount} {oil.name} do hrnca. Opekaj cibuľu na strednom ohni 5 minút, kým bude dosklovita.", "requires": ["oil:raw", "onion:cut", "hrniec:free"], "produces": ["oil:cooked", "onion:cooked", "hrniec:occupied"]},
        {"text": "Pridaj zemiaky do hrnca a prilej {potato.water} vody. Var zemiaky na miernom ohni 15 minút, kým zmäknú, ale nerozpadnú sa.", "requires": ["potato:cut", "onion:cooked", "oil:cooked", "hrniec:occupied"], "produces": ["potato:cooked"]},
        {"text": "Priprav v mise hladkú zálievku: rozšľahaj {cream.amount} {cream.name} metličkou. Prisyp {flour.amount} {flour.name}. Zálievku zrieď naberačkou horúcej vody zo zemiakov a premiešaj ju dohladka.", "requires": ["cream:raw", "flour:raw", "potato:cooked", "misa:free", "metlicka:free"], "produces": ["cream:mixed", "flour:mixed", "misa:occupied", "metlicka:free"]},
        {"text": "Premiešaj zálievku so zemiakmi v hrnci. Prívarok var za stáleho miešania na miernom ohni 4 minúty, kým zhustne a začne jemne bublať.", "requires": ["cream:mixed", "flour:mixed", "potato:cooked", "onion:cooked", "oil:cooked", "hrniec:occupied", "misa:occupied"], "produces": ["cream:cooked", "flour:cooked", "potato:finished", "onion:finished", "oil:finished", "misa:free"]},
        {"text": "Odstav hrniec a vmiešaj {vinegar.amount} {vinegar.name}. Zemiakový prívarok dochuť soľou a čiernym korením.", "requires": ["vinegar:raw", "potato:finished", "cream:cooked", "flour:cooked", "onion:finished", "oil:finished", "hrniec:occupied"], "produces": ["vinegar:combined"]},
        {"text": "Uvar {egg.amount} {egg.name} natvrdo v malom hrnci na strednom ohni. Od začiatku varu počítaj 9 minút, kým bielok aj žĺtok stuhnú. Potom {egg.reference_name} schlaď v studenej vode a ošúp.", "requires": ["egg:raw", "maly_hrniec:free"], "produces": ["egg:cooked", "maly_hrniec:free"]},
        {"text": "Podávaj zemiakový prívarok s vajcom a rozdeľ ho na {portions} porcií.", "requires": ["potato:finished", "cream:cooked", "flour:cooked", "onion:finished", "oil:finished", "vinegar:combined", "egg:cooked", "hrniec:occupied"], "produces": ["potato:served", "cream:served", "flour:served", "onion:served", "oil:served", "vinegar:served", "egg:served", "hrniec:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Prívarok rozdeľ do plytkých nádob a do jednej hodiny ho odlož do chladničky. Vajcia uchovaj oddelene a všetko spotrebuj do 3 dní."}
