        {"key": "marjoram", "role": "seasoning", "candidates": ["marjoram"], "amount_per_adult": "1", "unit": "g", "child_factor": "0.4", "required": true, "use": "addition", "cut": null},
        {"key": "sugar", "role": "seasoning", "candidates": ["sugar"], "amount_per_adult": "3", "unit": "g", "child_factor": "0.4", "required": true, "use": "addition", "cut": null},
        {"key": "oil", "role": "fat", "candidates": ["oil"], "amount_per_adult": "10", "unit": "ml", "child_factor": "0.5", "required": true, "use": "addition", "cut": null}
      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Prepláchni {rice.amount} {rice.name} studenou vodou. Sceď a prepláchni aj {beans.amount} {beans.name} cez sitko.", "requires": ["rice:raw", "beans:raw", "sitko:free"], "produces": ["rice:rinsed", "beans:rinsed", "sitko:free"]},
        {"text": "Nalej {rice.water} vody do hrnca, prikry ho a priveď na strednom ohni do varu. Potom var ryžu v hrnci na miernom ohni 15 minút, kým zmäkne a vsiakne vodu.", "requires": ["rice:rinsed", "hrniec_na_ryzu:free"], "produces": ["rice:cooked", "hrniec_na_ryzu:free"]},
        {"text": "Nakrájaj {pepper.amount} {pepper.name} na malé kocky a {onion.amount} {onion.name} s {garlic.amount} {garlic.name} nadrobno.", "requires": ["pepper:raw", "onion:raw", "garlic:raw"], "produces": ["pepper:cut", "onion:cut", "garlic:cut"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkom hrnci na strednom ohni 2 minúty, kým sa začne lesknúť.", "requires": ["oil:raw", "velky_hrniec:free"], "produces": ["oil:heated", "velky_hrniec:hot"]},
        {"text": "Opekaj {beef.amount} {beef.name} vo veľkom hrnci na strednom ohni 8 minút, kým sa rozdelí na drobné kúsky a bude zlatisté. Pri väčšej dávke mäso opekaj po častiach.", "requires": ["beef:raw", "oil:heated", "velky_hrniec:hot"], "produces": ["beef:browned", "oil:used"]},
        {"text": "Pridaj papriku, cibuľu a cesnak do veľkého hrnca. Opekaj papriku s cibuľou, cesnakom a mletým hovädzím mäsom vo veľkom hrnci na strednom ohni 6 minút, kým cibuľa zmäkne a paprika stratí surovú chrumkavosť.", "requires": ["pepper:cut", "onion:cut", "garlic:cut", "beef:browned", "velky_hrniec:hot"], "produces": ["pepper:cooked", "onion:cooked", "garlic:cooked"]},
        {"text": "Odstav hrniec z ohňa. Prisyp {paprika.amount} {paprika.name}, {cumin.amount} {cumin.name}, {chili.amount} {chili.name} a {marjoram.amount} {marjoram.name}. Hneď premiešaj.", "requires": ["paprika:raw", "cumin:raw", "chili:raw", "marjoram:raw", "beef:browned", "pepper:cooked", "onion:cooked", "garlic:cooked", "velky_hrniec:hot"], "produces": ["paprika:combined", "cumin:combined", "chili:combined", "marjoram:combined"]},
        {"text": "Pridaj {tomato.amount} {tomato.name} a {sugar.amount} {sugar.name} do hrnca. Var paradajky s mletým hovädzím mäsom vo veľkom hrnci na miernom ohni 25 minút, kým zmes jemne bublá a omáčka zhustne.", "requires": ["tomato:raw", "sugar:raw", "beef:browned", "paprika:combined", "cumin:combined", "chili:combined", "marjoram:combined", "velky_hrniec:hot"], "produces": ["tomato:cooked", "sugar:cooked", "beef:cooked", "paprika:cooked", "cumin:cooked", "chili:cooked", "marjoram:cooked"]},
        {"text": "Pridaj červenú fazuľu do hrnca. Var červenú fazuľu s paradajkami vo veľkom hrnci na miernom ohni 8 minút, kým bude horúca a omáčka začne znovu jemne bublať.", "requires": ["beans:rinsed", "tomato:cooked", "beef:cooked", "velky_hrniec:hot"], "produces": ["beans:cooked", "pepper:finished", "onion:finished", "garlic:finished", "velky_hrniec:free"]},
        {"text": "Dochuť chilli soľou a čiernym korením. Podávaj ho s ryžou a rozdeľ jedlo na {portions} porcií.", "requires": ["beef:cooked", "rice:cooked", "beans:cooked", "tomato:cooked", "pepper:finished", "onion:finished", "garlic:finished", "paprika:cooked", "cumin:cooked", "chili:cooked", "marjoram:cooked", "sugar:cooked", "oil:used"], "produces": ["beef:served", "rice:served", "beans:served", "tomato:served", "pepper:served", "onion:served", "garlic:served", "paprika:served", "cumin:served", "chili:served", "marjoram:served", "sugar:served", "oil:served"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Chilli a ryžu rozdeľ do oddelených plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní."}
