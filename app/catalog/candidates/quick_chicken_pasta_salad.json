      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {chicken.amount} {chicken.name} na kocky. Mäso osoľ a okoreň.", "requires": ["chicken:raw"], "produces": ["chicken:cut"]},
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci vo vriacej osolenej vode na strednom ohni 9 minút, kým budú mäkké, ale stále pevné. Sceď cestoviny cez sitko, prepláchni ich studenou vodou a nechaj ich dobre odkvapkať.", "requires": ["pasta:raw", "hrniec:free", "sitko:free"], "produces": ["pasta:cooled", "hrniec:free", "sitko:free"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni 1 minútu, kým sa začne lesknúť. Opekaj kuracie prsia v panvici na strednom ohni 6 minút, kým budú zo všetkých strán zlatisté a v strede nebudú ružové. Pri väčšej dávke ich opekaj po častiach, potom ich vyber na tanier a nechaj vychladnúť.", "requires": ["oil:raw", "chicken:cut", "panvica:free", "tanier:free"], "produces": ["oil:used", "chicken:cooled", "panvica:free", "tanier:occupied"]},
        {"text": "Nakrájaj {pepper.amount} {pepper.name} a {cucumber.amount} {cucumber.name} na malé kocky a {dill.amount} {dill.name} nadrobno. Sceď {corn.amount} {corn.name} cez sitko.", "requires": ["pepper:raw", "cucumber:raw", "dill:raw", "corn:raw", "sitko:free"], "produces": ["pepper:cut", "cucumber:cut", "dill:cut", "corn:drained", "sitko:free"]},
        {"text": "Premiešaj {yogurt.amount} {yogurt.name}, {mayo.amount} {mayo.name}, {vinegar.amount} {vinegar.name} a kôpor so soľou a čiernym korením v mise, aby vznikol riedky dresing.", "requires": ["yogurt:raw", "mayo:raw", "vinegar:raw", "dill:cut", "misa:free"], "produces": ["yogurt:dressing", "mayo:dressing", "vinegar:dressing", "dill:dressing", "misa:occupied"]},
        {"text": "Vmiešaj cestoviny, kuracie prsia, papriku, uhorku a kukuricu do dresingu. Nechaj šalát 10 minút postáť v chlade, aby sa chute spojili.", "requires": ["pasta:cooled", "chicken:cooled", "pepper:cut", "cucumber:cut", "corn:drained", "yogurt:dressing", "mayo:dressing", "vinegar:dressing", "dill:dressing", "misa:occupied", "tanier:occupied"], "produces": ["pasta:mixed", "chicken:mixed", "pepper:mixed", "cucumber:mixed", "corn:mixed", "yogurt:mixed", "mayo:mixed", "vinegar:mixed", "dill:mixed", "tanier:free"]},
        {"text": "Podávaj šalát vychladený a rozdeľ ho na {portions} porcií.", "requires": ["pasta:mixed", "chicken:mixed", "pepper:mixed", "cucumber:mixed", "corn:mixed", "yogurt:mixed", "mayo:mixed", "vinegar:mixed", "dill:mixed", "oil:used", "misa:occupied"], "produces": ["pasta:served", "chicken:served", "pepper:served", "cucumber:served", "corn:served", "yogurt:served", "mayo:served", "vinegar:served", "dill:served", "oil:served", "misa:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Šalát rozdeľ do uzatvárateľných nádob a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 3 dní; ak cestoviny dresing vpijú, vmiešaj pred podávaním lyžicu jogurtu."}
