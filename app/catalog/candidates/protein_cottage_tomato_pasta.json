      "instructions": [
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci s osolenou vodou na strednom ohni približne 10 minút podľa času na obale, kým budú mäkké, ale nerozvarené. Pred scedením odlož trochu vody z cestovín.", "requires": ["pasta:raw", "hrniec:free", "sitko:free"], "produces": ["pasta:cooked", "hrniec:free", "sitko:free"]},
        {"text": "Nakrájaj {tomato.amount} {tomato.name} na menšie kocky, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno.", "requires": ["tomato:raw", "onion:raw", "garlic:raw"], "produces": ["tomato:cut", "onion:cut", "garlic:cut"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v hlbokej panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj cibuľu 5 minút, kým zosklovatie.", "requires": ["oil:raw", "onion:cut", "hlboka_panvica:free"], "produces": ["oil:used", "onion:cooked", "hlboka_panvica:occupied"]},
        {"text": "Pridaj paradajky a cesnak do panvice. Var paradajky s cesnakom na miernom ohni 8 minút, kým zmäknú a pustia šťavu.", "requires": ["tomato:cut", "garlic:cut", "onion:cooked", "hlboka_panvica:occupied"], "produces": ["tomato:cooked", "garlic:cooked"]},
        {"text": "Odstav panvicu z ohňa a pridaj {cottage.amount} {cottage.name}. Omáčku premiešaj, kým bude krémová; podľa potreby ju zrieď odloženou vodou z cestovín.", "requires": ["cottage:raw", "tomato:cooked", "garlic:cooked", "onion:cooked", "hlboka_panvica:occupied"], "produces": ["cottage:mixed", "tomato:sauce", "garlic:mixed", "onion:mixed"]},
        {"text": "Vmiešaj cestoviny do panvice. Dochuť ich soľou a čiernym korením, rozdeľ na {portions} porcií a podávaj hneď.", "requires": ["pasta:cooked", "cottage:mixed", "tomato:sauce", "garlic:mixed", "onion:mixed", "oil:used", "hlboka_panvica:occupied"], "produces": ["pasta:served", "cottage:served", "tomato:served", "garlic:served", "onion:served", "oil:served", "hlboka_panvica:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Cestoviny rozdeľ do plytkých uzatvárateľných nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 3 dní a pri ohrievaní pridaj trochu vody, aby omáčka zostala krémová."}
