      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {chicken.amount} {chicken.name} na dvojcentimetrové kúsky, {tomato.amount} {tomato.name} na malé kúsky, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno. Priprav {spinach.amount} {spinach.name} a nastrúhaj {cheese.amount} {cheese.name}.", "requires": ["chicken:raw", "tomato:raw", "onion:raw", "garlic:raw", "spinach:raw", "cheese:raw"], "produces": ["chicken:cut", "tomato:cut", "onion:cut", "garlic:cut", "cheese:grated"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v hlbokej panvici. Kuracie kúsky osoľ, okoreň a opekaj na stredne silnom ohni 5 minút, kým budú miestami zlatisté. Pri väčšej dávke ich opeč po častiach a odlož na tanier.", "requires": ["oil:raw", "chicken:cut", "hlboka_panvica_s_pokrievkou:free"], "produces": ["oil:used", "chicken:browned", "hlboka_panvica_s_pokrievkou:free"]},
        {"text": "Opekaj cibuľu v tej istej panvici na strednom ohni 3 minúty, kým zmäkne. Pridaj cesnak a {oregano.amount} {oregano.name} do panvice. Miešaj 30 sekúnd, kým sa rozvoňajú.", "requires": ["oil:used", "onion:cut", "garlic:cut", "oregano:raw", "hlboka_panvica_s_pokrievkou:free"], "produces": ["onion:softened", "garlic:toasted", "oregano:toasted", "hlboka_panvica_s_pokrievkou:occupied"]},
        {"text": "Vsyp {orzo.amount} {orzo.name} do panvice. Pridaj paradajky a kuracie prsia do panvice. Prilej {orzo.water} vody do panvice, premiešaj a prikry.", "requires": ["orzo:raw", "tomato:cut", "chicken:browned", "onion:softened", "garlic:toasted", "oregano:toasted", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["orzo:simmering", "tomato:simmering", "chicken:simmering"]},
        {"text": "Var cestoviny a kuracie prsia v prikrytej panvici na miernom ohni 10 až 12 minút a dvakrát premiešaj, kým budú cestoviny mäkké, tekutina takmer vsiakne a mäso nebude v strede ružové.", "requires": ["orzo:simmering", "tomato:simmering", "chicken:simmering", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["orzo:cooked", "tomato:cooked", "chicken:cooked", "onion:cooked", "garlic:cooked", "oregano:cooked", "oil:cooked"]},
        {"text": "Vmiešaj špenát a {cheese.name} do panvice. Prehrievaj špenát a syr v panvici na miernom ohni 2 minúty, kým špenát zmäkne, syr sa roztopí a omáčka bude krémová.", "requires": ["spinach:raw", "cheese:grated", "orzo:cooked", "chicken:cooked", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["spinach:cooked", "cheese:melted"]},
        {"text": "Podávaj kuracie orzo horúce a rozdeľ ho na {portions} porcií.", "requires": ["chicken:cooked", "orzo:cooked", "tomato:cooked", "spinach:cooked", "onion:cooked", "garlic:cooked", "cheese:melted", "oregano:cooked", "oil:cooked", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["chicken:served", "orzo:served", "tomato:served", "spinach:served", "onion:served", "garlic:served", "cheese:served", "oregano:served", "oil:served", "hlboka_panvica_s_pokrievkou:free"]}
      ],
      "storage": {"refrigerated_days": 3, "instruction": "Kuracie orzo rozdeľ do plytkých uzatvárateľných nádob a najneskôr do 2 hodín ho odlož do chladničky. Zjedz ho do 3 dní a zohrej ho iba raz, kým bude celé horúce."}
