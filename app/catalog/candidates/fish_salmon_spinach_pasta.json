      ],
      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {"text": "Nakrájaj {salmon.amount} {salmon.name} {salmon.cut}, {onion.amount} {onion.name} {onion.cut}, {garlic.amount} {garlic.name} {garlic.cut} a {dill.amount} {dill.name} {dill.cut}. Nastrúhaj {cheese.amount} {cheese.name} najemno.", "requires": ["salmon:raw", "onion:raw", "garlic:raw", "dill:raw", "cheese:raw"], "produces": ["salmon:cut", "onion:cut", "garlic:cut", "dill:cut", "cheese:grated"]},
        {"text": "Opláchni {spinach.amount} {spinach.name} v sitku a nechaj ho odkvapkať. Mrazený listový špenát neoplachuj.", "requires": ["spinach:raw"], "produces": ["spinach:rinsed"]},
        {"text": "Uvar {pasta.amount} {pasta.name} v hrnci s osolenou vodou na strednom ohni asi 9 minút, kým budú mäkké, ale stále pevné. Odober z hrnca {pasta.water} vody a potom cestoviny sceď cez sitko.", "requires": ["pasta:raw"], "produces": ["pasta:cooked"]},
        {"text": "Rozohrej {oil.amount} {oil.name} vo veľkej panvici na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj cibuľu 4 minúty, kým bude dosklovita. Pridaj cesnak a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["oil:raw", "onion:cut", "garlic:cut"], "produces": ["oil:used", "onion:cooked", "garlic:cooked"]},
        {"text": "Pridaj špenát do panvice. Dus špenát na strednom ohni 3 minúty, kým zmäkne a voda sa odparí. Mrazený špenát nerozmrazuj, daj ho do panvice rovno z mrazničky a dus ho o 3 minúty dlhšie.", "requires": ["spinach:rinsed"], "produces": ["spinach:cooked"]},
        {"text": "Prilej {cream.amount} {cream.name} do panvice a pridaj lososa. Var lososa v smotane na miernom ohni 4 minúty, kým kocky stuhnú a omáčka začne jemne bublať. Miešaj opatrne, aby sa ryba nerozpadla.", "requires": ["cream:raw", "salmon:cut"], "produces": ["cream:cooked", "salmon:cooked"]},
        {"text": "Pridaj cestoviny do panvice. Zohrievaj cestoviny v omáčke na miernom ohni 2 minúty, kým omáčka jemne bublá a cestoviny sa ňou obalia. Ak je omáčka hustá, prilievaj po troškách odloženú vodu z cestovín, kým bude krémová. Vmiešaj kôpor.", "requires": ["pasta:cooked", "dill:cut"], "produces": ["pasta:combined", "dill:used"]},
        {"text": "Dochuť jedlo soľou a čiernym korením až po ochutnaní, syr je slaný. Rozdeľ ho na {portions} porcií, navrch nasyp syr a podávaj.", "requires": ["salmon:cooked", "pasta:combined", "spinach:cooked", "cream:cooked", "onion:cooked", "garlic:cooked", "cheese:grated", "dill:used", "oil:used"], "produces": ["salmon:served", "pasta:served", "spinach:served", "cream:served", "onion:served", "garlic:served", "cheese:served", "dill:served", "oil:served"]}
      ],
      "storage": {"refrigerated_days": 2, "instruction": "Cestoviny s omáčkou rozdeľ do plytkých nádob a najneskôr do 2 hodín ich odlož do chladničky. Zjedz ich do 2 dní; pri ohrievaní prilej lyžicu vody, aby omáčka ostala krémová."}
