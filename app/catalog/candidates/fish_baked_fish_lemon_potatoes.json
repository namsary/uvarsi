      "instructions": [
        {"text": "Predhrej rúru na 200 °C.", "requires": [], "produces": []},
        {"text": "Ošúp {potato.amount} {potato.name} a nakrájaj ich {potato.cut}. Vlož zemiaky do pekáča. Prilej {oil.amount} {oil.name}, prisyp {thyme.amount} {thyme.name}, soľ a čierne korenie, premiešaj a rozlož zemiaky do rovnej vrstvy.", "requires": ["potato:raw", "oil:raw", "thyme:raw"], "produces": ["potato:pan", "oil:pan", "thyme:pan"]},
        {"text": "Peč zemiaky v pekáči pri 200 °C 25 minút, kým zospodu zozlatnú a takmer zmäknú.", "requires": ["potato:pan", "oil:pan", "thyme:pan"], "produces": ["potato:parbaked", "oil:baked", "thyme:baked"]},
        {"text": "Nakrájaj {garlic.amount} {garlic.name} {garlic.cut}, {parsley.amount} {parsley.name} {parsley.cut} a {lemon.amount} {lemon.name} {lemon.cut}.", "requires": ["garlic:raw", "parsley:raw", "lemon:raw"], "produces": ["garlic:cut", "parsley:cut", "lemon:cut"]},
        {"text": "Zohrej {butter.amount} {butter.name} v malom hrnci na miernom ohni 1 minútu, kým sa roztopí a začne bublať. Odstav hrniec z ohňa a vmiešaj cesnak a petržlenovú vňať.", "requires": ["butter:raw", "garlic:cut", "parsley:cut"], "produces": ["butter:melted", "garlic:butter", "parsley:butter"]},
        {"text": "Osuš {fish.amount} {fish.name} papierovou utierkou a nakrájaj ju {fish.cut}. Porcie z oboch strán osoľ a okoreň.", "requires": ["fish:raw"], "produces": ["fish:seasoned"]},
        {"text": "Vyber pekáč z rúry. Rozlož rybu na zemiaky, polej ju cesnakovým maslom a prikry plátkami citróna.", "requires": ["fish:seasoned", "potato:parbaked", "butter:melted", "garlic:butter", "parsley:butter", "lemon:cut"], "produces": ["fish:pan", "butter:pan", "garlic:pan", "parsley:pan", "lemon:pan"]},
        {"text": "Peč rybu so zemiakmi v pekáči pri 200 °C 15 minút, kým ryba stuhne, v strede bude biela a zemiaky budú celkom mäkké.", "requires": ["fish:pan", "butter:pan", "garlic:pan", "parsley:pan", "lemon:pan", "potato:parbaked", "oil:baked", "thyme:baked"], "produces": ["fish:baked", "butter:baked", "garlic:baked", "parsley:baked", "lemon:baked", "potato:baked"]},
        {"text": "Podávaj rybu so zemiakmi, polej ju bylinkovým výpekom z pekáča a rozdeľ jedlo na {portions} porcií.", "requires": ["fish:baked", "butter:baked", "garlic:baked", "lemon:baked", "potato:baked", "oil:baked", "thyme:baked", "parsley:baked"], "produces": ["fish:served", "butter:served", "garlic:served", "lemon:served", "potato:served", "oil:served", "thyme:served", "parsley:served"]}
