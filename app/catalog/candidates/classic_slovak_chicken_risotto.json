      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {
          "text": "Prepláchni {rice.amount} {rice.name} studenou vodou.",
          "requires": ["rice:raw"],
          "produces": ["rice:rinsed"]
        },
        {
          "text": "Nakrájaj {chicken.amount} {chicken.name} na malé kocky, {carrot.amount} {carrot.name} na malé kocky a {onion.amount} {onion.name} nadrobno.",
          "requires": ["chicken:raw", "carrot:raw", "onion:raw"],
          "produces": ["chicken:cut", "carrot:cut", "onion:cut"]
        },
        {
          "text": "Rozohrej v hrnci {oil.amount} {oil.name} na strednom ohni 2 minúty, kým sa začne lesknúť. Opekaj v ňom cibuľu 3 minúty, kým bude dosklovita.",
          "requires": ["onion:cut", "oil:raw", "hrniec:free"],
          "produces": ["onion:cooked", "oil:used", "hrniec:occupied"]
        },
        {
          "text": "Pridaj {chicken.name} do hrnca. Opekaj kuracie prsia na strednom ohni 7 minút, kým bude mäso na okrajoch zlatisté.",
          "requires": ["chicken:cut", "onion:cooked", "oil:used", "hrniec:occupied"],
          "produces": ["chicken:browned"]
        },
        {
          "text": "Pridaj {carrot.name} a {rice.name} do hrnca. Prilej {rice.water} vody do hrnca a prikry ho. Var ryžu s kuracím mäsom a mrkvou na miernom ohni 14 minút, kým voda vsiakne a ryža zmäkne.",
          "requires": ["carrot:cut", "rice:rinsed", "chicken:browned", "oil:used", "hrniec:occupied"],
          "produces": ["carrot:cooked", "rice:cooked", "chicken:cooked", "oil:cooked"]
        },
        {
          "text": "Pridaj {peas.amount} {peas.name} do hrnca. Dus zelený hrášok s rizotom v hrnci na miernom ohni 5 minút, kým hrášok zmäkne a ryža zostane sypká.",
          "requires": ["peas:raw", "rice:cooked", "chicken:cooked", "oil:cooked", "hrniec:occupied"],
          "produces": ["peas:cooked", "hrniec:free"]
        },
        {
          "text": "Priprav {cheese.amount} {cheese.name} na posypanie.",
          "requires": ["cheese:raw"],
          "produces": ["cheese:prepared"]
        },
        {
          "text": "Dochuť rizoto soľou a čiernym korením.",
          "requires": ["chicken:cooked", "rice:cooked", "peas:cooked", "carrot:cooked", "onion:cooked", "oil:cooked"],
          "produces": []
        },
        {
          "text": "Podávaj rizoto posypané tvrdým syrom a rozdeľ ho na {portions} porcií.",
          "requires": ["chicken:cooked", "rice:cooked", "peas:cooked", "carrot:cooked", "onion:cooked", "cheese:prepared", "oil:cooked"],
          "produces": ["chicken:served", "rice:served", "peas:served", "carrot:served", "onion:served", "cheese:served", "oil:served"]
        }
      ],
      "storage": {
        "refrigerated_days": 1,
        "instruction": "Rizoto rozdeľ do plytkých nádob a do jednej hodiny ho schlaď. V chladničke ho zjedz do 24 hodín; porcie na neskôr hneď zamraz. Ohrievaj iba raz, kým bude celé horúce."
      }
    }
