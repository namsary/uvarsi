      "pantry_basics": ["water", "salt", "black_pepper"],
      "instructions": [
        {
          "text": "Prepláchni {rice.amount} {rice.name} studenou vodou.",
          "requires": ["rice:raw"],
          "produces": ["rice:rinsed"]
        },
        {
          "text": "Nalej {rice.water} vody do hrnca, prikry pokrievkou a priveď na strednom ohni do varu. Potom stíš oheň a var ryžu prikrytú na miernom ohni asi 15 minút, kým vsiakne vodu a zmäkne.",
          "requires": ["rice:rinsed", "hrniec:free"],
          "produces": ["rice:cooked", "hrniec:free"]
        },
        {
          "text": "Nakrájaj {chicken.amount} {chicken.name} na rezance, {pepper.amount} {pepper.name} na pásiky, {onion.amount} {onion.name} nadrobno a {garlic.amount} {garlic.name} najemno. Priprav si {peas.amount} {peas.name}.",
          "requires": ["chicken:raw", "pepper:raw", "onion:raw", "garlic:raw"],
          "produces": ["chicken:cut", "pepper:cut", "onion:cut", "garlic:cut"]
        },
        {
          "text": "Rozohrej {oil.amount} {oil.name} v panvici na strednom ohni a opekaj na ňom cibuľu 5 minút, kým bude mäkká a dosklovita.",
          "requires": ["onion:cut", "oil:raw", "panvica:free"],
          "produces": ["onion:cooked", "oil:used", "panvica:occupied"]
        },
        {
          "text": "Pridaj {chicken.name} do panvice. Pri väčšej dávke opekaj mäso po častiach, aby sa namiesto dusenia opieklo. Každú časť opekaj na strednom ohni asi 7 minút, kým budú kuracie prsia na povrchu zlatisté.",
          "requires": ["chicken:cut", "onion:cooked", "oil:used", "panvica:occupied"],
          "produces": ["chicken:browned", "oil:cooked"]
        },
        {
          "text": "Odstav panvicu z ohňa. Prisyp {paprika.amount} {paprika.name}. Hneď premiešaj.",
          "requires": ["paprika:raw", "chicken:browned", "panvica:occupied"],
          "produces": ["paprika:combined"]
        },
        {
          "text": "Vráť panvicu na sporák. Pridaj {pepper.name} do panvice. Prisyp {peas.name} a {garlic.name}. Opekaj {pepper.name}, {peas.name}, {garlic.name} a {chicken.name} na strednom ohni 6 minút, kým zelenina zmäkne a mäso nebude v strede ružové.",
          "requires": ["pepper:cut", "peas:raw", "garlic:cut", "chicken:browned", "oil:cooked", "paprika:combined", "panvica:occupied"],
          "produces": ["pepper:cooked", "peas:cooked", "garlic:cooked", "chicken:cooked", "panvica:free"]
        },
        {
          "text": "Dochuť soté soľou a čiernym korením.",
          "requires": ["chicken:cooked", "pepper:cooked", "peas:cooked"],
          "produces": []
        },
        {
          "text": "Podávaj kuracie soté s ryžou a rozdeľ jedlo na {portions} porcií.",
          "requires": ["chicken:cooked", "rice:cooked", "pepper:cooked", "peas:cooked", "onion:cooked", "garlic:cooked", "oil:cooked", "paprika:combined"],
          "produces": ["chicken:served", "rice:served", "pepper:served", "peas:served", "onion:served", "garlic:served", "oil:served", "paprika:served"]
        }
      ],
      "storage": {
        "refrigerated_days": 1,
        "instruction": "Ryžu aj soté schlaď v oddelených plytkých nádobách do jednej hodiny, odlož do chladničky a zjedz do 24 hodín."
      }
    }
