      "instructions": [
        {"text": "Nakrájaj {tomato.amount} {tomato.name} nahrubo, {onion.amount} {onion.name} nadrobno, {garlic.amount} {garlic.name} najemno a {mozzarella.amount} {mozzarella.name} na kocky.", "requires": ["tomato:raw", "onion:raw", "garlic:raw", "mozzarella:raw"], "produces": ["tomato:cut", "onion:cut", "garlic:cut", "mozzarella:cut"]},
        {"text": "Rozohrej {oil.amount} {oil.name} v hlbokej panvici na strednom ohni 1 minútu, kým sa začne lesknúť. Opekaj cibuľu 4 minúty, kým zmäkne a bude dosklovita. Pridaj cesnak do panvice a opekaj ho 30 sekúnd, kým zavonia.", "requires": ["oil:raw", "onion:cut", "garlic:cut", "hlboka_panvica_s_pokrievkou:free"], "produces": ["oil:used", "onion:cooked", "garlic:cooked", "hlboka_panvica_s_pokrievkou:occupied"]},
        {"text": "Vmiešaj {paste.amount} {paste.name} a paradajky do panvice. Prilej {tomato.water} vody a prisyp {oregano.amount} {oregano.name}. Var paradajky v panvici na miernom ohni 10 minút, kým zmäknú, rozpadnú sa a omáčka zhustne.", "requires": ["paste:raw", "tomato:cut", "oregano:raw", "onion:cooked", "garlic:cooked", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["paste:cooked", "tomato:sauce", "oregano:cooked"]},
        {"text": "Uvar {gnocchi.amount} {gnocchi.name} v hrnci vo vriacej osolenej vode na strednom ohni 2 minúty, kým vyplávajú na hladinu a zmäknú. Sceď gnocchi cez sitko.", "requires": ["gnocchi:raw", "hrniec:free", "sitko:free"], "produces": ["gnocchi:cooked", "hrniec:free", "sitko:free"]},
        {"text": "Pridaj gnocchi do panvice. Prehrievaj gnocchi v omáčke na miernom ohni 2 minúty, kým ich omáčka obalí a začne jemne bublať. Dochuť omáčku soľou a čiernym korením.", "requires": ["gnocchi:cooked", "tomato:sauce", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["gnocchi:sauced", "tomato:cooked"]},
        {"text": "Rozlož mozzarellu na gnocchi, prikry panvicu pokrievkou a zohrievaj ju na miernom ohni 3 minúty, kým mozzarella zmäkne a začne sa rozpúšťať.", "requires": ["mozzarella:cut", "gnocchi:sauced", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["mozzarella:melted"]},
        {"text": "Podávaj gnocchi hneď z panvice a rozdeľ ich na {portions} porcií.", "requires": ["gnocchi:sauced", "mozzarella:melted", "tomato:cooked", "paste:cooked", "oregano:cooked", "onion:cooked", "garlic:cooked", "oil:used", "hlboka_panvica_s_pokrievkou:occupied"], "produces": ["gnocchi:served", "mozzarella:served", "tomato:served", "paste:served", "oregano:served", "onion:served", "garlic:served", "oil:served", "hlboka_panvica_s_pokrievkou:free"]}
      ],
